    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُستخدم موقع Apple TV لعرض أوقات الصلاة المحلية والطقس على هذا التلفاز."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lokacija Apple TV-a koristi se za prikaz lokalnih vremena namaza i vremenskih prilika na ovom televizoru."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شوێنی Apple TV بەکاردێت بۆ پیشاندانی کاتەکانی نوێژی ناوخۆیی و کەشوهەوا بۆ ئەم تەلەڤیزیۆنە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Der Apple-TV-Standort wird verwendet, um lokale Gebetszeiten und das Wetter für diesen Fernseher anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple TV location is used to show local prayer times and weather for this television."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La ubicación del Apple TV se utiliza para mostrar los horarios de oración locales y el tiempo en este televisor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La position de l’Apple TV est utilisée pour afficher les horaires de prière locaux et la météo sur ce téléviseur."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cihê Apple TV ji bo nîşandana demên nimêjê yên herêmî û hewayê li ser vê televîzyonê tê bikaranîn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apple TV konumu, bu televizyonda yerel namaz vakitlerini ve hava durumunu göstermek için kullanılır."
          }
        }
      }
    }
  },
  "version" : "1.3"
