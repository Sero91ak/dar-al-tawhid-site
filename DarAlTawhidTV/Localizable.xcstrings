    "Gebetszeit %@ um %@. %@ Adhān läuft. Qurʾān pausiert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "وقت الصلاة %@ الساعة %@. الأذان %@ يعمل. القرآن متوقف."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vrijeme namaza %@ u %@. %@ se uči. Kur’an je pauziran."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "کاتی نوێژ %@ لە کاتژمێر %@. %@ بانگ دەدرێت. قورئان وەستێنراوە."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gebetszeit %1$@ um %2$@. %3$@ Adhān läuft. Qurʾān pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prayer time %@ at %@. %@ Adhan playing. Qurʾān paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hora de oración %@ a las %@. %@ adhan en reproducción. Corán pausado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Horaire de prière %@ à %@. %@ adhan en cours. Coran en pause."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dema nimêjê %@ li saet %@. %@ Adhan tê xwendin. Qurʾān rawestiyaye."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ namaz vakti saat %@. %@ Ezan çalıyor. Kur’an duraklatıldı."
          }
        }
      }
    },
