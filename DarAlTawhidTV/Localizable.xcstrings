    "Ohne Internetverbindung sind noch keine Ḥadīṯe gespeichert." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا توجد أحاديث محفوظة بعد دون اتصال بالإنترنت."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bez interneta još nisu sačuvani hadisi."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بێ ئینتەرنێت هێشتا هیچ حەدیثێک پاشەکەوت نەکراوە."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No Ḥadīṯ are saved offline yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todavía no hay hadices guardados sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aucun ḥadīth n’est encore enregistré hors ligne."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bê girêdana înternetê hîn tu Ḥadîs nehatine tomarkirin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "İnternet bağlantısı olmadan henüz kayıtlı Ḥadīṯ yok."
          }
        }
      }
    },
