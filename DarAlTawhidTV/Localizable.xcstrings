    "Der Adhān wird zu den Gebetszeiten automatisch abgespielt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "سيُشغّل الأذان تلقائيًا عند أوقات الصلاة."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ezan će se automatski učiti u vrijeme namaza."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "بانگ لە کاتەکانی نوێژدا خۆکارانە دەدرێت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adhan will play automatically at prayer times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El adhan se reproducirá automáticamente en los horarios de oración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’adhan sera lu automatiquement aux horaires de prière."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adhan dê di demên nimêjê de bixweber were xwendin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ezan, namaz vakitlerinde otomatik olarak çalınır."
          }
        }
      }
    },
