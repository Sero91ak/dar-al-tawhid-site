    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُستخدم الموقع لحساب اتجاه القبلة إلى الكعبة على Apple Watch."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vaša lokacija se koristi za izračun vremena namaza, smjera kible i vremenskih podataka."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شوێن بەکاردێت بۆ حیسابکردنی ئاڕاستەی قیبلە بۆ کەعبە لەسەر Apple Watch."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Der Standort wird verwendet, um auf der Apple Watch die Qibla-Richtung zur Kaaba zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Location is used to calculate the Qibla direction to the Kaaba on Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usamos tu ubicación para calcular los horarios de oración, la qibla y el clima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nous utilisons votre position uniquement lorsque vous utilisez l’app, afin d’afficher les heures de prière et la qibla adaptées à votre emplacement."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cih tê bikaranîn da ku aliyê qiblê ber bi Ka'beyê li ser Apple Watch were hesibandin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konum, Apple Watch’ta Kâbe’ye kıble yönünü hesaplamak için kullanılır."
          }
        }
      }
    }
  },
  "version" : "1.3"
}