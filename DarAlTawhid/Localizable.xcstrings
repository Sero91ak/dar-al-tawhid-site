    "Erlaube Mitteilungen, damit du rechtzeitig an deine Gebetszeiten erinnert wirst." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "اسمح بالإشعارات لتذكيرك بمواقيت الصلاة في الوقت المناسب."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dozvoli obavještenja da bi na vrijeme dobijao/la podsjetnike za namaze."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ڕێگە بە ئاگادارییەکان بدە بۆ ئەوەی لە کاتی خۆیدا بیرت بخەینەوە لە کاتەکانی نوێژ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Allow notifications so you can be reminded of your prayer times in time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite las notificaciones para recibir a tiempo recordatorios de tus horas de oración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez les notifications pour recevoir vos rappels de prières à temps."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ji bo ku demên nimêjê di wextê rast de ji te re bîranîn bêne şandin, destûra agahdariyan bide."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Namaz vakitlerini hatırlatmak için bildirimlere izin verin."
          }
        }
      }
    },
