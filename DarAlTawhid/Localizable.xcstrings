    "Wir verwenden deinen Standort nur, wenn du die App nutzt, damit Gebetszeiten, Qibla und Wetter zu deinem aktuellen Ort passen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "نستخدم موقعك فقط أثناء استخدامك للتطبيق، لكي تتوافق مواقيت الصلاة والقبلة والطقس مع موقعك الحالي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tvoju lokaciju koristimo samo dok koristiš aplikaciju kako bi se vremena namaza, kibla i vremenska prognoza uskladili s tvojom trenutnom lokacijom."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تەنها کاتێک شوێنت بەکاردەهێنین کە ئەپەکە بەکاردەهێنیت، بۆ ئەوەی کاتەکانی نوێژ و قیبلە و کەشوهەوا لەگەڵ شوێنی ئێستات بگونجێن."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "We use your location only while you use the app so prayer times, Qibla, and weather match your current location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usamos tu ubicación solo mientras utilizas la app para que las horas de oración, la qibla y el tiempo se ajusten a tu ubicación actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nous utilisons votre position uniquement lorsque vous utilisez l’app afin d’adapter les horaires de prière, la qibla et la météo à votre position actuelle."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Em cihê te tenê dema ku tu sepanê bikar tînî bikar tînin, da ku demên nimêjê, Qibla û hewa li gorî cihê te yê niha bin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konumunuzu yalnızca uygulamayı kullanırken kullanırız; böylece namaz vakitleri, kıble ve hava durumu mevcut konumunuza uyarlanır."
          }
        }
      }
    }
  },
  "version" : "1.3"
}