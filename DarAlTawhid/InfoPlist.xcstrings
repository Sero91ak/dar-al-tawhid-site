    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يُستخدم موقعك لعرض مواقيت الصلاة واتجاه القبلة والطقس والودجات المرتبطة بالموقع بشكل صحيح."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tvoja lokacija se koristi za ispravan prikaz vremena namaza, smjera kible, vremenskih prilika i widgeta zasnovanih na lokaciji."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شوێنەکەت بۆ پیشاندانی کاتی نوێژ، ئاراستەی قیبلە، کەشوهەوا و ویجەتە پەیوەستەکان بە شوێن بە دروستی بەکاردێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dein Standort wird verwendet, um Gebetszeiten, Qibla-Richtung, Wetter und ortsbezogene Widgets korrekt anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Your location is used to display prayer times, Qibla direction, weather, and location-based widgets correctly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu ubicación se utiliza para mostrar correctamente los horarios de oración, la dirección de la qibla, el tiempo y los widgets basados en la ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre position est utilisée pour afficher correctement les horaires de prière, la direction de la qibla, la météo et les widgets liés à la position."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cihê te ji bo nîşandana demên nimêjê, ber bi qibleyê ve, hewa û widgetên girêdayî cihê te bi awayekî rast tê bikaranîn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konumun; namaz vakitlerini, kıble yönünü, hava durumunu ve konuma dayalı araç takımlarını doğru şekilde göstermek için kullanılır."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "لا تُستخدم بيانات الحركة إلا عند رغبتك في استخدام بوصلة القبلة على جهازك."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podaci o kretanju koriste se samo kada želiš koristiti kompas kible na svom uređaju."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "داتا حرکەت تەنها کاتێک بەکاردێت کە بتەوێت لەسەر ئامێرەکەت کۆمپاسی قیبلە بەکاربهێنیت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bewegungsdaten werden nur genutzt, wenn du den Qibla-Kompass auf dem Gerät verwenden möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Motion data is used only when you want to use the Qibla compass on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los datos de movimiento solo se utilizan cuando quieres usar la brújula de la qibla en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les données de mouvement sont utilisées uniquement lorsque vous souhaitez utiliser la boussole de la qibla sur votre appareil."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Daneyên tevgerê tenê dema ku tu bixwazî li ser cîhazê xwe pusûla qibleyê bikar bînî têne bikaranîn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hareket verileri yalnızca cihazındaki kıble pusulasını kullanmak istediğinde kullanılır."
          }
        }
      }
    },
