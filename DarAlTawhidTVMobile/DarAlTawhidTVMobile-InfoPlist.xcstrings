    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يستخدم التطبيق موقعك أثناء الاستخدام فقط لعرض مواقيت الصلاة والقبلة والطقس في موقعك الحالي."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vašu lokaciju koristimo samo dok koristite aplikaciju kako bi vremena namaza, kibla i vremenska prognoza odgovarali vašoj trenutnoj lokaciji."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "شوێنت تەنها لە کاتی بەکارهێنانی ئەپەکەدا بەکاردێنین بۆ ئەوەی کاتەکانی نوێژ، قیبلە و کەشوهەوا لەگەڵ شوێنی ئێستات بگونجێت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Der Apple-TV-Standort wird verwendet, um lokale Gebetszeiten und das Wetter für diesen Fernseher anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "We use your location only while you use the app so prayer times, Qibla and weather match your current location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usamos tu ubicación solo mientras utilizas la aplicación para que las horas de oración, la qibla y el tiempo correspondan a tu ubicación actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nous utilisons votre position uniquement lorsque vous utilisez l’app afin que les heures de prière, la qibla et la météo correspondent à votre position actuelle."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Em cihê te tenê dema tu sepanê bikar tînî bi kar tînin da demên nimêjê, qibleyê û hewayê li cihê te rast bibin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Konumunuzu yalnızca uygulamayı kullanırken, namaz vakitleri, kıble ve hava durumunu bulunduğunuz konuma göre göstermek için kullanırız."
          }
        }
      }
    }
  },
  "version" : "1.3"
}