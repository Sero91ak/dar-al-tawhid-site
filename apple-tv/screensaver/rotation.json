{
  "schemaVersion": "1.1",
  "mode": "shuffleBag",
  "persistProgress": true,
  "storage": "applicationSupport",
  "contentSource": {
    "provider": "HadithScreensaverProvider",
    "catalogPath": "hadith/catalog.json",
    "includedRecordTypes": [
      "hadith",
      "athar"
    ],
    "salafStatementsUseRecordType": "athar",
    "rule": "Alle registrierten Ḥadīṯe, Āṯār und Salaf-Aussagen erscheinen im Bildschirmschoner."
  },
  "cyclePolicy": {
    "showEveryItemBeforeRepeat": true,
    "shuffleEachCycle": true,
    "crossCycleCooldownCount": 20,
    "preventImmediateRepeat": true,
    "newItemsPolicy": "appendToRemainingAndReshuffle",
    "removedItemsPolicy": "dropFromState"
  },
  "batchBuildPolicy": {
    "stepSize": 100,
    "twentyBlockPattern": true,
    "rule": "Neue Apple-TV-Bildschirmschoner-Inhalte werden in 100er-Schritten gebaut; innerhalb jedes 100er-Schritts werden 20er-Blöcke für Ḥadīṯ, Āṯār, Ṣaḥābah- und Salaf-Aussagen verwendet."
  },
  "futureModuleMixing": {
    "enabled": true,
    "strategy": "weightedRoundRobin",
    "weights": {
      "hadith": 5,
      "athar": 5,
      "dua": 1
    }
  }
}