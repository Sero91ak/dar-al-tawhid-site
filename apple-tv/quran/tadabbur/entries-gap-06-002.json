      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:16",
      "text": "Qatādah erklärte „sie erkauften die Irreleitung mit der Rechtleitung“ damit, dass sie die Irreleitung der Rechtleitung vorzogen.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:16, Bericht 382",
      "grading": "isnād ḥasan",
      "sourceUrl": "https://www.islamweb.net/amp/ar/library/content/50/72/%D8%A7%D9%84%D9%82%D9%88%D9%84-%D9%81%D9%8A-%D8%AA%D8%A3%D9%88%D9%8A%D9%84-%D9%82%D9%88%D9%84%D9%87-%D8%AA%D8%B9%D8%A7%D9%84%D9%89-%D8%A3%D9%88%D9%84%D8%A6%D9%83-%D8%A7%D9%84%D8%B0%D9%8A%D9%86-%D8%A7%D8%B4%D8%AA%D8%B1%D9%88%D8%A7-%D8%A7%D9%84%D8%B6%D9%84%D8%A7%D9%84%D8%A9-%D8%A8%D8%A7%D9%84%D9%87%D8%AF%D9%89-",
      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:18",
      "text": "Qatādah erklärte: Sie sind gegenüber der Wahrheit taub und hören sie nicht, blind gegenüber der Wahrheit und sehen sie nicht, und stumm gegenüber der Wahrheit und sprechen sie nicht aus.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:18, Bericht 401",
      "grading": "isnād ḥasan",
      "sourceUrl": "https://www.islamweb.net/ar/library/content/50/76/%D8%A7%D9%84%D9%82%D9%88%D9%84-%D9%81%D9%8A-%D8%AA%D8%A3%D9%88%D9%8A%D9%84-%D9%82%D9%88%D9%84%D9%87-%D8%AA%D8%B9%D8%A7%D9%84%D9%89-%D8%B5%D9%85-%D8%A8%D9%83%D9%85-%D8%B9%D9%85%D9%8A-%D9%81%D9%87%D9%85-%D9%84%D8%A7-%D9%8A%D8%B1%D8%AC%D8%B9%D9%88%D9%86-",
      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:19",
      "text": "Qatādah erklärte das Wort „ṣayyib“ in diesem Gleichnis als Regen.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:19, Bericht 410",
      "grading": "isnād ḥasan",
      "sourceUrl": "https://www.islamweb.net/ar/library/content/50/78/%D8%A7%D9%84%D9%82%D9%88%D9%84-%D9%81%D9%8A-%D8%AA%D8%A3%D9%88%D9%8A%D9%84-%D9%82%D9%88%D9%84%D9%87-%D8%AA%D8%B9%D8%A7%D9%84%D9%89-%D8%A3%D9%88-%D9%83%D8%B5%D9%8A%D8%A8-%D9%85%D9%86-%D8%A7%D9%84%D8%B3%D9%85%D8%A7%D8%A1-",
      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:22",
      "text": "Qatādah erklärte „macht Allah keine Ebenbürtigen“: Gemeint sind Gleichgestellte bzw. Ebenbürtige, die Allah zur Seite gesetzt werden.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:22, Bericht 480",
      "grading": "isnād ḥasan",
      "sourceUrl": "https://islamweb.net/ar/library/content/50/87/%D8%A7%D9%84%D9%82%D9%88%D9%84-%D9%81%D9%8A-%D8%AA%D8%A3%D9%88%D9%8A%D9%84-%D9%82%D9%88%D9%84%D9%87-%D8%AA%D8%B9%D8%A7%D9%84%D9%89-%D9%81%D9%84%D8%A7-%D8%AA%D8%AC%D8%B9%D9%84%D9%88%D8%A7-%D9%84%D9%84%D9%87-%D8%A3%D9%86%D8%AF%D8%A7%D8%AF%D8%A7-",
      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:23",
      "text": "Qatādah erklärte die Aufforderung, eine Sūrah seinesgleichen hervorzubringen: eine Sūrah wie dieser Qurʾān, wahr und wahrhaftig, ohne Falschheit und Lüge.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:23, Bericht 491",
      "grading": "isnād ḥasan",
      "sourceUrl": "https://islamweb.net/ar/library/content/50/89/%D8%A7%D9%84%D9%82%D9%88%D9%84-%D9%81%D9%8A-%D8%AA%D8%A3%D9%88%D9%8A%D9%84-%D9%82%D9%88%D9%84%D9%87-%D8%AA%D8%B9%D8%A7%D9%84%D9%89-%D9%88%D8%A5%D9%86-%D9%83%D9%86%D8%AA%D9%85-%D9%81%D9%8A-%D8%B1%D9%8A%D8%A8-%D9%85%D9%85%D8%A7-%D9%86%D8%B2%D9%84%D9%86%D8%A7-%D8%B9%D9%84%D9%89-%D8%B9%D8%A8%D8%AF%D9%86%D8%A7-%D9%81%D8%A3%D8%AA%D9%88%D8%A7-%D8%A8%D8%B3%D9%88%D8%B1%D8%A9-%D9%85%D9%86-%D9%85%D8%AB%D9%84%D9%87-",
      "relation": "direkte Tafsīr-Aussage",
      "note": "Kette: Bišr ibn Muʿāḏ → Yazīd ibn Zurayʿ → Saʿīd ibn Abī ʿArūbah → Qatādah."
    },
    {
      "reference": "2:24",
      "text": "Qatādah erklärte „wenn ihr es nicht tut – und ihr werdet es nicht tun“: Ihr seid dazu nicht imstande und vermögt es nicht.",
      "narrator": "Qatādah ibn Diʿāmah",
      "generation": "Tābiʿī",
      "source": "Tafsīr aṭ-Ṭabarī zu Qurʾān 2:24, Bericht 501",
      "grading": "isnād ḥasan",
