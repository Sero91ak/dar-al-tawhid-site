    "ar.abdulbasitmurattal",
    "ar.abdulbasitmujawwad",
    "ar.abdullahbasfar",
    "ar.ahmedajamy",
    "ar.hanirifai",
    "ar.hudhaify",
    "ar.mahermuaiqly",
    "ar.muhammadayyoub",
    "ar.muhammadjibreel",
    "ar.shaatree",
    "ar.yasseraldossari",
    "ar.aymanswoaid"
  ]
}
