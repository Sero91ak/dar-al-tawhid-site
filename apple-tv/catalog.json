{
  "project": "DĀR AL TAWḤĪD – Apple TV Content",
  "schemaVersion": "1.7",
  "language": "de",
  "defaultModule": "hadith",
  "remoteContentSync": {
    "enabled": true,
    "rule": "GitHub bzw. die Live-Auslieferungsquelle liefert catalog.json und Indexdateien; Xcode kennt keine festen Inhaltsgrenzen.",
    "checkOnAppStart": true,
    "checkOnForeground": true,
    "checkOnAppleTVWake": true,
    "minimumRefreshIntervalHours": 6,
    "offlineCache": true,
    "atomicCacheActivation": true,
    "keepLastGoodCacheOnError": true
  },
  "screensaver": {
    "enabled": true,
    "status": "active",
    "catalogPath": "screensaver/catalog.json",
    "rotationConfigPath": "screensaver/rotation.json",
    "remoteLoad": true,
    "offlineCache": true,
    "fallbackRequired": true
  },
  "quran": {
    "reader": {
      "status": "active",
      "target": "tvOS-only",
      "view": "QuranTabView",
      "arabicEdition": "quran-uthmani",
      "germanEdition": "de.bubenheim",
      "germanTranslationName": "Bubenheim & Elyas",
      "syncMode": "ayah-by-ayah",
      "autoAdvance": true,
      "persistLastPosition": true,
      "remoteLoad": true,
      "offlineCache": true
    },
    "audio": {
      "status": "active",
      "target": "tvOS-only",
      "catalogPath": "quran/audio/catalog.json",
      "remoteLoad": true,
      "offlineCache": true,
      "fallbackRequired": true
    },
    "tadabbur": {
      "status": "active",
      "target": "tvOS-only",
      "rootPath": "quran/tadabbur",
      "catalogPath": "quran/tadabbur/catalog.json",
      "schemaPath": "quran/tadabbur/schema.json",
      "entriesPath": "quran/tadabbur/entries.json",
      "entriesIndexPath": "quran/tadabbur/entries-index.json",
      "coveragePath": "quran/tadabbur/coverage.json",
      "remoteLoad": true,
      "offlineCache": true,
      "fallbackRequired": true
    }
  },
  "modules": [
    {
      "id": "hadith",
      "title": "Ḥadīṯe",
      "status": "active",
      "recordType": "hadith",
      "rootPath": "hadith",
      "catalogPath": "hadith/catalog.json",
      "schemaPath": "hadith/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 10
    },
    {
      "id": "hadithSharh",
      "title": "Ḥadīṯ-Šarḥ",
      "status": "planned",
      "recordType": "hadith-sharh",
      "rootPath": "hadith/sharh",
      "catalogPath": "hadith/sharh/catalog.json",
      "remoteLoad": true,
      "offlineCache": true,
      "requiresModule": "hadith",
      "sortOrder": 15
    },
    {
      "id": "dua",
      "title": "Duʿāʾ",
      "status": "planned",
      "recordType": "dua",
      "rootPath": "dua",
      "catalogPath": "dua/catalog.json",
      "schemaPath": "dua/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 20
    },
    {
      "id": "series",
      "title": "Serien / 30-Tage-Bereiche",
      "status": "planned",
      "recordType": "series",
      "rootPath": "series",
      "catalogPath": "series/catalog.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 25
    },
    {
      "id": "athar",
      "title": "Āṯār & Aussagen der Salaf",
      "status": "planned",
      "recordType": "athar",
      "rootPath": "athar",
      "catalogPath": "athar/catalog.json",
      "schemaPath": "athar/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 30,
      "scope": "Ṣaḥābah, Tābiʿīn und Salaf"
    }
  ],
  "backgrounds": {
    "status": "active",
    "target": "tvOS-only",
    "catalogPath": "backgrounds/catalog.json",
    "selectionMode": "ownerFixed",
    "allowUserSelection": false
  }
}
