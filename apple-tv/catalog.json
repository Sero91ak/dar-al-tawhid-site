{
  "project": "DĀR AL TAWḤĪD – Apple TV Content",
  "schemaVersion": "1.9",
  "language": "de",
  "defaultModule": "hadith",
  "defaultModuleScope": "library-tab-only",
  "defaultModuleDoesNotControlScreensaver": true,
  "defaultModuleDoesNotControlHomeTadabbur": true,
  "home": {
    "enabled": true,
    "status": "active",
    "catalogPath": "home/catalog.json",
    "view": "TVHomeView",
    "rule": "Startseite bei Gebetszeiten: Gebetszeiten + aktueller Qurʾān-Vers + Tadabbur zu genau diesem Vers. Niemals Ḥadīṯ-Bibliothek, Screensaver-Rotation oder Šarḥ in den Tadabbur-Bereich. Vers und Tadabbur in Sekunden halten, nicht in Millisekunden überspringen.",
    "holdUnit": "seconds",
    "forbidMillisecondSkip": true,
    "remoteLoad": true,
    "offlineCache": true
  },
  "remoteContentSync": {
    "enabled": true,
    "rule": "Live-Quelle dar-al-tawhid.de/apple-tv liefert catalog.json und Indexdateien; Xcode kennt keine festen Inhaltsgrenzen.",
    "checkOnAppStart": true,
    "checkOnForeground": true,
    "checkOnAppleTVWake": true,
    "minimumRefreshIntervalHours": 6,
    "offlineCache": true,
    "atomicCacheActivation": true,
    "keepLastGoodCacheOnError": true
  },
  "screensaver": {
    "enabled": true,
    "status": "active",
    "catalogPath": "screensaver/catalog.json",
    "rotationConfigPath": "screensaver/rotation.json",
    "remoteLoad": true,
    "offlineCache": true,
    "fallbackRequired": true,
    "keepExistingCardZones": true,
    "holdUnit": "seconds",
    "forbidMillisecondSkip": true,
    "mix": {
      "strategy": "weightedRoundRobin",
      "weights": {
        "hadith": 5,
        "athar": 5,
        "quranTad": 5
      }
    }
  },
  "quran": {
    "reader": {
      "status": "active",
      "target": "tvOS-only",
      "view": "QuranTabView",
      "arabicEdition": "quran-uthmani",
      "germanEdition": "de.bubenheim",
      "germanTranslationName": "Bubenheim & Elyas",
      "syncMode": "ayah-by-ayah",
      "autoAdvance": true,
      "persistLastPosition": true,
      "remoteLoad": true,
      "offlineCache": true
    },
    "audio": {
      "status": "active",
      "target": "tvOS-only",
      "catalogPath": "quran/audio/catalog.json",
      "remoteLoad": true,
      "offlineCache": true,
      "playViaWeb": true,
      "fallbackRequired": true
    },
    "tadabbur": {
      "status": "active",
      "target": "shared-tvOS-iOS-iPadOS-web-android",
      "rootPath": "quran/tadabbur",
      "catalogPath": "quran/tadabbur/catalog.json",
      "schemaPath": "quran/tadabbur/schema.json",
      "entriesPath": "quran/tadabbur/entries.json",
      "entriesIndexPath": "quran/tadabbur/entries-index.json",
      "coveragePath": "quran/tadabbur/coverage.json",
      "remoteLoad": true,
      "offlineCache": true,
      "fallbackRequired": true
    }
  },
  "modules": [
    {
      "id": "hadith",
      "title": "Ḥadīṯe",
      "status": "active",
      "recordType": "hadith",
      "rootPath": "hadith",
      "catalogPath": "hadith/catalog.json",
      "schemaPath": "hadith/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 10
    },
    {
      "id": "dua",
      "title": "Duʿāʾ",
      "status": "planned",
      "recordType": "dua",
      "rootPath": "dua",
      "catalogPath": "dua/catalog.json",
      "schemaPath": "dua/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 20
    },
    {
      "id": "athar",
      "title": "Āṯār & Aussagen der Salaf",
      "status": "planned",
      "recordType": "athar",
      "rootPath": "athar",
      "catalogPath": "athar/catalog.json",
      "schemaPath": "athar/schema.json",
      "remoteLoad": true,
      "offlineCache": true,
      "sortOrder": 30,
      "scope": "Ṣaḥābah, Tābiʿīn und Salaf"
    }
  ]
}
