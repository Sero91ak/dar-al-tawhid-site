    "sustainedPlateauRelativeDelta": 0.035,
    "rescueLongSegments": true,
    "rescueMinWords": 9,
    "rescueMinChars": 90,
    "longSegmentSecondsPerWord": 0.85,
    "longSegmentBaseSeconds": 2.5,
    "coreAudioLockRequiredForRepeatability": true,
    "coreAudioCandidateSinglePerRender": true,
    "coreAudioConfirmedNeverResynthesized": true
