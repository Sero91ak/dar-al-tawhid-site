  "qualityAssurance": {
    "maxRenderAttempts": 2,
    "retrySeedOffset": 97,
    "rejectNonFinite": true,
    "minRms": 0.0015,
    "minPeak": 0.01,
    "maxClippingRatio": 0.02,
    "maxInternalSilenceMsWithoutPunctuation": 700,
    "shortArabicMaxSecondsBase": 1.2,
    "shortArabicMaxSecondsPerLetter": 0.34,
    "requireHumanConfirmationForMaster": true,
    "note": "Automatic QA rejects technical silence, excessive punctuation pauses, suspicious sustained holds, clipping and implausibly slow/long segments. One controlled retry remains the default; non-MASTER long segments may use deterministic clause rescue. Human semantic pronunciation review is still mandatory.",
    "maxInternalSilenceMsWithPunctuation": 1250,
    "minSpeechRateWords": 6,
    "minSpeechRateWpmByMode": {
      "default": 78,
      "gentle": 68,
      "serious": 68,
      "dua": 64,
