 "babs": {
  "1": "Allah şifasını indirmediği hiçbir hastalık indirmemiştir",
  "2": "Erkek kadını veya kadın erkeği tedavi edebilir mi?",
  "3": "Şifa üç şeydedir",
  "4": "Bal ile tedavi ve Allah Teâlâ'nın: \"… onda insanlar için şifa vardır\" sözü",
  "5": "Deve sütüyle tedavi",
  "6": "Deve sidiğiyle tedavi",
  "7": "Çörek otu",
  "8": "Hasta için telbîne",
  "9": "Burna ilaç damlatmak",
  "10": "Hangi saatte hacamat olunur",
  "11": "Yolculukta ve ihramda hacamat",
  "12": "Hastalıktan dolayı hacamat",
  "13": "Başa hacamat",
  "14": "Eziyetten dolayı tıraş",
  "15": "Dağlanan veya başkasını dağlayan ve dağlanmayanın fazileti",
  "16": "Göz iltihabı için ismid ve sürme",
  "17": "Cüzzam",
  "18": "Keme (mantar) göze şifadır",
  "19": "Ağzın kenarından ilaç akıtmak",
  "20": "Boğaz iltihabı",
  "21": "Karın ağrısı çekenin ilacı",
  "22": "Safer yoktur – o karına arız olan bir hastalıktır",
  "23": "Zatülcenp",
  "24": "Kanı durdurmak için hasır yakmak",
  "25": "Sıtma cehennemin sıcağındandır",
  "26": "Kendisine uygun gelmeyen yerden çıkan",
  "27": "Taun hakkında zikredilenler",
  "28": "Taunda sabredenin ecri",
  "29": "Kur'an ve muavvizelerle rukye",
  "30": "Fâtiha ile rukye",
  "31": "Bir sürü koyun karşılığında rukye şartı",
  "32": "Nazara karşı rukye",
  "33": "Nazar haktır",
  "34": "Yılan ve akrebe karşı rukye",
  "35": "Peygamber ﷺ'in rukyesi",
  "36": "Rukyede üflemek",
  "37": "Rukye yapanın ağrıyan yeri sağ eliyle meshetmesi",
  "38": "Kadının erkeğe rukye yapması",
  "39": "Rukye yaptırmayan",
  "40": "Tıyere (uğursuzluk)",
  "41": "Fe'l (iyi fal)",
  "42": "Hâme yoktur",
  "43": "Kâhinlik",
  "44": "Sihir",
  "45": "Şirk ve sihir helak edici günahlardandır",
  "46": "Sihir çıkarılır mı?",
  "47": "Sihir",
  "48": "Beyanın bir kısmı sihirdir",
  "49": "Sihre karşı acve hurmasıyla tedavi",
  "50": "Hâme yoktur",
  "51": "Kendiliğinden bulaşma yoktur",
  "52": "Peygamber ﷺ'in zehirlenmesi hakkında zikredilenler",
  "53": "Dişi eşek sütü",
  "54": "Kaba sinek düşerse"
 },
