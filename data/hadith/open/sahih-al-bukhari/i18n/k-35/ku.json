 "babs": {
  "1": "Selem di pîvana naskirî de",
  "2": "Selem di kîşana naskirî de",
  "3": "Selem bi yê ku eslê malî li cem wî tune",
  "4": "Selem di darqespan de",
  "5": "Kefîl di selemê de",
  "6": "Rehin di selemê de",
  "7": "Selem heta wadeyeke naskirî",
  "8": "Selem heta ku deve bizê"
