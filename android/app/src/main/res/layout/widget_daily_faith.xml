<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_faith_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dar_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DĀR AL TAWḤĪD · DUʿĀʾ DES TAGES" android:textColor="@color/dar_gold" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_faith_arabic" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|end" android:textColor="@color/dar_text" android:textDirection="rtl" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_faith_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/dar_gold" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_faith_german" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="3" android:textColor="#D4D1C7" android:textSize="11sp" />
</LinearLayout>
