<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dar_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DĀR AL TAWḤĪD · GEBETSZEITEN" android:textColor="@color/dar_gold" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_prayer_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Nächstes Gebet" android:textColor="@color/dar_text" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_prayer_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/dar_gold" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_prayer_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:ellipsize="end" android:maxLines="1" android:text="Standort" android:textColor="#BFC2B9" android:textSize="10sp" />
    <LinearLayout android:id="@+id/widget_prayer_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_row_fajr_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#D4D1C7" android:textSize="10sp" /><TextView android:id="@+id/widget_row_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dar_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_row_dhuhr_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#D4D1C7" android:textSize="10sp" /><TextView android:id="@+id/widget_row_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dar_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_row_asr_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#D4D1C7" android:textSize="10sp" /><TextView android:id="@+id/widget_row_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dar_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_row_maghrib_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#D4D1C7" android:textSize="10sp" /><TextView android:id="@+id/widget_row_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dar_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_row_isha_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#D4D1C7" android:textSize="10sp" /><TextView android:id="@+id/widget_row_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dar_text" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
