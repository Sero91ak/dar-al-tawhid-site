{
  "version": 2,
  "feature": "prophetsKnowledgeBase",
  "env": {
    "test": "enabled",
    "production": "disabled"
  },
  "title": "Die Propheten",
  "intro": "Was Qurʾān, authentische Sunnah und gesicherte frühe Überlieferungen über die Propheten berichten.",
  "sourcePriority": [
    "Qurʾān",
    "authentische Sunnah",
    "authentische Überlieferungen der Ṣaḥābah",
    "zuverlässig belegte Überlieferungen der Tābiʿīn und frühen Salaf",
    "frühe Ḥadīṯ-, Tafsīr- und Athar-Werke mit Isnād-Prüfung",
    "spätere Werke ausschließlich zur Einordnung und Quellenanalyse"
  ],
  "notes": [
    "Nur namentlich zuverlässig belegte Personen in der Hauptliste.",
    "Die Überlieferung über 124.000 Propheten wird nicht als gesicherte Gesamtzahl dargestellt.",
    "Keine erfundenen biografischen Ergänzungen.",
    "KI-Ausgabe ist keine Quelle.",
    "production = disabled bis ausdrückliche Freigabe.",
    "approved erfordert reviewPass1 und reviewPass2."
  ],
  "uluAlAzmIds": [
    "nuh",
    "ibrahim",
    "musa",
    "isa",
    "muhammad"
  ],
  "policy": {
    "zeroTrust": true,
    "rule": "UNSICHER = NICHT VERÖFFENTLICHEN",
    "kiIsNotASource": true,
    "secondaryCannotReplacePrimary": true,
    "earlyWorkNotAutomaticallySahih": true,
    "israiliyyatDefaultHidden": true,
    "report124000": "document_only_in_research_with_isnad_never_as_certain_total"
  },
