{
  "project": "DĀR AL TAWḤĪD – Test-App Ḥadīṯ-Bibliothek",
  "schemaVersion": "1.2",
  "language": "de",
  "authenticOnly": true,
  "mode": "library",
  "sourceOfTruth": "/apple-tv/hadith/catalog.json",
  "dataRoot": "/apple-tv/hadith/",
  "loaderPath": "/test/assets/hadith-library-data.js",
  "gateStatePath": "/test/data/hadith-library-gate.json",
  "seriesMode": "auto-from-source-catalog",
  "seriesSourcePath": "/apple-tv/hadith/catalog.json",
  "access": {
    "enabled": false,
    "status": "in-progress",
    "label": "In Bearbeitung",
    "visibleInMoreArea": true,
    "allowOpenWhileLocked": false,
    "releaseRequired": true,
    "releasedByUser": false,
    "unlockRule": "Nur durch ausdrückliche Freigabe des Nutzers wird enabled=true und releasedByUser=true gesetzt."
  },
  "display": {
    "showHadith": true,
    "showSource": true,
    "showGrade": true,
    "showSharh": true,
    "showSharhSource": true,
    "requireVerifiedSharh": true,
    "lockedPlaceholderText": "Die Ḥadīṯ-Bibliothek ist vorbereitet, aber noch nicht freigegeben."
  },
  "appleTvPolicy": {
    "usesSameRecords": true,
    "renderSharh": false,
    "allowedFields": [
      "id",
      "recordType",
      "language",
      "categoryLabel",
      "narratorLine",
      "speakerLabel",
      "textMarkdown",
      "source",
      "sourceBook",
      "sourceChapter",
      "sourceSection",
      "sourceHadithNumber",
      "grade"
    ],
    "ignoredFields": [
      "sharhStatus",
      "sharhText",
      "sharhLanguage",
      "sharhScholar",
      "sharhBook",
      "sharhVolume",
      "sharhPage",
      "sharhChapter",
      "sharhSection",
      "sharhEdition",
      "sharhReference"
    ]
  },
  "hadithLibraryPolicy": {
    "usesSameRecords": true,
    "renderSharh": true,
    "renderSharhWhen": "sharhStatus === verified && sharhText is filled",
    "detailSectionTitle": "Šarḥ & Erklärung",
    "completionRule": "Ein Datensatz gilt für die Ḥadīṯ-Bibliothek erst als vollständig, wenn ein geprüfter klassischer Šarḥ eingetragen ist."
  },
  "organization": {
    "groupBy": [
      "bookCategory",
      "sourceBook",
      "sourceChapter"
    ],
    "sortBy": [
      "bookCategory",
      "sourceBook",
      "sourceChapter",
      "sourcePage",
      "sourceHadithNumber",
      "id"
    ],
    "detailFieldsOrder": [
      "recordType",
      "bookCategory",
      "narratorLine",
      "speakerLabel",
      "textMarkdown",
      "sourceBook",
      "sourceChapter",
      "sourceVolume",
      "sourcePage",
      "sourceHadithNumber",
      "grade",
      "sharhStatus",
      "sharhText",
      "sharhScholar",
      "sharhBook",
      "sharhChapter",
      "sharhVolume",
      "sharhPage",
      "sharhReference"
    ],
    "requiredForLibraryCompletion": [
      "id",
      "recordType",
      "textMarkdown",
      "sourceBook",
      "grade",
      "sharhStatus",
      "sharhText",
      "sharhScholar",
      "sharhBook",
      "sharhReference"
    ]
  },
  "surfaces": {
    "testApp": true,
    "iosApp": true,
    "appleTvScreensaver": false,
    "visitorApp": false,
    "website": false,
    "androidWebApp": false
  },
  "navigation": {
    "entryArea": "more",
    "entryLabel": "Ḥadīṯ-Bibliothek",
    "entryVisibleWhileLocked": true,
    "route": "#hadith-bibliothek",
    "blockedUntilRelease": true
  },
  "syncRule": "Neue HAD-Datensätze werden einmal unter /apple-tv/hadith/ gepflegt. Apple TV nutzt daraus nur Aussage und Quellenanzeige. Die Test-App- und spätere iOS-Ḥadīṯ-Bibliothek nutzt denselben Datensatz inklusive geprüftem Šarḥ.",
  "completionRule": {
    "completeBlockBeforeNext": true,
    "sharhRequiredForCompletion": true,
    "completedRecordSharhStatus": "verified",
    "libraryOrderRequired": true
  },
  "series": []
}
