  "syncRule": "Verifizierte HAD-Datensätze werden zentral aus apple-tv-hadith-staging geladen; Test-App benötigt pro neuem Datensatz keinen eigenen Daten-Commit.",
  "surfaces": {
    "testApp": true,
    "iosApp": false,
