<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.daraltawhid.voice-engine</string>
<key>ProgramArguments</key><array><string>/Users/USERNAME/Applications/DAR-Voice-Studio/DĀR Voice Engine.command</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/tmp/dar-voice-engine.log</string>
<key>StandardErrorPath</key><string>/tmp/dar-voice-engine.err</string>
</dict></plist>
