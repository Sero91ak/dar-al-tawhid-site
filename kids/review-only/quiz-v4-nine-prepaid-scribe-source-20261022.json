      "transcribedText": "Das merken wir uns: Wir dienen Allah allein."
    },
    {
      "generationId": "FGX65uXKWBnjULDxg3X1",
      "sourceUrl": "https://storage.googleapis.com/xi-backend/database/workspace/9e52ab872d7b4775b36e50d2e07d17be/content_generation/6rDA1ojEIGb8nOSaI8St/FGX65uXKWBnjULDxg3X1/content.mp3?X-Goog-Algorithm=GOOG4-RSA-SHA256&X-Goog-Credential=xi-backend-prod%40xi-labs.iam.gserviceaccount.com%2F20261021%2Fauto%2Fstorage%2Fgoog4_request&X-Goog-Date=20261021T224848Z&X-Goog-Expires=7200&X-Goog-SignedHeaders=host&X-Goog-",
