          "lessonId": "vocabulary-adab",
          "kind": "term-explanation",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Adab beschreibt angemessenes Benehmen, Respekt und Rücksicht, die wir aus islamischen Lehren lernen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
