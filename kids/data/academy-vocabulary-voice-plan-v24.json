      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "vocabulary-aqidah",
          "kind": "term-explanation",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "ʿAqīdah heißt unsere Glaubenslehre: was wir über Allah und die Grundlagen des Glaubens lernen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
