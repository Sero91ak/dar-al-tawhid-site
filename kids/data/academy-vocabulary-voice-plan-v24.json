          "kind": "term-explanation",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Īmān umfasst die Glaubensgrundlagen, über die uns der Qurʾān und die authentische Sunnah berichten.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
