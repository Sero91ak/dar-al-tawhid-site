          "kind": "term-explanation",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "ʿAqīdah bezeichnet die islamischen Glaubensgrundlagen aus Qurʾān und authentischer Sunnah.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "vocabulary-aqidah",
          "kind": "term-explanation",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Adab bedeutet: Gutes Benehmen.",
