          "lessonId": "vocabulary-sunnah",
          "kind": "term-explanation",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Sunnah umfasst die authentisch überlieferten Aussagen, Handlungen und Bestätigungen des Propheten ﷺ.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "vocabulary-sunnah",
          "kind": "term-explanation",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Qurʾān bedeutet: Allahs Wort.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
