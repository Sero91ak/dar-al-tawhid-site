  "phrases": [
    {
      "text": "Ich sage Danke für Hilfe. Entschuldigung ist eine eigene ehrliche Übung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "summary",
          "age": "all"
        }
      ]
    },
    {
      "text": "Wir üben, Danke zu sagen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Wenn mir jemand hilft, sage ich Danke.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Im Qurʾān gibt es einen Vers über Dankbarkeit.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Der Prophet ﷺ lehrte, dass Dank gegenüber Menschen zum Dank gegenüber Allah gehört.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Wenn ich jemanden verletze, sage ich ehrlich Entschuldigung. Das üben wir; es ist kein eigener Hadith.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Dank hat eine Stelle im Qurʾān und in der Sunnah.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Sūrat Ibrāhīm 14:7 spricht davon, dass Dankbarkeit mit weiterer Gabe verbunden wird.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Der Vers enthält auch eine Warnung. Wir nutzen sie hier nicht, um Angst zu machen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Abū Dāwūd 4811 überliefert von Abū Hurayrah sinngemäß: Wer den Menschen nicht dankt, dankt Allah nicht.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Eine Entschuldigung nach einem Fehler ist unsere eigene Übung und steht nicht in diesem Hadith.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Wir trennen gelesene Fundstelle und eigene Übung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Der auf der Tafsīr-Seite gedruckte Wortlaut von 14:7 umfasst Dank und eine Warnung vor Undank.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Abū Dāwūd, Kapitel über den Dank für eine Wohltat, Nummer 4811, nennt die Kette Muslim ibn Ibrāhīm, ar-Rabīʿ ibn Muslim, Muḥammad ibn Ziyād, Abū Hurayrah.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Dieselbe Seite bewertet den Hadith nicht. Die Einstufung ṣaḥīḥ durch al-Albānī steht in Islamweb-Fatwa 34287, zusammen mit Aḥmad, al-Adab al-Mufrad und Ibn Ḥibbān.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Es tut mir leid zu sagen und einen Schaden zu beheben, bleibt eine pädagogische Übung und wird keinem Hadith zugeschrieben.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "adab-danke-und-entschuldigung",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Ich bitte Allah um Hilfe und sage einer vertrauten erwachsenen Person, was schwer ist.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "summary",
          "age": "all"
        }
      ]
    },
    {
      "text": "Bei einem Problem musst du nicht allein bleiben.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Ich darf einer vertrauten erwachsenen Person sagen, was schwer ist.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Der Qurʾān ruft dazu auf, Hilfe bei Geduld und dem Gebet zu suchen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Ein Hadith sagt sinngemäß, dass Allah dem hilft, der seinem Bruder hilft.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Das Bescheidsagen bei einer sicheren Person ist unsere Schutzübung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Hilfe bei Allah und Hilfe bei Menschen sind nicht dasselbe.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Qurʾān 2:153 nennt Geduld und Gebet als Weg, Hilfe zu suchen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Der Hadith auf der gelesenen Seite spricht davon, einem Bruder zu helfen, und davon, dass Allah dann hilft.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Die Seite schreibt den Hadith Muslim zu, druckt aber keine Nummer. Wir erfinden keine.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Wenn mich etwas bedrückt, sage ich es einer vertrauten erwachsenen Person. Das ist Schutz und kein Hadith-Wortlaut.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Wir prüfen, was die Seite wirklich druckt.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Der gedruckte Wortlaut von 2:153 verbindet die Bitte um Hilfe mit Geduld und Gebet.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Artikel 76979 zitiert von Abū Hurayrah den Satz, Allah sei dem Menschen eine Hilfe, solange dieser seinem Bruder helfe, und schreibt den Hadith Muslim zu.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Eine Nummer fehlt auf dieser Seite. Die frühere Quellenbank-Zahl wird deshalb nicht als erneut geprüft ausgegeben.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Die Unterrichtslage, einer sicheren erwachsenen Person eine Schwierigkeit zu sagen, bleibt Kinderschutz und wird nicht als Wortlaut des Hadith ausgegeben.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "tarbiyah-bei-problemen-hilfe-holen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Ich merke eine Gabe Allahs und danke. Das Nennen selbst ist Übung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "summary",
          "age": "all"
        }
      ]
    },
    {
      "text": "Wir merken etwas, wofür wir dankbar sind.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Ich kann eine Sache nennen, die mir guttut.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Dank beginnt im Herzen und darf auch mit Worten kommen.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Der Qurʾān spricht in 14:7 über Dankbarkeit.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Dass ich eine Gabe nenne, ist unsere Übung und kein neuer Hadith.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "4-5"
        }
      ]
    },
    {
      "text": "Innere Dankbarkeit und der Dank an Menschen gehören zusammen, sind aber nicht derselbe Satz.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "14:7 spricht von Dankbarkeit gegenüber Allah und enthält außerdem eine Warnung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Wir wiederholen die Warnung nicht als Angstaufgabe.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Abū Dāwūd 4811 verbindet den Dank an Allah mit dem Dank an Menschen. Das ist dieselbe schon gelesene Stelle.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Eine eigene Gabe zu nennen, übt das Bemerken. Es ist kein überlieferter Wortlaut.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "6-8"
        }
      ]
    },
    {
      "text": "Diese Stunde benutzt keine neue, ungeprüfte Überlieferung.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Der religiöse Vers ist erneut 14:7, gelesen auf der Ibn-Kaṯīr-Seite, nicht ein zweiter Vers.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
        {
          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Der Hadith ist erneut Abū Dāwūd 4811 und nicht eine zusätzliche Nummer.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
