          "lessonId": "nafs-dankbarkeit-im-herzen",
          "kind": "narration",
          "age": "9-10"
        }
      ]
    },
    {
      "text": "Gesicht und Arme werden gewaschen. Über den Kopf wird gestrichen. Das genaue Maß lernen wir mit einer Lehrperson.",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 1,
      "reviewStatus": "not-generated",
      "contexts": [
