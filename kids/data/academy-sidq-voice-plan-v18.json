        }
      ]
    },
    {
      "text": "Schön, dass du dein Wissen heute erweiterst!",
      "lang": "de-DE",
      "voiceProfileId": "serhat-owner-voice-2026",
      "modelId": "eleven_v4",
      "priority": 0,
      "reviewStatus": "not-generated",
