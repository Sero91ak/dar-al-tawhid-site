      "url": null,
      "voiceApproved": false
    },
    {
      "lessonId": "adab-gespraechspartner-ausreden-lassen",
      "age": "6-8",
      "kind": "line-2",
      "text": "Im Ḥadīṯ lernen wir, Gutes zu sagen oder still zu sein.",
