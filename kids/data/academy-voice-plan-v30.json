      "voiceApproved": false
    },
    {
      "lessonId": "adab-gespraechspartner-ausreden-lassen",
      "age": "6-8",
      "kind": "line-1",
      "text": "Qurʾān 17:53 lehrt, gute Worte zu wählen.",
