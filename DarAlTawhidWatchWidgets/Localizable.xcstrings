    "Āyah des Tages mit direktem Qurʾān-Link." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "آية اليوم مع رابط مباشر إلى القرآن."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ئایەتی ڕۆژ لەگەڵ بەستەری ڕاستەوخۆی قورئان."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Āyah of the day with a direct Qurʾān link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Āyah del día con enlace directo al Qurʾān."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Āyah du jour avec lien direct vers le Qurʾān."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ayeta rojê bi girêdana rasterast a Qurʾanê."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Doğrudan Kur’an bağlantısıyla günün ayeti."
          }
        }
      }
    },
