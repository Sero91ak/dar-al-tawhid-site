{"key":"bosnian_rwwad","version":"2.0.4","last_update":1741051043,"verses":[{"aya":1,"text":"Udar zastrašujući!","footnotes":""},{"aya":2,"text":"Šta je Udar zastrašujući?","footnotes":""},{"aya":3,"text":"I šta ti znaš šta je Udar zastrašujući?","footnotes":""},{"aya":4,"text":"Dan taj ljudi će biti kao leptiri raštrkani,","footnotes":""},{"aya":5,"text":"a planine kao šarena vuna iščupana.","footnotes":""},{"aya":6,"text":"Onaj čija dobra djela budu teška,","footnotes":""},{"aya":7,"text":"u ugodnom životu će živjeti,","footnotes":""},{"aya":8,"text":"a onaj čija dobra djela budu lahka,","footnotes":""},{"aya":9,"text":"boravište će mu bezdan biti.","footnotes":""},{"aya":10,"text":"A znaš li ti šta će to biti?","footnotes":""},{"aya":11,"text":"Vatra užarena!","footnotes":""}]}