{"key":"bosnian_rwwad","version":"2.0.4","last_update":1741051043,"verses":[{"aya":1,"text":"Reci: “Utječem se Gospodaru ljudi,","footnotes":""},{"aya":2,"text":"Vladaru ljudi,","footnotes":""},{"aya":3,"text":"Bogu ljudi,","footnotes":""},{"aya":4,"text":"od zla šejtana – koji nanosi zle misli pa se skrije,","footnotes":""},{"aya":5,"text":"koji zle misli unosi u prsa ljudi;","footnotes":""},{"aya":6,"text":"od džina i od ljudi!\"","footnotes":""}]}