{"key":"bosnian_rwwad","version":"2.0.4","last_update":1741051043,"verses":[{"aya":1,"text":"Zar grudi tvoje nismo prostranim učinili","footnotes":""},{"aya":2,"text":"i breme tvoje skinuli,","footnotes":""},{"aya":3,"text":"koje je pleća tvoja pritiskalo,","footnotes":""},{"aya":4,"text":"i spomen na tebe visoko uzdigli!","footnotes":""},{"aya":5,"text":"Pa, zaista, s mukom je olakšanje,","footnotes":""},{"aya":6,"text":"zaista, s mukom je olakšanje!","footnotes":""},{"aya":7,"text":"A kad završiš, molitvi se predaj,","footnotes":""},{"aya":8,"text":"i Gospodaru svome teži!","footnotes":""}]}