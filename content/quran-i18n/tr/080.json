{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Yüzünü ekşitti ve arkasını döndü.","footnotes":""},{"aya":2,"text":"Kendisine o âmâ geldi diye.","footnotes":""},{"aya":3,"text":"Ne bilirsin belki o temizlenecekti.","footnotes":""},{"aya":4,"text":"Yahut öğüt alacaktı da bu öğüt ona fayda verecekti.","footnotes":""},{"aya":5,"text":"Kendini muhtaç hissetmeyene gelince;","footnotes":""},{"aya":6,"text":"Sen, ona yöneliyorsun.","footnotes":""},{"aya":7,"text":"(İstemiyorsa) arınmamasından sen sorumlu değilsin!","footnotes":""},{"aya":8,"text":"Fakat koşup sana gelen kimse;","footnotes":""},{"aya":9,"text":"(Allah'tan) korkuğu halde;","footnotes":""},{"aya":10,"text":"Sen onu bırakıp oyalanıyorsun.","footnotes":""},{"aya":11,"text":"Hayır. Bu ancak bir öğüttür.","footnotes":""},{"aya":12,"text":"Artık dileyen kimse ondan öğüt alır.","footnotes":""},{"aya":13,"text":"(O) şerefli sahifelerdedir.","footnotes":""},{"aya":14,"text":"Yüce ve tertemiz olan.","footnotes":""},{"aya":15,"text":"Kâtiplerin ellerinde.","footnotes":""},{"aya":16,"text":"Değerli ve itaatkâr olan (Meleklerin).","footnotes":""},{"aya":17,"text":"Kahrolası (inkârcı) insan! Ne nankördür o!","footnotes":""},{"aya":18,"text":"Allah, onu hangi şeyden yarattı?","footnotes":""},{"aya":19,"text":"Bir nutfeden yarattı ve belli bir şekle soktu.","footnotes":""},{"aya":20,"text":"Sonra da ona yolu kolaylaştırdı.","footnotes":""},{"aya":21,"text":"Sonra da onu öldürüp kabre koydu.","footnotes":""},{"aya":22,"text":"Sonra dilediği zaman onu yeniden diriltir.","footnotes":""},{"aya":23,"text":"Hayır. O (Rabbinin) kendisine emrettiğini yerine getirmedi.","footnotes":""},{"aya":24,"text":"İnsan yiyeceğine bir baksın.","footnotes":""},{"aya":25,"text":"Şüphesiz biz suyu/yağmuru döktükçe döktük.","footnotes":""},{"aya":26,"text":"Sonra toprağı iyiden iyiye yardık!","footnotes":""},{"aya":27,"text":"Ve orada taneler bitirdik.","footnotes":""},{"aya":28,"text":"Üzümler ve yoncalar,","footnotes":""},{"aya":29,"text":"Zeytinler ve hurmalar,","footnotes":""},{"aya":30,"text":"Sık ağaçlı bahçeler,","footnotes":""},{"aya":31,"text":"Meyveler ve otlaklar,","footnotes":""},{"aya":32,"text":"Sizin ve hayvanlarınızın yararlanması için,","footnotes":""},{"aya":33,"text":"Kulakları sağır eden o ses geldiğinde,","footnotes":""},{"aya":34,"text":"O gün kişi kardeşinden kaçar.","footnotes":""},{"aya":35,"text":"Anasından ve babasından,","footnotes":""},{"aya":36,"text":"Eşinden ve evladından,","footnotes":""},{"aya":37,"text":"O gün herkes için kendine yetecek bir işi vardır.","footnotes":""},{"aya":38,"text":"O gün birtakım yüzler vardır ki pırıl pırıl parlarlar.","footnotes":""},{"aya":39,"text":"Güleç ve neşelidir.","footnotes":""},{"aya":40,"text":"Öyle yüzler de var ki o gün üzerini toz kaplamıştır.","footnotes":""},{"aya":41,"text":"Onları bir siyahlık bürür.","footnotes":""},{"aya":42,"text":"İşte onlar kâfirler, facirlerdir.","footnotes":""}]}