{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"(Dehşeti) Her şeyi kaplayacak olan (kıyamet)in haberi sana geldi mi?","footnotes":""},{"aya":2,"text":"O gün birtakım yüzler vardır ki, zillete bürünmüşlerdir.","footnotes":""},{"aya":3,"text":"Çalışmış, (boşa) yorulmuşlardır.","footnotes":""},{"aya":4,"text":"Kızgın ateşe girerler.","footnotes":""},{"aya":5,"text":"Son derece kızgın bir kaynaktan içirilirler.","footnotes":""},{"aya":6,"text":"Onlar için kuru bir dikenden başka yiyecek yoktur.","footnotes":""},{"aya":7,"text":"Ne doyurup semirtir, ne de açlıktan korur.","footnotes":""},{"aya":8,"text":"O gün birtakım yüzler vardır ki, nimet içinde mutludurlar.","footnotes":""},{"aya":9,"text":"Yaptıklarından dolayı hoşnutturlar.","footnotes":""},{"aya":10,"text":"Yüksek bir Cennet'tedirler.","footnotes":""},{"aya":11,"text":"Orada hiçbir boş söz işitmezler.","footnotes":""},{"aya":12,"text":"Orada akan bir pınar vardır.","footnotes":""},{"aya":13,"text":"Orada yüksek tahtlar vardır.","footnotes":""},{"aya":14,"text":"Yerleştirilmiş sürahiler.","footnotes":""},{"aya":15,"text":"Sıra sıra dizilmiş yastıklar,","footnotes":""},{"aya":16,"text":"Ve döşenmiş nefis halılar vardır.","footnotes":""},{"aya":17,"text":"Deveye bakmıyorlar mı, nasıl yaratılmıştır?","footnotes":""},{"aya":18,"text":"Göğe bakmıyorlar mı, nasıl yükseltilmiştir?","footnotes":""},{"aya":19,"text":"Dağlara bakmıyorlar mı, nasıl dikilmişlerdir?","footnotes":""},{"aya":20,"text":"Yeryüzüne bakmıyorlar mı, nasıl yayılmıştır?","footnotes":""},{"aya":21,"text":"Artık sen öğüt ver! Sen ancak bir öğüt vericisin.","footnotes":""},{"aya":22,"text":"Sen onların üzerinde bir zorba değilsin.","footnotes":""},{"aya":23,"text":"Ancak kim yüz çevirir ve küfre saparsa.","footnotes":""},{"aya":24,"text":"İşte öylesini Allah en büyük azap ile cezalandırır.","footnotes":""},{"aya":25,"text":"Şüphesiz onların dönüşü ancak bizedir.","footnotes":""},{"aya":26,"text":"Sonra onların sorguya çekilmesi de sadece bize aittir.","footnotes":""}]}