{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Yemin olsun, ardı ardına gönderilenlere.","footnotes":""},{"aya":2,"text":"Şiddetle esip savuranlara.","footnotes":""},{"aya":3,"text":"Yaydıkça yayanlara.","footnotes":""},{"aya":4,"text":"Ayırdıkça ayıranlara.","footnotes":""},{"aya":5,"text":"Zikri getirip, bırakanlara.","footnotes":""},{"aya":6,"text":"Gerek özür için olsun, gerek uyarı için.","footnotes":""},{"aya":7,"text":"Şüphe yok ki, size vaadedilen mutlaka gerçekleşecektir.","footnotes":""},{"aya":8,"text":"Yıldızların ışığı söndüğü zaman.","footnotes":""},{"aya":9,"text":"Gök yarıldığında.","footnotes":""},{"aya":10,"text":"Dağlar parçamparça olup savrulduğunda.","footnotes":""},{"aya":11,"text":"Peygamberlere ümmetleri hakkında şahitlik vakitleri bildirildiği zaman.","footnotes":""},{"aya":12,"text":"Bu, hangi güne ertelenmiş?","footnotes":""},{"aya":13,"text":"Ayrım (hüküm) gününe (ertelenmiştir).","footnotes":""},{"aya":14,"text":"Hüküm gününün ne olduğunu sen ne bileceksin?","footnotes":""},{"aya":15,"text":"O gün vay yalanlayanların haline!","footnotes":""},{"aya":16,"text":"Biz, öncekileri helak etmedik mi?","footnotes":""},{"aya":17,"text":"Sonra arkadan gelenleri de onların arkasına takacağız.","footnotes":""},{"aya":18,"text":"Biz, günahkârlara işte böyle yaparız.","footnotes":""},{"aya":19,"text":"O gün vay yalanlayanların haline!","footnotes":""},{"aya":20,"text":"Sizi basit bir sudan yaratmadık mı?","footnotes":""},{"aya":21,"text":"Ve onu sağlam bir yere yerleştirmedik mi?","footnotes":""},{"aya":22,"text":"Belli bir süreye kadar.","footnotes":""},{"aya":23,"text":"Buna gücümüz yeter. Ne güzel güç yetirenleriz.","footnotes":""},{"aya":24,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":25,"text":"Biz, yeryüzünü bir toplanma yeri kılmadık mı?","footnotes":""},{"aya":26,"text":"Diri olanları da, ölü olanları da.","footnotes":""},{"aya":27,"text":"Orada yüksek dağlar yaratıp size tatlı su içirmedik mi?","footnotes":""},{"aya":28,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":29,"text":"Yalanlamış olduğunuza (azaba) doğru yürüyün bakalım!","footnotes":""},{"aya":30,"text":"Üç kollu (ateşin) gölgesine doğru yürüyün!","footnotes":""},{"aya":31,"text":"Ne gölgelendirir, ne alevden korur.","footnotes":""},{"aya":32,"text":"O, her biri saraylar gibi olan kıvılcımlar saçar.","footnotes":""},{"aya":33,"text":"Her biri sarı develer gibidir.","footnotes":""},{"aya":34,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":35,"text":"Bu, onların konuşamayacakları bir gündür.","footnotes":""},{"aya":36,"text":"Onların özür dilemelerine dahi izin verilmez.","footnotes":""},{"aya":37,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":38,"text":"Bu, ayırma (hüküm) günüdür. Sizi ve evvelkileri bir araya toplarız.","footnotes":""},{"aya":39,"text":"Eğer bir tuzağınız varsa, haydi bana karşı tuzak kurun!","footnotes":""},{"aya":40,"text":"O gün, yalanlayanların vay haline!","footnotes":""},{"aya":41,"text":"Şüphesiz ki takva sahipleri, gölgelerde pınar başlarındadır.","footnotes":""},{"aya":42,"text":"Ve canlarının çekip-arzu ettiği meyveler (arasındadırlar).","footnotes":""},{"aya":43,"text":"Yaptığınız ameller sebebi ile afiyetle yiyin, için.","footnotes":""},{"aya":44,"text":"Biz, iyilik yapanları işte böyle ödüllendiririz.","footnotes":""},{"aya":45,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":46,"text":"Yiyin ve biraz yararlanın; muhakkak ki siz günahkârlarsınız.","footnotes":""},{"aya":47,"text":"O gün, yalanlayanların vay haline!","footnotes":""},{"aya":48,"text":"Onlara; “Rükû edin!” denildiği zaman rükû etmezlerdi.","footnotes":""},{"aya":49,"text":"O gün yalanlayanların vay haline!","footnotes":""},{"aya":50,"text":"Onlar bundan (Kur'an'dan) sonra artık hangi söze iman edecekler?","footnotes":""}]}