{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"De ki: İnsanların Rabbine sığınırım.","footnotes":""},{"aya":2,"text":"İnsanların hükümdarına.","footnotes":""},{"aya":3,"text":"İnsanların ilahına.","footnotes":""},{"aya":4,"text":"Sinsi/(Allah anıldığında geri kaçan) vesvesecinin şerrinden.","footnotes":""},{"aya":5,"text":"Ki o, insanların göğüslerine vesvese verir.","footnotes":""},{"aya":6,"text":"Gerek cinlerden, gerek insanlardan (olur).","footnotes":""}]}