{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Hesap gününü yalanlayanı gördün mü?","footnotes":""},{"aya":2,"text":"Yetimi itip kakan da işte odur.","footnotes":""},{"aya":3,"text":"Ve yoksulu doyurmaya teşvik etmez.","footnotes":""},{"aya":4,"text":"Vay o namaz kılanların haline ki:","footnotes":""},{"aya":5,"text":"Onlar kıldıkları namazdan gafildirler.","footnotes":""},{"aya":6,"text":"Onlar gösteriş yaparlar.","footnotes":""},{"aya":7,"text":"Hem de mâûnu da vermeyip, engellerler.","footnotes":""}]}