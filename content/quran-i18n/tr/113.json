{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"De ki: Ben, sabahın Rabbine sığınırım.","footnotes":""},{"aya":2,"text":"Yarattığı varlıkların şerrinden.","footnotes":""},{"aya":3,"text":"Karanlığı çöktüğü zaman gecenin şerrinden.","footnotes":""},{"aya":4,"text":"Düğümlere üfleyenlerin şerrinden.","footnotes":""},{"aya":5,"text":"Haset ettiği zaman hasetçinin şerrinden.","footnotes":""}]}