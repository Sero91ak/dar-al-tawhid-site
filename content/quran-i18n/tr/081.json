{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Güneş dürüldüğü zaman.","footnotes":""},{"aya":2,"text":"Yıldızlar, saçılıp dağıldığı zaman.","footnotes":""},{"aya":3,"text":"Dağlar yürütüldüğü zaman.","footnotes":""},{"aya":4,"text":"Gebe develer başıboş bırakıldığı zaman.","footnotes":""},{"aya":5,"text":"Vahşi hayvanlar bir araya toplandığı zaman.","footnotes":""},{"aya":6,"text":"Denizler tutuşturulduğu zaman.","footnotes":""},{"aya":7,"text":"Nefisler/kişiler (benzerleriyle) birleştirildiği zaman.","footnotes":""},{"aya":8,"text":"Diri diri (toprağa) gömülen kız çocuğuna sorulduğu zaman.","footnotes":""},{"aya":9,"text":"\"Hangi günâhtan dolayı öldürüldü?\" (diye).","footnotes":""},{"aya":10,"text":"Sahifeler (amel defterleri) açıldığı zaman.","footnotes":""},{"aya":11,"text":"Gök, sıyrılıp ayrıldığı zaman.","footnotes":""},{"aya":12,"text":"Cehennem alevlendirildiği zaman.","footnotes":""},{"aya":13,"text":"Ve Cennet yaklaştırıldığı zaman.","footnotes":""},{"aya":14,"text":"Her nefis önceden ne hazırladığını bilecektir.","footnotes":""},{"aya":15,"text":"Hayır! Yemin ederim gizlenen (yıldızlara).","footnotes":""},{"aya":16,"text":"O akıp akıp yörüngesinde giden ve gizlenenlere.","footnotes":""},{"aya":17,"text":"Karardığında geceye.","footnotes":""},{"aya":18,"text":"Aydınlanmaya başladığında sabaha.","footnotes":""},{"aya":19,"text":"Şüphesiz o, çok değerli bir elçinin sözüdür.","footnotes":""},{"aya":20,"text":"Kuvvet sahibi; Arşın sahibinin katında itibarlı (bir elçinin).","footnotes":""},{"aya":21,"text":"Kendine itaat edilen, üstelik güvenilir.","footnotes":""},{"aya":22,"text":"Arkadaşınız bir mecnun değildir.","footnotes":""},{"aya":23,"text":"Onu (Cebrail'i) ufukta apaçık görmüştür.","footnotes":""},{"aya":24,"text":"O, gayp hakkında cimri değildir.","footnotes":""},{"aya":25,"text":"O, kovulmuş Şeytan'ın sözü de değildir.","footnotes":""},{"aya":26,"text":"Öyleyse nereye gidiyorsunuz?","footnotes":""},{"aya":27,"text":"O, yalnızca bütün âlemler için bir öğüttür.","footnotes":""},{"aya":28,"text":"Sizden dosdoğru olmak isteyenler için.","footnotes":""},{"aya":29,"text":"Âlemlerin Rabbi Allah dilemedikçe siz de dileyemezsiniz.","footnotes":""}]}