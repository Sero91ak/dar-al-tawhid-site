{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Kıyamet koptuğu zaman.","footnotes":""},{"aya":2,"text":"Onun gerçekleşmesine artık yalan diyecek yoktur.","footnotes":""},{"aya":3,"text":"O; alçaltıcı, yükselticidir.","footnotes":""},{"aya":4,"text":"Yer şiddetle sarsılınca.","footnotes":""},{"aya":5,"text":"Dağlar paramparça olduğunda.","footnotes":""},{"aya":6,"text":"Derken toz toprak halinde dağılıp savrulduğu zaman.","footnotes":""},{"aya":7,"text":"Ve sizler de üç sınıf olduğunuz zaman.","footnotes":""},{"aya":8,"text":"Sağdakiler, (ne mutlu) o sağdakilere!","footnotes":""},{"aya":9,"text":"Soldakiler, ne bahtsızdır onlar!","footnotes":""},{"aya":10,"text":"(Hayırda) önde olanlar, öncülerdir.","footnotes":""},{"aya":11,"text":"İşte onlar, yakınlaştırılmış olanlardır.","footnotes":""},{"aya":12,"text":"Onlar Naim Cennetleri'ndedirler.","footnotes":""},{"aya":13,"text":"Bir çoğu öncekilerdendir.","footnotes":""},{"aya":14,"text":"Birazı da sonrakilerdendir.","footnotes":""},{"aya":15,"text":"(Altın ile) işlenmiş tahtlar üzerindedirler.","footnotes":""},{"aya":16,"text":"Karşılıklı olarak oturup yaslanırlar.","footnotes":""},{"aya":17,"text":"Onların etrafında ölümsüz genç hizmetçiler dolaşır.","footnotes":""},{"aya":18,"text":"Kaynağından (doldurulmuş) testiler, ibrikler ve kadehler.","footnotes":""},{"aya":19,"text":"Ondan başları da ağrımaz ve akılları da giderilmez.","footnotes":""},{"aya":20,"text":"Beğendikleri meyveler.","footnotes":""},{"aya":21,"text":"Canlarının çektiği kuş etleri.","footnotes":""},{"aya":22,"text":"Ve iri gözlü huriler.","footnotes":""},{"aya":23,"text":"Saklı inciler gibi.","footnotes":""},{"aya":24,"text":"İşledikleri amellere karşılık olarak (verilir.)","footnotes":""},{"aya":25,"text":"Orada boş bir söz ve günaha sokan bir laf işitmezler.","footnotes":""},{"aya":26,"text":"Söylenen; yalnızca \"Selâm, selâm!\" dır.","footnotes":""},{"aya":27,"text":"Sağdakiler, (ne mutlu) o sağdakilere!","footnotes":""},{"aya":28,"text":"Dikensiz sedir ağaçlarında.","footnotes":""},{"aya":29,"text":"Salkım salkım muz ağaçlarında.","footnotes":""},{"aya":30,"text":"Uzamış gölgeler.","footnotes":""},{"aya":31,"text":"Çağlayarak akan sular.","footnotes":""},{"aya":32,"text":"Bir çok meyveler.","footnotes":""},{"aya":33,"text":"Bitip tükenmeyen ve yasaklanmayan.","footnotes":""},{"aya":34,"text":"Ve yüksek döşekler içindedirler.","footnotes":""},{"aya":35,"text":"Biz, o hurileri yeni bir yaratılışla yarattık.","footnotes":""},{"aya":36,"text":"Onları bakireler kıldık.","footnotes":""},{"aya":37,"text":"Eşlerine düşkün ve yaşıt.","footnotes":""},{"aya":38,"text":"Sağ taraftakiler için.","footnotes":""},{"aya":39,"text":"Bir çoğu öncekilerden.","footnotes":""},{"aya":40,"text":"Bir çoğu da sonrakilerdendir.","footnotes":""},{"aya":41,"text":"Soldakiler, ne bahtsızdır onlar!","footnotes":""},{"aya":42,"text":"İçlerine işleyen bir ateş ve kaynar su içinde.","footnotes":""},{"aya":43,"text":"Simsiyah bir duman gölgesinde.","footnotes":""},{"aya":44,"text":"Ne bir serinlik, ne de bir güzellik!","footnotes":""},{"aya":45,"text":"Çünkü onlar, bundan önce (arzularının hoşuna giden şeyler içinde) şımarmış kimselerdi.","footnotes":""},{"aya":46,"text":"Büyük günah üzerinde ısrar ediyorlardı.","footnotes":""},{"aya":47,"text":"\"Biz ölüp, toprak ve kemik olduktan sonra tekrar mı dirileceğiz?\" diyorlardı.","footnotes":""},{"aya":48,"text":"\"Daha önceki atalarımız da mı?\"","footnotes":""},{"aya":49,"text":"De ki: \"Hem öncekiler, hem sonrakiler.\"","footnotes":""},{"aya":50,"text":"Belli bir günün, belli bir vaktinde bir araya getirileceksiniz.","footnotes":""},{"aya":51,"text":"Sonra gerçekten sizler ey sapıklar, yalanlayıcılar!","footnotes":""},{"aya":52,"text":"Elbette bir ağaçtan, zakkum ağacından yiyeceksiniz.","footnotes":""},{"aya":53,"text":"Karınlarınızı hep ondan dolduracaksınız.","footnotes":""},{"aya":54,"text":"Üstüne de kaynar sudan içeceksiniz.","footnotes":""},{"aya":55,"text":"Susamış develerin içişi gibi içeceksiniz.","footnotes":""},{"aya":56,"text":"İşte ceza gününde onlara sunulacak ziyafet budur.","footnotes":""},{"aya":57,"text":"Sizi biz yarattık. (Tekrardan yaratılışı) tasdik etmeniz gerekmez mi ?","footnotes":""},{"aya":58,"text":"Akıttığınız meniyi gördünüz mü?","footnotes":""},{"aya":59,"text":"Onu siz mi yaratıyorsunuz? Yoksa yaratan biz miyiz?","footnotes":""},{"aya":60,"text":"Aranızda ölümü takdir eden biziz. Bizler aciz de değiliz.","footnotes":""},{"aya":61,"text":"Yerinize benzerlerinizi getirip, değiştirmek ve sizi bilemediğiniz bir şekilde yeniden yaratmak hususunda.","footnotes":""},{"aya":62,"text":"Andolsun ki ilk yaratmayı bildiniz. O halde düşünüp öğüt almanız gerekmez mi?","footnotes":""},{"aya":63,"text":"Ektiğiniz şeyleri gördünüz mü?","footnotes":""},{"aya":64,"text":"Onu siz mi bitiriyorsunuz? Yoksa bitiren biz miyiz?","footnotes":""},{"aya":65,"text":"Dileseydik onu kuru bir çöp yapardık; siz de şaşırıp kalırdınız.","footnotes":""},{"aya":66,"text":"Doğrusu borç altına girdik.","footnotes":""},{"aya":67,"text":"\"Daha doğrusu biz yoksul bırakıldık (dersiniz).\"","footnotes":""},{"aya":68,"text":"İçtiğiniz suyu gördünüz mü?","footnotes":""},{"aya":69,"text":"Onu buluttan siz mi indirdiniz? Yoksa indiren biz miyiz?","footnotes":""},{"aya":70,"text":"Dileseydik onu tuzlu yapardık. Şükretmeniz gerekmez mi?","footnotes":""},{"aya":71,"text":"Tutuşturup, yakmakta olduğunuz ateşi gördünüz mü?","footnotes":""},{"aya":72,"text":"Onun ağacını siz mi yarattınız? Yoksa yaratan biz miyiz?","footnotes":""},{"aya":73,"text":"Biz onu, bir ibret ve gelip geçen yolcuların istifadesi için yarattık.","footnotes":""},{"aya":74,"text":"O halde sen, Yüce Rabbinin adını tesbih et!","footnotes":""},{"aya":75,"text":"Yıldızların yerlerine yemin ederim ki!","footnotes":""},{"aya":76,"text":"Eğer bilirseniz, gerçekten bu büyük bir yemindir.","footnotes":""},{"aya":77,"text":"Şüphesiz bu, değerli bir Kur'an'dır.","footnotes":""},{"aya":78,"text":"Gizli/korunmuş bir kitaptadır.","footnotes":""},{"aya":79,"text":"Ona ancak temizlenmiş olanlar dokunabilir.","footnotes":""},{"aya":80,"text":"Âlemlerin Rabbi tarafından indirilmiştir.","footnotes":""},{"aya":81,"text":"Şimdi siz, bu sözü mü yalanlıyorsunuz?","footnotes":""},{"aya":82,"text":"Onu yalanlayarak mı size verilen nimete şükrediyorsunuz?","footnotes":""},{"aya":83,"text":"Hani can boğaza gelip dayandığında.","footnotes":""},{"aya":84,"text":"O vakit siz bakıp durursunuz.","footnotes":""},{"aya":85,"text":"Biz; ona sizden daha yakınız, ama göremezsiniz.","footnotes":""},{"aya":86,"text":"Madem ki (tekrardan dirilip) ceza görmeyecekmişsiniz.","footnotes":""},{"aya":87,"text":"Eğer doğru söylüyor iseniz, onu (çıkmakta olan canı) geri çevirsenize!","footnotes":""},{"aya":88,"text":"Eğer o (ölen kişi), yakın kılınanlardan ise.","footnotes":""},{"aya":89,"text":"Ona rahatlık, güzel rızık ve Naim Cenneti vardır.","footnotes":""},{"aya":90,"text":"Eğer o, sağdakilerden ise.","footnotes":""},{"aya":91,"text":"Ey sağdaki! Sana selam olsun!","footnotes":""},{"aya":92,"text":"Eğer o, yalanlayan sapıklardan ise.","footnotes":""},{"aya":93,"text":"İşte ona da kaynar sudan bir ziyafet vardır.","footnotes":""},{"aya":94,"text":"Ve (onun sonu) Cehennem'e atılmaktır.","footnotes":""},{"aya":95,"text":"Şüphe yok ki, kesin gerçek işte budur.","footnotes":""},{"aya":96,"text":"O halde sen, Yüce Rabbinin adını tesbih et!","footnotes":""}]}