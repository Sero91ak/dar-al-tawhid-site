{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Yaratan Rabbinin adıyla oku!","footnotes":""},{"aya":2,"text":"O, insanı bir kan pıhtısından yarattı.","footnotes":""},{"aya":3,"text":"Oku! Senin Rabbin, en cömert olandır.","footnotes":""},{"aya":4,"text":"Ki O, kalem ile öğretmiştir.","footnotes":""},{"aya":5,"text":"İnsana bilmediği şeyleri öğretti.","footnotes":""},{"aya":6,"text":"Hayır! İnsan gerçekten azgınlık eder.","footnotes":""},{"aya":7,"text":"Kendini müstağni/ihtiyacı yok gördü diye.","footnotes":""},{"aya":8,"text":"Şüphesiz dönüş yalnızca Rabbine olacaktır.","footnotes":""},{"aya":9,"text":"Sen, o engel olanı gördün mü?","footnotes":""},{"aya":10,"text":"Bir kulu namaz kıldığı vakit.","footnotes":""},{"aya":11,"text":"Ne dersin o (Peygamber) doğru yolda ise.","footnotes":""},{"aya":12,"text":"Yahut takvayı emrettiyse.","footnotes":""},{"aya":13,"text":"Gördün mü? Ya o (engel olan) yalanladı ve yüz çevirdiyse!","footnotes":""},{"aya":14,"text":"O Allah’ın, her şeyi gördüğünü bilmiyor mu?","footnotes":""},{"aya":15,"text":"Hayır! Eğer son vermezse, elbette perçeminden yakalayıp sürükleriz.","footnotes":""},{"aya":16,"text":"Yalancı, günahkâr perçeminden.","footnotes":""},{"aya":17,"text":"Haydi! O meclisini /Taraftarlarını çağırsın.","footnotes":""},{"aya":18,"text":"Biz de Zebanileri çağıracağız.","footnotes":""},{"aya":19,"text":"Hayır ona itaat etme! Allah’a secde et ve (yalnızca) O’na yaklaş.","footnotes":""}]}