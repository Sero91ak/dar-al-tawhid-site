{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Çoklukla övünmek sizi oyaladı.","footnotes":""},{"aya":2,"text":"Ta ki, kabirleri ziyaret edinceye/ölünceye dek devam ettiniz.","footnotes":""},{"aya":3,"text":"Hayır! İlerde bileceksiniz.","footnotes":""},{"aya":4,"text":"Yine hayır! İleride bileceksiniz.","footnotes":""},{"aya":5,"text":"Hayır! Kesin bir bilgiyle bilseydiniz (kaçınırdınız).","footnotes":""},{"aya":6,"text":"Elbette Cehennem'i göreceksiniz.","footnotes":""},{"aya":7,"text":"Yine andolsun, onu gözünüzle kesin olarak göreceksiniz.","footnotes":""},{"aya":8,"text":"Sonra o gün, nimetlerden hesaba çekileceksiniz.","footnotes":""}]}