{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Kureyş’in güvenliği ve esenliği için.","footnotes":""},{"aya":2,"text":"Onların kış ve yaz yolculuklarının güvenliği için.","footnotes":""},{"aya":3,"text":"Bu evin (Kâbe) Rabbine ibadet etsinler.","footnotes":""},{"aya":4,"text":"Onları açlıktan doyuran ve korkularından emin kılana.","footnotes":""}]}