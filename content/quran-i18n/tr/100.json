{"key":"turkish_rwwad","version":"1.0.4","last_update":1759071052,"verses":[{"aya":1,"text":"Soluk soluğa koşanlara yemin olsun!","footnotes":""},{"aya":2,"text":"(Koşarken) kıvılcım saçanlara.","footnotes":""},{"aya":3,"text":"Sabah vakti baskın yapanlara.","footnotes":""},{"aya":4,"text":"Tozu dumana katanlara.","footnotes":""},{"aya":5,"text":"Topluluğun tam ortasına dalanlara.","footnotes":""},{"aya":6,"text":"İnsan, Rabbine karşı gerçekten çok nankördür.","footnotes":""},{"aya":7,"text":"Ve şüphesiz kendisi de buna şahittir.","footnotes":""},{"aya":8,"text":"Şüphesiz onun mal sevgisi de çok şiddetlidir.","footnotes":""},{"aya":9,"text":"Bilmez mi ki kabirlerde olanlar alt üst edildiğinde.","footnotes":""},{"aya":10,"text":"Kalplerde bulunan ortaya konduğunda.","footnotes":""},{"aya":11,"text":"Şüphesiz o gün Rableri kendilerinden elbette haberdardır.","footnotes":""}]}