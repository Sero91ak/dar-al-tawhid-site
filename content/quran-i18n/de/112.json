{"key":"german_rwwad","version":"1.0.16","last_update":1793539555,"verses":[{"aya":1,"text":"Sag: „Er ist Allah, ein Einer,","footnotes":""},{"aya":2,"text":"Allah, der Überlegene.","footnotes":""},{"aya":3,"text":"Er hat nicht gezeugt und ist nicht gezeugt worden,","footnotes":""},{"aya":4,"text":"und niemand ist Ihm jemals gleich.“","footnotes":""}]}