{"id":84,"verses":[{"id":1,"tajweed":"إِذَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نش</span>َقَّتْ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَإِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضُ مُدَّتْ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"يَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>أَيُّهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ إِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ كَادِحٌ إِلَىٰ رَبِّكَ كَ<span>دْ</span><span class=\"tj tj-ikhafa\">حًا ف</span>َمُلَ<span class=\"tj tj-madda_normal\">ـٰ</span>ق<span class=\"tj tj-madda_permissible\">ِي</span>هِ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"فَأَ<span class=\"tj tj-ghunnah\">مّ</span>َا مَنْ أُوتِىَ كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَهُ<span class=\"tj tj-madda_normal\">ۥ</span> بِيَمِينِهِۦ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"فَسَوْفَ يُحَاسَبُ حِسَا<span class=\"tj tj-idgham_ghunnah\">بًا ي</span>َسِيرًا <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"وَيَ<span class=\"tj tj-ikhafa\">نق</span>َلِبُ إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَهْلِه<span class=\"tj tj-madda_normal\">ِۦ</span> مَسْرُورًا <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"وَأَ<span class=\"tj tj-ghunnah\">مّ</span>َا مَنْ أُوتِىَ كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَر<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ ظَهْرِهِۦ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"فَسَوْفَ يَ<span>دْ</span>عُو<span>اْ</span> ثُبُورًا <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"وَيَصْلَىٰ سَعِيرًا <span class=\"tj tj-end\" hidden>١٢</span>"},{"id":13,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَهْلِه<span class=\"tj tj-madda_normal\">ِۦ</span> مَسْرُورًا <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> ظَ<span class=\"tj tj-ghunnah\">نّ</span>َ أ<span class=\"tj tj-idgham_wo_ghunnah\">َن ل</span>ّ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َح<span class=\"tj tj-madda_permissible\">ُو</span>رَ <span class=\"tj tj-end\" hidden>١٤</span>"},{"id":15,"tajweed":"بَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ رَبَّهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> بَصِيرًا <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"فَل<span class=\"tj tj-madda_obligatory\">َآ</span> أُ<span>قْ</span>سِمُ بِ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّفَ<span>ق</span>ِ <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّيْلِ وَمَا وَسَ<span>ق</span>َ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْقَمَرِ إِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>تَّسَ<span>ق</span>َ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"لَتَرْكَبُ<span class=\"tj tj-ghunnah\">نّ</span>َ طَبَقًا عَ<span class=\"tj tj-ikhafa\">ن ط</span>َبَ<span>ق</span>ٍ <span class=\"tj tj-end\" hidden>١٩</span>"},{"id":20,"tajweed":"فَمَا لَهُمْ لَا يُؤْمِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٠</span>"},{"id":21,"tajweed":"وَإِذَا قُرِئَ عَلَيْهِمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرْءَانُ لَا يَسْجُدُ<span class=\"tj tj-madda_permissible\">و</span>نَ ۩ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"بَلِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span>اْ</span> يُكَذِّب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ أَعْلَمُ بِمَا يُوع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"فَبَشِّرْه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِعَذَابٍ أَل<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span>اْ</span> وَعَمِلُو<span>اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِحَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ لَهُمْ أَ<span>جْ</span>رٌ غَيْرُ مَمْن<span class=\"tj tj-madda_permissible\">ُو</span>نِۭ <span class=\"tj tj-end\" hidden>٢٥</span>"}],"source":"quran.com-uthmani-tajweed","version":1}