wasl\">ٱ</span>لَّذِينَ أُوتُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمُؤْمِنُونَ‌ۙ وَلِيَقُولَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ فِى قُلُوبِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>َّرَ<span class=\"tj tj-idgham_ghunnah\">ضٌ و</span>َ<span class=\"tj tj-ham_wasl\">ٱ</span>لْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِرُونَ مَاذ<span class=\"tj tj-madda_obligatory\">َآ</span> أَرَادَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ بِهَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا مَثَل<span class=\"tj tj-ikhafa\">اً‌ۚ ك</span>َذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ يُضِلُّ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ وَيَهْدِى م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ‌ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"كَلَّا وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْقَمَرِ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّيْلِ إِذْ أَ<span class=\"tj tj-qlqalah\">دْ</span>بَرَ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صُّ<span class=\"tj tj-qlqalah\">بْ</span>حِ إِذ<span class=\"tj tj-madda_obligatory\">َآ</span> أَسْفَرَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َهَا لَإِحْدَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْكُبَرِ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"نَذِي<span class=\"tj tj-idgham_wo_ghunnah\">رًا ل</span>ِّلْبَشَرِ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,