{"id":110,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ نَصْرُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْفَتْحُ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وَرَأَيْتَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسَ يَ<span class=\"tj tj-qlqalah\">دْ</span>خُلُونَ فِى دِينِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ أَفْوَاجًا <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَغْفِرْهُ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَ تَوَّابَۢا <span class=\"tj tj-end\" hidden>٣</span>"}]}