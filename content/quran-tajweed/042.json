ormal\">َٰ</span>لِكَ لَمِنْ عَزْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأُم<span class=\"tj tj-madda_permissible\">ُو</span>رِ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُضْلِلِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ فَمَا لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> م<span class=\"tj tj-idgham_ghunnah\">ِن و</span>َلِ<span class=\"tj tj-idgham_ghunnah\">ىٍّ م</span>ّ<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۗ وَتَرَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ظَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِمِينَ لَ<span class=\"tj tj-ghunnah\">مّ</span>َا رَأَوُ<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابَ يَقُولُونَ هَلْ إِلَىٰ مَرَ<span class=\"tj tj-idgham_ghunnah\">دٍّ م</span>ِّ<span class=\"tj tj-ikhafa\">ن س</span>َب<span class=\"tj tj-madda_permissible\">ِي</span>لٍ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"وَتَرَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُمْ يُعْرَضُونَ عَلَيْهَا خَ<span class=\"tj tj-madda_normal\">ـٰ</span>شِعِينَ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذُّلِّ يَ<span class=\"tj tj-ikhafa\">نظ</span>ُرُونَ مِ<span class=\"tj tj-ikhafa\">ن ط</span>َرْفٍ خَفِ<span class=\"tj tj-idgham_ghunnah\">ىٍّ‌ۗ و</span>َقَالَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَن<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْخَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِرِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ خَسِر<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ikhafa\">نف</span>ُسَهُمْ وَأَهْلِيهِمْ يَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ‌ۗ أَل<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ظَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِمِينَ فِى عَذَا<span class=\"tj tj-idgham_ghunnah\">بٍ م</span>ُّق<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"وَمَا كَانَ لَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْ أَوْلِي<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ يَ<span class=\"tj tj-ikhafa\">نص</span>ُرُونَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۗ وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُضْلِلِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ فَمَا لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِ<span class=\"tj tj-ikhafa\">ن س</span>َب<span class=\"tj tj-madda_permissible\">ِي</span>لٍ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"ٱسْتَجِيبُو<span class=\"tj tj-silent\">اْ</span> لِرَبِّك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َأْتِىَ يَوْ<span class=\"tj tj-idgham_wo_ghunnah\">مٌ ل</span>َّا مَرَدَّ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۚ مَا لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّلْجَ<span class=\"tj tj-idgham_ghunnah\">إٍ ي</span>َوْمَئِ<span class=\"tj tj-idgham_ghunnah\">ذٍ و</span>َمَا لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّك<span class=\"tj tj-madda_permissible\">ِي</span>رٍ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"فَإِنْ أَعْرَضُو<span class=\"tj tj-silent\">اْ</span> فَم<span class=\"tj tj-madda_obligatory\">َآ</span> أَرْسَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>كَ عَلَيْهِمْ حَفِيظًا‌ۖ إِنْ عَلَيْكَ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>غُ‌ۗ وَإِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> إِذ<span class=\"tj tj-madda_obligatory\">َآ</span> أَذَ<span class=\"tj tj-qlqalah\">قْ</span>نَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ مِ<span class=\"tj tj-ghunnah\">نّ</span>َا رَحْمَ<span class=\"tj tj-ikhafa\">ةً ف</span>َرِحَ بِهَا‌ۖ وَإِ<span class=\"tj tj-ikhafa\">ن ت</span>ُصِ<span class=\"tj tj-qlqalah\">بْ</span>هُمْ سَيِّئَ<span class=\"tj tj-iqlab\">ةُۢ ب</span>ِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ كَف<span class=\"tj tj-madda_permissible\">ُو</span>رٌ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"لِّلَّهِ مُلْكُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ‌ۚ يَخْلُقُ مَا يَش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۚ يَهَبُ لِم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ إِنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">ثًا و</span>َيَهَبُ لِم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذُّك<span class=\"tj tj-madda_permissible\">ُو</span>رَ <span class=\"tj tj-end\" hidden>٤٩</span>"},{"id":50,"tajweed":"أَوْ يُزَوِّجُهُمْ ذُكْرَا<span class=\"tj tj-idgham_ghunnah\">نًا و</span>َإِنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">ثًا‌ۖ و</span>َيَ<span class=\"tj tj-qlqalah\">جْ</span>عَلُ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ عَقِيمًا‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> عَلِي<span class=\"tj tj-ikhafa\">مٌ ق</span>َد<span class=\"tj tj-madda_permissible\">ِي</span>رٌ <span class=\"tj tj-end\" hidden>٥٠</span>"},{"id":51,"tajweed":"۞ وَمَا كَانَ لِبَشَرٍ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُكَلِّمَهُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ إِلَّا وَحْيًا أَوْ م<span class=\"tj tj-idgham_ghunnah\">ِن و</span>َرَآىِٕ حِجَابٍ أَوْ يُرْسِلَ رَسُول<span class=\"tj tj-ikhafa\">اً ف</span>َيُوحِىَ بِإِذْنِه<span class=\"tj tj-madda_normal\">ِۦ</span> مَا يَش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> عَلِىٌّ حَك<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٥١</span>"},{"id":52,"tajweed":"وَكَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ أَوْحَيْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَيْكَ رُو<span class=\"tj tj-idgham_ghunnah\">حًا م</span>ِّنْ أَمْرِنَا‌ۚ مَا كُ<span class=\"tj tj-ikhafa\">نت</span>َ تَ<span class=\"tj tj-qlqalah\">دْ</span>رِى مَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بُ وَلَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِيمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ikhafa\">ن ج</span>َعَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ نُو<span class=\"tj tj-idgham_ghunnah\">رًا ن</span>َّهْدِى بِه<span class=\"tj tj-madda_normal\">ِۦ</span> م<span class=\"tj tj-idgham_ghunnah\">َن ن</span>َّش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ مِنْ عِبَادِنَا‌ۚ وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ لَتَهْد<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَىٰ صِر<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">طٍ م</span>ُّسْتَق<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٥٢</span>"},{"id":53,"tajweed":"صِر<span class=\"tj tj-madda_normal\">َٰ</span>طِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مَا فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَمَا فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ‌ۗ أَل<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ تَصِيرُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأُم<span class=\"tj tj-madda_permissible\">ُو</span>رُ <span class=\"tj tj-end\" hidden>٥٣</span>"}]}