asl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دِّينِ مَا وَصَّىٰ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> نُو<span class=\"tj tj-idgham_ghunnah\">حًا و</span>َ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذ<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَوْحَيْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَيْكَ وَمَا وَصَّيْنَا بِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِ<span class=\"tj tj-qlqalah\">بْ</span>ر<span class=\"tj tj-madda_normal\">َٰ</span>هِيمَ وَمُوسَىٰ وَعِيسَ<span class=\"tj tj-madda_obligatory\">ىٰٓ‌ۖ</span> أَنْ أَقِيمُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دِّينَ وَلَا تَتَفَرَّقُو<span class=\"tj tj-silent\">اْ</span> فِيهِ‌ۚ كَبُرَ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُشْرِكِينَ مَا تَ<span class=\"tj tj-qlqalah\">دْ</span>عُوهُمْ إِلَيْهِ‌ۚ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَ<span class=\"tj tj-qlqalah\">جْ</span>تَب<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَيْهِ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ وَيَهْد<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَيْهِ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُن<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">ب</span>ُ <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"وَمَا تَفَرَّق<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِلَّا م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ مَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعِلْمُ بَغْي<span class=\"tj tj-iqlab\">َۢا ب</span>َيْنَهُمْ‌ۚ وَلَوْلَا كَلِمَ<span class=\"tj tj-ikhafa\">ةٌ س</span>َبَقَتْ م<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّبِّكَ إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَجَ<span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ُّسَم<span class=\"tj tj-idgham_wo_ghunnah\">ًّى ل</span>َّقُضِىَ بَيْنَهُمْ‌ۚ وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ أُورِثُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِهِمْ لَفِى شَ<span class=\"tj tj-idgham_ghunnah\">كٍّ م</span>ِّنْهُ مُر<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">ب</span>ٍ <span class=\"tj tj-end\" hidden>١٤</span>"},{"id":15,"tajweed":"فَلِذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">دْ</span>عُ‌ۖ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَقِمْ كَم<span class=\"tj tj-madda_obligatory\">َآ</span> أُمِرْتَ‌ۖ وَلَا تَتَّبِعْ أَهْو<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَهُمْ‌ۖ وَقُلْ ءَامَ<span class=\"tj tj-ikhafa\">نت</span>ُ بِم<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">نز</span>َلَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ مِ<span class=\"tj tj-ikhafa\">ن ك</span>ِتَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">بٍ‌ۖ و</span>َأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ‌ۖ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ رَبُّنَا وَرَبُّكُمْ‌ۖ لَن<span class=\"tj tj-madda_obligatory\">َآ</span> أَعْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>لُنَا وَلَكُمْ أَعْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>لُكُمْ‌ۖ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ‌ۖ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَ<span class=\"tj tj-qlqalah\">جْ</span>مَعُ بَيْنَنَا‌ۖ وَإِلَيْهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَص<span class=\"tj tj-madda_permissible\">ِي</span>رُ <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ يُح<span class=\"tj tj-madda_necessary\">َا</span>ٓجُّونَ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ مَا <span class=\"tj tj-ham_wasl\">ٱ</span>سْتُجِيبَ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> حُجَّتُهُمْ دَاحِضَةٌ عِ<span class=\"tj tj-ikhafa\">ند</span>َ رَبِّهِمْ وَعَلَيْهِمْ غَضَ<span class=\"tj tj-idgham_ghunnah\">بٌ و</span>َلَهُمْ عَذَا<span class=\"tj tj-ikhafa\">بٌ ش</span>َد<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">د</span>ٌ <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"ٱللَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذ<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَ<span class=\"tj tj-ikhafa\">نز</span>َلَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمِيزَانَ‌ۗ وَمَا يُ<span class=\"tj tj-qlqalah\">دْ</span>رِيكَ لَعَلَّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةَ قَر<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">ب</span>ٌ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"يَسْتَعْجِلُ بِهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ لَا يُؤْمِنُونَ بِهَا‌ۖ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَ<span class=\"tj tj-ghunnah\">نّ</span>َهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقُّ‌ۗ أَل<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ يُمَارُونَ فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةِ لَفِى ضَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-iqlab\">لِۭ ب</span>َع<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">د</span>ٍ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"ٱللَّهُ لَطِي<span class=\"tj tj-iqlab\">فُۢ ب</spa