{"id":71,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> أَنْ أَ<span class=\"tj tj-ikhafa\">نذ</span>ِرْ قَوْمَكَ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َأْتِيَهُمْ عَذَابٌ أَل<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"قَالَ يَ<span class=\"tj tj-madda_normal\">ـٰ</span>قَوْمِ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى لَكُمْ نَذِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"أَنِ <span class=\"tj tj-ham_wasl\">ٱ</span>عْبُدُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّقُوهُ وَأَطِيع<span class=\"tj tj-madda_permissible\">ُو</span>نِ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"يَغْفِرْ لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ذ</span>ُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَجَ<span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ُّسَ<span class=\"tj tj-ghunnah\">مّ</span>ًى‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَجَلَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ لَا يُؤَخَّرُ‌ۖ لَوْ كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"قَالَ رَبِّ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى دَعَوْتُ قَوْمِى لَيْل<span class=\"tj tj-idgham_ghunnah\">اً و</span>َنَهَارًا <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"فَلَمْ يَزِ<span class=\"tj tj-qlqalah\">دْ</span>هُمْ دُع<span class=\"tj tj-madda_obligatory\">َا</span>ٓء<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَّا فِرَارًا <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>ِى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَل<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَصَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِعَهُمْ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> ءَاذَانِهِمْ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَغْشَوْ<span class=\"tj tj-silent\">اْ</span> ثِيَابَهُمْ وَأَصَرُّو<span class=\"tj tj-silent\">اْ</span> وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَكْبَرُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>سْتِكْبَارًا <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى دَعَوْتُهُمْ جِهَارًا <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ إِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَعْلَ<span class=\"tj tj-ikhafa\">نت</span>ُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًا <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"فَقُلْتُ <span class=\"tj tj-ham_wasl\">ٱ</span>سْتَغْفِرُو<span class=\"tj tj-silent\">اْ</span> رَبَّكُمْ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَ غَفَّارًا <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"يُرْسِلِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ عَلَيْك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-qlqalah\">دْ</span>رَارًا <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"وَيُمْدِ<span class=\"tj tj-qlqalah\">دْ</span>ك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِأَمْو<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">لٍ و</span>َبَنِينَ وَيَ<span class=\"tj tj-qlqalah\">جْ</span>عَل لَّكُمْ جَ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٍ و</span>َيَ<span class=\"tj tj-qlqalah\">جْ</span>عَل لَّكُمْ أَنْهَ<span class=\"tj tj-madda_normal\">ـٰ</span>رًا <span class=\"tj tj-end\" hidden>١٢</span>"},{"id":13,"tajweed":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"وَقَ<span class=\"tj tj-qlqalah\">دْ</span> خَلَقَكُمْ أَ<span class=\"tj tj-qlqalah\">طْ</span>وَارًا <span class=\"tj tj-end\" hidden>١٤</span>"},{"id":15,"tajweed":"أَلَمْ تَرَوْ<span class=\"tj tj-silent\">اْ</span> كَيْفَ خَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ سَ<span class=\"tj tj-qlqalah\">بْ</span>عَ سَمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-ikhafa\">تٍ ط</span>ِبَاقًا <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"وَجَعَلَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَمَرَ فِيهِ<span class=\"tj tj-ghunnah\">نّ</span>َ نُو<span class=\"tj tj-idgham_ghunnah\">رًا و</span>َجَعَلَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّمْسَ سِرَاجًا <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ أَ<span class=\"tj tj-iqlab\">نۢب</span>َتَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ نَبَاتًا <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ جَعَلَ لَكُمُ <span clas