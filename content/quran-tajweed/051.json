{"id":51,"verses":[{"id":1,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذّ<span class=\"tj tj-madda_normal\">َٲ</span>رِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ ذَرْوًا <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَ<span class=\"tj tj-madda_normal\">ـٰ</span>مِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ وِ<span>قْ</span>رًا <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ يُسْرًا <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمُقَسِّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ أَمْرًا <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا تُوعَدُونَ لَصَادِ<span>ق</span>ٌ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دِّينَ لَو<span class=\"tj tj-madda_normal\">َٲ</span>قِعٌ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ ذَاتِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحُبُكِ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ لَفِى قَوْ<span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ُّخْتَلِفٍ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"قُتِلَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْخَرّ<span class=\"tj tj-madda_normal\">َٲ</span>ص<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"ٱلَّذِينَ هُمْ فِى غَمْرَ<span class=\"tj tj-ikhafa\">ةٍ س</span>َاه<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"يَسْــَٔلُونَ أَيَّانَ يَوْمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دّ<span class=\"tj tj-madda_permissible\">ِي</span>نِ <span class=\"tj tj-end\" hidden>١٢</span>"},{"id":13,"tajweed":"يَوْمَ هُمْ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َارِ يُفْتَن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"ذُوقُو<span>اْ</span> فِتْنَتَكُمْ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى كُ<span class=\"tj tj-ikhafa\">نت</span><span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِه<span class=\"tj tj-madda_normal\">ِۦ</span> تَسْتَعْجِل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٤</span>"},{"id":15,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُتَّقِينَ فِى جَ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٍ و</span>َعُي<span class=\"tj tj-madda_permissible\">ُو</span>نٍ <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"ءَاخِذِينَ م<span class=\"tj tj-madda_obligatory\">َآ</span> ءَاتَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ رَبُّهُمْ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ كَانُو<span>اْ</span> قَ<span>بْ</span>لَ ذ<span class=\"tj tj-madda_normal\">َٲ</span>لِكَ مُحْسِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"كَانُو<span>اْ</span> قَلِيل<span class=\"tj tj-idgham_ghunnah\">اً م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّيْلِ مَا يَهْجَع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"وَبِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَسْحَارِ هُمْ يَسْتَغْفِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"وَف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَمْو<span class=\"tj tj-madda_normal\">َٲ</span>لِهِمْ حَ<span class=\"tj tj-idgham_wo_ghunnah\">قٌّ ل</span>ِّلسّ<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِلِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمَحْر<span class=\"tj tj-madda_permissible\">ُو</span>مِ <span class=\"tj tj-end\" hidden>١٩</span>"},{"id":20,"tajweed":"وَفِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_wo_ghunnah\">تٌ ل</span>ِّلْمُوقِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٠</span>"},{"id":21,"tajweed":"وَف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَ<span class=\"tj tj-ikhafa\">نف</span>ُسِكُمْ‌ۚ أَفَلَا تُ<span>بْ</span>صِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"وَفِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ رِزْقُكُمْ وَمَا تُوعَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"فَوَرَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَحَ<span class=\"tj tj-idgham_ghunnah\">قٌّ م</span>ِّثْلَ م<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ تَ<span class=\"tj tj-ikhafa\">نط</span>ِق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"هَلْ أَتَ<span class=\"tj tj-madda_normal\">ـٰ</span>كَ حَدِيثُ ضَيْفِ إِ<span>بْ</span>ر<span class=\"tj tj-madda_normal\">َٲ</span>هِيمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُكْرَم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"إِذْ دَخَلُو<span>اْ</span> عَلَيْهِ فَقَالُو<span>اْ</span> سَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">مًا‌ۖ ق</span>َالَ سَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">مٌ ق</span>َوْ<span class=\"tj tj-idgham_ghunnah\">مٌ م</span>ُّ<span class=\"tj tj-ikhafa\">نك</span>َر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"فَرَاغَ إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَهْلِه<span class=\"tj tj-madda_normal\">ِۦ</span> فَج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ بِعِ<span>جْ</span><span class=\"tj tj-ikhafa\">لٍ س</span>َم<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٢٦</span>"},{"id":27,"tajweed":"فَقَرَّبَهُ<span class=\"tj tj-madda_obligatory\">ۥٓ</span> إِلَيْهِمْ قَالَ أَلَا تَأْكُل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٧</span>"},{"id":28,"tajweed":"فَأَوْجَسَ مِنْهُمْ خِيفَ<span class=\"tj tj-ikhafa\">ةً‌ۖ ق</span>َالُو<span>اْ</span> لَا تَخَفْ‌ۖ وَبَشَّرُوهُ بِغُلَ<span class=\"tj tj-madda_normal\">ـٰ</span>مٍ عَل<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٢٨</span>"},{"id":29,"tajweed":"فَأَ<span>قْ</span>بَلَتِ <span class=\"tj tj-ham_wasl\">ٱ</span>مْرَأَتُهُ<span class=\"tj tj-madda_normal\">ۥ</span> فِى صَرَّ<span class=\"tj tj-ikhafa\">ةٍ ف</span>َصَكَّتْ وَ<span>جْ</span>هَهَا وَقَالَتْ عَجُوزٌ عَق<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٢٩</span>"},{"id":30,"tajweed":"قَالُو<span>اْ</span> كَذ<span class=\"tj tj-madda_normal\">َٲ</span>لِكِ قَالَ رَبُّكِ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَكِيمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَل<span class=\"tj tj-madda_permissible\">ِي</span>مُ <span class=\"tj tj-end\" hidden>٣٠</span>"},{"id":31,"tajweed":"۞ قَالَ فَمَا خَ<span>طْ</span>بُكُمْ أَيُّهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُرْسَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span>اْ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أُرْسِلْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَىٰ قَوْ<span class=\"tj tj-idgham_ghunnah\">مٍ م</span>ُّ<span>جْ</span>رِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"لِنُرْسِلَ عَلَيْهِمْ حِجَارَ<span class=\"tj tj-idgham_ghunnah\">ةً م</span>ِّ<span class=\"tj tj-ikhafa\">ن ط</span><span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"مُّسَوَّمَةً عِ<span class=\"tj tj-ikhafa\">ند</span>َ رَبِّكَ لِلْمُسْرِف<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"فَأَخْرَ<span>جْ</span>نَا مَ<span class=\"tj tj-ikhafa\">ن ك</span>َانَ فِيهَا مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُؤْمِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"فَمَا وَجَ<span>دْ</span>نَا فِيهَا غَيْرَ بَيْ<span class=\"tj tj-idgham_ghunnah\">تٍ م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُسْلِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,"tajweed":"وَتَرَكْنَا فِيه<span class=\"tj tj-madda_obligatory\">َآ</span> ءَايَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>ِّلَّذِينَ يَخَافُونَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَل<span class=\"tj tj-madda_permissible\">ِي</span>مَ <span class=\"tj tj-end\" hidden>٣٧</span>"},{"id":38,"tajweed":"وَفِى مُوسَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِذْ أَرْسَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ إِلَىٰ فِرْعَوْنَ بِسُلْطَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">نٍ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٣٨</span>"},{"id":39,"tajweed":"فَتَوَلَّىٰ بِرُكْنِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَقَالَ سَ<span class=\"tj tj-madda_normal\">ـٰ</span>حِرٌ أَوْ مَ<span>جْ</span>ن<span class=\"tj tj-madda_permissible\">ُو</span>نٌ <span class=\"tj tj-end\" hidden>٣٩</span>"},{"id":40,"tajweed":"فَأَخَذْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ وَجُنُودَهُ<span class=\"tj tj-madda_normal\">ۥ</span> فَنَبَذْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْيَ<span class=\"tj tj-ghunnah\">مّ</span>ِ وَهُوَ مُل<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رِّيحَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَق<span class=\"tj tj-madda_permissible\">ِي</span>مَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"مَا تَذَرُ مِ<span class=\"tj tj-ikhafa\">ن ش</span>َىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّم<span class=\"tj tj-madda_permissible\">ِي</span>مِ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُو<span>اْ</span> حَتَّىٰ ح<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"فَعَتَوْ<span>اْ</span> عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>عِقَةُ وَهُمْ يَ<span class=\"tj tj-ikhafa\">نظ</span>ُر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"فَمَا <span class=\"tj tj-ham_wasl\">ٱ</span>سْتَطَ<span class=\"tj tj-madda_normal\">ـٰ</span>عُو<span>اْ</span> مِ<span class=\"tj tj-ikhafa\">ن ق</span>ِيَا<span class=\"tj tj-idgham_ghunnah\">مٍ و</span>َمَا كَانُو<span>اْ</span> مُ<span class=\"tj tj-ikhafa\">نت</span>َصِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"وَقَوْمَ نُو<span class=\"tj tj-idgham_ghunnah\">حٍ م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span>بْ</span>لُ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ كَانُو<span>اْ</span> قَوْ<span class=\"tj tj-ikhafa\">مًا ف</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ بَنَيْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هَا بِأَيْ<span>يْ</span><span class=\"tj tj-idgham_ghunnah\">دٍ و</span>َإِ<span class=\"tj tj-ghunnah\">نّ</span>َا لَمُوسِع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ فَرَشْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هَا فَنِعْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>هِد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"وَمِ<span class=\"tj tj-ikhafa\">ن ك</span>ُلِّ شَىْءٍ خَلَ<span>قْ</span>نَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٩</span>"},{"id":50,"tajweed":"فَفِرّ<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span>اْ</span> إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْهُ نَذِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٥٠</span>"},{"id":51,"tajweed":"وَلَا تَ<span>جْ</span>عَلُو<span>اْ</span> مَعَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هًا ءَاخَرَ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْهُ نَذِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٥١</span>"},{"id":52,"tajweed":"كَذ<span class=\"tj tj-madda_normal\">َٲ</span>لِكَ م<span class=\"tj tj-madda_obligatory\">َآ</span> أَتَى <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span>بْ</span>لِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّسُولٍ إِلَّا قَالُو<span>اْ</span> سَاحِرٌ أَوْ مَ<span>جْ</span>ن<span class=\"tj tj-madda_permissible\">ُو</span>نٌ <span class=\"tj tj-end\" hidden>٥٢</span>"},{"id":53,"tajweed":"أَتَوَاصَوْ<span>اْ</span> بِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۚ بَلْ هُمْ قَوْ<span class=\"tj tj-ikhafa\">مٌ ط</span>َاغ<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٣</span>"},{"id":54,"tajweed":"فَتَوَلَّ عَنْهُمْ فَم<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">نت</span>َ بِمَل<span class=\"tj tj-madda_permissible\">ُو</span>مٍ <span class=\"tj tj-end\" hidden>٥٤</span>"},{"id":55,"tajweed":"وَذَكِّرْ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذِّكْرَىٰ تَ<span class=\"tj tj-ikhafa\">نف</span>َعُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُؤْمِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٥</span>"},{"id":56,"tajweed":"وَمَا خَلَ<span>قْ</span>تُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِ<span class=\"tj tj-ghunnah\">نّ</span>َ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ إِلَّا لِيَعْبُد<span class=\"tj tj-madda_permissible\">ُو</span>نِ <span class=\"tj tj-end\" hidden>٥٦</span>"},{"id":57,"tajweed":"م<span class=\"tj tj-madda_obligatory\">َآ</span> أُرِيدُ مِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>ِّزْ<span class=\"tj tj-idgham_ghunnah\">قٍ و</span>َم<span class=\"tj tj-madda_obligatory\">َآ</span> أُرِيدُ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُ<span>طْ</span>عِم<span class=\"tj tj-madda_permissible\">ُو</span>نِ <span class=\"tj tj-end\" hidden>٥٧</span>"},{"id":58,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّزَّاقُ ذُو <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُوَّةِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَت<span class=\"tj tj-madda_permissible\">ِي</span>نُ <span class=\"tj tj-end\" hidden>٥٨</span>"},{"id":59,"tajweed":"فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ لِلَّذِينَ ظَلَمُو<span>اْ</span> ذَنُو<span class=\"tj tj-idgham_ghunnah\">بًا م</span>ِّثْلَ ذَنُوبِ أَصْحَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِهِمْ فَلَا يَسْتَعْجِل<span class=\"tj tj-madda_permissible\">ُو</span>نِ <span class=\"tj tj-end\" hidden>٥٩</span>"},{"id":60,"tajweed":"فَوَيْ<span class=\"tj tj-idgham_wo_ghunnah\">لٌ ل</span>ِّلَّذِينَ كَفَرُو<span>اْ</span> م<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َوْمِهِمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى يُوعَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٦٠</span>"}],"source":"quran.com-uthmani-tajweed","version":1}