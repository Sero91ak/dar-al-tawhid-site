pan class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"مَا لَكُمْ كَيْفَ تَحْكُم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,"tajweed":"أَمْ لَكُمْ كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">بٌ ف</span>ِيهِ تَ<span class=\"tj tj-qlqalah\">دْ</span>رُس<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٧</span>"},{"id":38,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ لَكُمْ فِيهِ لَمَا تَخَيَّر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٨</span>"},{"id":39,"tajweed":"أَمْ لَكُمْ أَيْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نٌ عَلَيْنَا بَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِغَةٌ إِلَىٰ يَوْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ‌ۙ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ لَكُمْ لَمَا تَحْكُم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٩</span>"},{"id":40,"tajweed":"سَلْهُمْ أَيُّه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ زَع<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"أَمْ لَهُمْ شُرَك<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ فَلْيَأْتُو<span class=\"tj tj-silent\">اْ</span> بِشُرَك<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِهِمْ إِ<span class=\"tj tj-ikhafa\">ن ك</span>َانُو<span class=\"tj tj-silent\">اْ</span> صَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"يَوْمَ يُكْشَفُ عَ<span class=\"tj tj-ikhafa\">ن س</span>َا<span class=\"tj tj-idgham_ghunnah\">قٍ و</span>َيُ<span class=\"tj tj-qlqalah\">دْ</span>عَوْنَ إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سُّجُودِ فَلَا يَسْتَطِيع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"خَ<span class=\"tj tj-madda_normal\">ـٰ</span>شِعَةً أَ<span class=\"tj tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span>رُهُمْ تَرْهَقُهُمْ ذِلَّ<span class=\"tj tj-idgham_ghunnah\">ةٌ‌ۖ و</span>َقَ<span class=\"tj tj-qlqalah\">دْ</span> كَانُو<span class=\"tj tj-silent\">اْ</span> يُ<span class=\"tj tj-qlqalah\">دْ</span>عَوْنَ إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سُّجُودِ وَهُمْ سَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"فَذَرْنِى وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُكَذِّبُ بِهَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَدِيثِ‌ۖ سَنَسْتَ<span class=\"tj tj-qlqalah\">دْ</span>رِجُه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْ حَيْثُ لَا يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"وَأُمْلِى لَهُمْ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ كَيْدِى مَت<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"أَمْ تَسْــَٔلُهُمْ أَ<span class=\"tj tj-qlqalah\">جْ</span><span class=\"tj tj-ikhafa\">رًا ف</span>َه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّغْرَ<span class=\"tj tj-idgham_ghunnah\">مٍ م</span>ُّثْقَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"أَمْ عِ<span class=\"tj tj-ikhafa\">ند</span>َهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَيْبُ فَهُمْ يَكْتُب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُ<span class=\"tj tj-ikhafa\">ن ك</span>َصَاحِبِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظ<span class=\"tj tj-madda_permissible\">ُو</span>مٌ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"لَّوْل<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">ن ت</span>َد<span class=\"tj tj-madda_normal\">َٰ</span>رَكَهُ<span class=\"tj tj-madda_normal\">ۥ</span> نِعْمَ<span class=\"tj tj-idgham_ghunnah\">ةٌ م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّبِّه<span class=\"tj tj-madda_normal\">ِۦ</span> لَنُبِذَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْعَر<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ وَهُوَ مَذْم<span class=\"tj tj-madda_permissible\">ُو</span>مٌ <span class=\"tj tj-end\" hidden>٤٩</span>"},{"id":50,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">جْ</span>تَبَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ رَبُّهُ<span class=\"tj tj-madda_normal\">ۥ</span> فَجَعَلَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِح<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٠</span>"},{"id":51,"tajweed":"وَإ<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َكَادُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-silent\">اْ</span> لَيُزْلِقُونَكَ بِأَ<span class=\"tj tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِهِمْ لَ<span class=\"tj tj-ghunnah\">مّ</span>َا سَمِعُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذِّكْرَ وَيَقُولُونَ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَمَ<span class=\"tj tj-qlqalah\">جْ</span>ن<span class=\"tj tj-madda_permissible\">ُو</span>نٌ <span class=\"tj tj-end\" hidden>٥١</span>"},{"id":52,"tajweed":"وَمَا هُوَ إِلَّا ذِكْ<span class=\"tj tj-idgham_wo_ghunnah\">رٌ ل</span>ِّلْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٢</span>"}]}