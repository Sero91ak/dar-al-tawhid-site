tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ghunnah\">نّ</span>َمَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَيَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا لَعِ<span class=\"tj tj-idgham_ghunnah\">بٌ و</span>َلَهْ<span class=\"tj tj-idgham_ghunnah\">وٌ و</span>َزِينَ<span class=\"tj tj-idgham_ghunnah\">ةٌ و</span>َتَفَاخُ<span class=\"tj tj-iqlab\">رُۢ ب</span>َيْنَكُمْ وَتَكَاثُ<span class=\"tj tj-ikhafa\">رٌ ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَمْو<span class=\"tj tj-madda_normal\">َٰ</span>لِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَوْلَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِ‌ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكُفَّارَ نَبَاتُهُ<span class=\"tj tj-madda_normal\">ۥ</span> ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يَهِيجُ فَتَرَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُ مُصْفَر<span class=\"tj tj-ikhafa\">ًّا ث</span>ُ<span class=\"tj tj-ghunnah\">مّ</span>َ يَكُونُ حُطَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">مًا‌ۖ و</span>َفِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَخِرَةِ عَذَا<span class=\"tj tj-ikhafa\">بٌ ش</span>َدِي<span class=\"tj tj-idgham_ghunnah\">دٌ و</span>َمَغْفِرَ<span class=\"tj tj-idgham_ghunnah\">ةٌ م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَرِضْو<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">نٌ‌ۚ و</span>َمَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَيَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْي<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَّا مَتَ<span class=\"tj tj-madda_normal\">ـٰ</span>عُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغُر<span class=\"tj tj-madda_permissible\">ُو</span>رِ <span class=\"tj tj-end\" hidden>٢٠</span>"},{"id":21,"tajweed":"سَابِق<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِلَىٰ مَغْفِرَ<span class=\"tj tj-idgham_ghunnah\">ةٍ م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّبِّكُمْ وَجَ<span class=\"tj tj-ghunnah\">نّ</span>َةٍ عَرْضُهَا كَعَرْضِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَرُسُلِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۚ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ فَضْلُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ يُؤْتِيهِ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۚ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ ذُو <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَضْلِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَظ<span class=\"tj tj-madda_permissible\">ِي</span>مِ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"م<span class=\"tj tj-madda_obligatory\">َآ</span> أَصَابَ م<span class=\"tj tj-idgham_ghunnah\">ِن م</span>ُّصِيبَ<span class=\"tj tj-ikhafa\">ةٍ ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَلَا ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَ<span class=\"tj tj-ikhafa\">نف</span>ُسِكُمْ إِلَّا فِى كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">بٍ م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ن</span>َّ<span class=\"tj tj-qlqalah\">بْ</span>رَأَه<span class=\"tj tj-madda_obligatory\">َآ‌ۚ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ يَس<span class=\"tj tj-madda_permissible\">ِي</span>رٌ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"لِّكَيْلَا تَأْسَوْ<span class=\"tj tj-silent\">اْ</span> عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُو<span class=\"tj tj-silent\">اْ</span> بِم<span class=\"tj tj-madda_obligatory\">َآ</span> ءَاتَ<span class=\"tj tj-madda_normal\">ـٰ</span>كُمْ‌ۗ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ لَا يُحِبُّ كُلَّ مُخْتَا<span class=\"tj tj-ikhafa\">لٍ ف</span>َخ<span class=\"tj tj-madda_permissible\">ُو</span>رٍ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"ٱلَّذِينَ يَ<span class=\"tj tj-qlqalah\">بْ</span>خَلُونَ وَيَأْمُرُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبُخْلِ‌ۗ وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َتَوَلَّ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَنِىُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَم<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">د</span>ُ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"لَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَرْسَلْنَا رُسُلَنَا بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ وَأَ<span class=\"tj tj-ikhafa\">نز</span>َلْنَا مَعَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمِيزَانَ لِيَقُومَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسُ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْقِسْطِ‌ۖ وَأَ<span class=\"tj tj-ikhafa\">نز</span>َلْنَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَدِيدَ فِيهِ بَأْ<span class=\"tj tj-ikhafa\">سٌ ش</span>َدِي<span class=\"tj tj-idgham_ghunnah\">دٌ و</span>َمَنَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِعُ لِل<span class=\"tj tj-ghunnah\">نّ</span>َاسِ وَلِيَعْلَمَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َ<span class=\"tj tj-ikhafa\">نص</span>ُرُهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَرُسُلَهُ<span class=\"tj tj-madda_normal\">ۥ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْغَيْبِ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ قَوِىٌّ عَز<span class=\"tj tj-madda_permissible\">ِي</span>زٌ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَرْسَلْنَا نُو<span class=\"tj tj-idgham_ghunnah\">حًا و</span>َإِ<span class=\"tj tj-qlqalah\">بْ</span>ر<span class=\"tj tj-madda_normal\">َٰ</span>هِيمَ وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>ُبُوَّةَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ‌ۖ فَمِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّهْتَ<span class=\"tj tj-idgham_ghunnah\">دٍ‌ۖ و</span>َكَثِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ِّنْهُمْ فَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٦</span>"},{"id":27,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ قَفَّيْنَا عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> ءَاثَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِه<span class=\"tj tj-ikhafa_shafawi\">ِم ب</span>ِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">بْ</span>نِ مَرْيَمَ وَءَاتَيْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نج</span>ِيلَ وَجَعَلْنَا فِى قُلُوبِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّبَعُوهُ رَأْفَ<span class=\"tj tj-idgham_ghunnah\">ةً و</span>َرَحْمَ<span class=\"tj tj-idgham_ghunnah\">ةً و</span>َرَهْبَانِيَّةً <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">بْ</span>تَدَعُوهَا مَا كَتَ<span class=\"tj tj-qlqalah\">بْ</span>نَ<span class=\"tj tj-madda_normal\">ـٰ</span>هَا عَلَيْهِمْ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">بْ</span>تِغ<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ رِضْو<span class=\"tj tj-madda_normal\">َٰ</span>نِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا‌ۖ فَـَٔـاتَيْنَا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> مِنْهُمْ أَ<span class=\"tj tj-qlqalah\">جْ</span>رَهُمْ‌ۖ وَكَثِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ِّنْهُمْ فَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٧</span>"},{"id":28,"tajweed":"يَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>أَيُّهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>تَّقُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَءَامِنُو<span class=\"tj tj-silent\">اْ</span> بِرَسُولِه<span class=\"tj tj-madda_normal\">ِۦ</span> يُؤْتِكُمْ كِفْلَيْنِ م<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّحْمَتِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَيَ<span class=\"tj tj-qlqalah\">جْ</span>عَل لَّكُمْ نُو<span class=\"tj tj-ikhafa\">رًا ت</span>َمْشُونَ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَيَغْفِرْ لَكُمْ‌ۚ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ غَفُو<span class=\"tj tj-idgham_wo_ghunnah\">رٌ ر</span>َّح<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٢٨</span>"},{"id":29,"tajweed":"لِّئَلَّا يَعْلَمَ أَهْلُ <span class=\"tj tj-ham_wasl\">ٱ<