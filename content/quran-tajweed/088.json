{"id":88,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"هَلْ أَتَ<span class=\"tj tj-madda_normal\">ـٰ</span>كَ حَدِيثُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَ<span class=\"tj tj-madda_normal\">ـٰ</span>شِيَةِ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وُجُو<span class=\"tj tj-idgham_ghunnah\">هٌ ي</span>َوْمَئِذٍ خَ<span class=\"tj tj-madda_normal\">ـٰ</span>شِعَةٌ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"عَامِلَ<span class=\"tj tj-idgham_ghunnah\">ةٌ ن</span>َّاصِبَةٌ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"تَصْلَىٰ نَارًا حَامِيَةً <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ<span class=\"tj tj-ikhafa\">ن ض</span>َر<span class=\"tj tj-madda_permissible\">ِي</span>عٍ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"لَّا يُسْمِنُ وَلَا يُغْنِى مِ<span class=\"tj tj-ikhafa\">ن ج</span><span class=\"tj tj-madda_permissible\">ُو</span>عٍ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"وُجُو<span class=\"tj tj-idgham_ghunnah\">هٌ ي</span>َوْمَئِ<span class=\"tj tj-idgham_ghunnah\">ذٍ ن</span>َّاعِمَةٌ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"لِّسَعْيِهَا رَاضِيَةٌ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"فِى جَ<span class=\"tj tj-ghunnah\">نّ</span>َةٍ عَالِيَةٍ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"لَّا تَسْمَعُ فِيهَا لَ<span class=\"tj tj-madda_normal\">ـٰ</span>غِيَةً <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"فِيهَا عَيْ<span class=\"tj tj-ikhafa\">نٌ ج</span>َارِيَةٌ <span class=\"tj tj-end\" hidden>١٢</span>"},{"id":13,"tajweed":"فِيهَا سُرُ<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>َّرْفُوعَةٌ <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"وَأَكْو