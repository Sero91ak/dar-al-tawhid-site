">مّ</span>َ رَزَقَكُمْ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يُمِيتُكُمْ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يُحْيِيكُمْ‌ۖ هَلْ مِ<span class=\"tj tj-ikhafa\">ن ش</span>ُرَك<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َفْعَلُ مِ<span class=\"tj tj-ikhafa\">ن ذ</span><span class=\"tj tj-madda_normal\">َٰ</span>لِك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ش</span><span class=\"tj tj-ikhafa\">َىْءٍ‌ۚ س</span>ُ<span class=\"tj tj-qlqalah\">بْ</span>حَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَتَعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَىٰ عَ<span class=\"tj tj-ghunnah\">مّ</span>َا يُشْرِك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"ظَهَرَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَسَادُ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَرِّ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَحْرِ بِمَا كَسَبَتْ أَيْدِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسِ لِيُذِيقَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َعْضَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى عَمِلُو<span class=\"tj tj-silent\">اْ</span> لَعَلَّهُمْ يَرْجِع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"قُلْ سِيرُو<span class=\"tj tj-silent\">اْ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نظ</span>ُرُو<span class=\"tj tj-silent\">اْ</span> كَيْفَ كَانَ عَ<span class=\"tj tj-madda_normal\">ـٰ</span>قِبَةُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لُ‌ۚ كَانَ أَكْثَرُه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّشْرِك<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"فَأَقِمْ وَ<span class=\"tj tj-qlqalah\">جْ</span>هَكَ لِلدِّينِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَيِّمِ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َأْتِىَ يَوْ<span class=\"tj tj-idgham_wo_ghunnah\">مٌ ل</span>َّا مَرَدَّ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۖ يَوْمَئِ<span class=\"tj tj-idgham_ghunnah\">ذٍ ي</span>َصَّدَّع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"مَ<span class=\"tj tj-ikhafa\">ن ك</span>َفَرَ فَعَلَيْهِ كُفْرُهُ<span class=\"tj tj-madda_normal\">ۥ</span>‌ۖ وَمَنْ عَمِلَ صَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِ<span class=\"tj tj-ikhafa\">حًا ف</span>َلِأَ<span class=\"tj tj-ikhafa\">نف</span>ُسِهِمْ يَمْهَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"لِيَ<span class=\"tj tj-qlqalah\">جْ</span>زِىَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> وَعَمِلُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِحَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ مِ<span class=\"tj tj-ikhafa\">ن ف</span>َضْلِه<span class=\"tj tj-madda_obligatory\">ِۦٓ‌ۚ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَا يُحِبُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"وَمِنْ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُرْسِلَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رِّيَاحَ مُبَشِّر<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">تٍ و</span>َلِيُذِيقَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّحْمَتِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَلِتَ<span class=\"tj tj-qlqalah\">جْ</span>رِىَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفُلْكُ بِأَمْرِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَلِتَ<span class=\"tj tj-qlqalah\">بْ</span>تَغُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن ف</span>َضْلِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَلَعَلَّكُمْ تَشْكُر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَرْسَلْنَا مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِكَ رُسُلاً إِلَىٰ قَوْمِهِمْ فَج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُوه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نت</span>َقَمْنَا مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ أَ<span class=\"tj tj-qlqalah\">جْ</span>رَمُو<span class=\"tj tj-silent\">اْ‌ۖ</span> وَكَانَ حَقًّا عَلَيْنَا نَصْرُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُؤْمِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"ٱللَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى يُرْسِلُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رِّيَ<span class=\"tj tj-madda_normal\">ـٰ</span>حَ فَتُثِيرُ سَحَا<span class=\"tj tj-ikhafa\">بًا ف</span>َيَ<span class=\"tj tj-qlqalah\">بْ</span>سُطُهُ<span class=\"tj tj-madda_normal\">ۥ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ كَيْفَ يَش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ وَيَ<span class=\"tj tj-qlqalah\">جْ</span>عَلُهُ<span class=\"tj tj-madda_normal\">ۥ</span> كِسَ<span class=\"tj tj-ikhafa\">فًا ف</span>َتَرَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْوَ<span class=\"tj tj-qlqalah\">دْ</span>قَ يَخْرُجُ مِنْ خِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۖ فَإِذ<span class=\"tj tj-madda_obligatory\">َآ</span> أَصَابَ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ مِنْ عِبَادِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِذَا هُمْ يَسْتَ<span class=\"tj tj-qlqalah\">بْ</span>شِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"وَإِ<span class=\"tj tj-ikhafa\">ن ك</span>َانُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُنَزَّلَ عَلَيْه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِه<span class=\"tj tj-madda_normal\">ِۦ</span> لَمُ<span class=\"tj tj-qlqalah\">بْ</span>لِس<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٩</span>"},{"id":50,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نظ</span>ُرْ إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> ءَاثَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِ رَحْمَتِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ كَيْفَ يُحْىِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ بَعْدَ مَوْتِه<span class=\"tj tj-madda_obligatory\">َآ‌ۚ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ لَمُحْىِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَوْتَىٰ‌ۖ وَهُوَ عَلَىٰ كُلِّ ش<span class=\"tj tj-ikhafa\">َىْءٍ ق</span>َد<span class=\"tj tj-madda_permissible\">ِي</span>رٌ <span class=\"tj tj-end\" hidden>٥٠</span>"},{"id":51,"tajweed":"وَلَئِنْ أَرْسَلْنَا رِي<span class=\"tj tj-ikhafa\">حًا ف</span>َرَأَوْهُ مُصْفَر<span class=\"tj tj-idgham_wo_ghunnah\">ًّا ل</span>َّظَلُّو<span class=\"tj tj-silent\">اْ</span> م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِه<span class=\"tj tj-madda_normal\">ِۦ</span> يَكْفُر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥١</span>"},{"id":52,"tajweed":"فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ لَا تُسْمِعُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَوْتَىٰ وَلَا تُسْمِعُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صُّ<span class=\"tj tj-ghunnah\">مّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّع<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ إِذَا وَلَّوْ<span class=\"tj tj-silent\">اْ</span> مُ<span class=\"tj tj-qlqalah\">دْ</span>بِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٢</span>"},{"id":53,"tajweed":"وَم<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">نت</span>َ بِهَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعُمْىِ عَ<span class=\"tj tj-ikhafa\">ن ض</span>َلَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَتِهِمْ‌ۖ إِ<span class=\"tj tj-ikhafa\">ن ت</span>ُسْمِعُ إِلَّا م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُؤْمِنُ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِنَا فَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّسْلِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٣</span>"},{"id":54,"tajweed":"۞ ٱللَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى خَلَقَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ض</span>َعْ<span class=\"tj tj-ikhafa\">فٍ ث</span>ُ<span class=\"tj tj-ghunnah\">مّ</span>َ جَعَلَ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ ضَعْ<span class=\"tj tj-ikhafa\">فٍ ق</span>ُوَّ<span class=\"tj tj-ikhafa\">ةً ث</span>ُ<span class=\"tj tj-ghunnah\">مّ</span>َ جَعَلَ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ قُوَّ<span class=\"tj tj-ikhafa\">ةٍ ض</span>َعْ<span class=\"tj tj-idgham_ghunnah\">فًا و</span>َشَيْبَ<span class=\"tj tj-idgham_ghunnah\">ةً‌ۚ ي</span>َخْلُقُ مَا يَش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۖ وَهُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَلِيمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَد<span class=\"tj tj-madda_permissible\">ِي</span>رُ <span class=\"tj tj-end\" hidden>٥٤</span>"},{"id":55,"tajweed":"وَيَوْمَ تَقُومُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةُ يُ<span class=\"tj tj-qlqalah\">قْ</span>سِمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-qlqalah\">جْ</span>رِمُونَ مَا لَبِثُو<span class=\"tj tj-silent\">اْ</span> غَيْرَ سَاعَ<span class=\"tj tj-ikhafa\">ةٍ‌ۚ ك</span>َذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ كَانُو<span class=\"tj tj-silent\">اْ</span> يُؤْفَك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٥</span>"},{"id":56,"tajweed":"وَقَالَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ أُوتُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْعِلْمَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْإِيمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ لَقَ<span class=\"tj tj-qlqalah\">دْ</span> لَبِثْتُمْ فِى كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ إِلَىٰ يَوْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَعْثِ‌ۖ فَهَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا يَوْمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَعْثِ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ لَا تَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٦</span>"},{"id":57,"tajweed":"فَيَوْمَئِ<span class=\"tj tj-idgham_wo_ghunnah\">ذٍ ل</span>َّا يَ<span class=\"tj tj-ikhafa\">نف</span>َعُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ظَلَمُو<span class=\"tj tj-silent\">اْ</span> مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٧</span>"},{"id":58,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> ضَرَ<span class=\"tj tj-qlqalah\">بْ</span>نَا لِل<span class=\"tj tj-ghunnah\">نّ</span>َاسِ فِى هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرْءَانِ مِ<span class=\"tj tj-ikhafa\">ن ك</span>ُلِّ مَثَ<span class=\"tj tj-idgham_ghunnah\">لٍ‌ۚ و</span>َلَئِ<span class=\"tj tj-ikhafa\">ن ج</span>ِئْتَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِـَٔـايَ<span class=\"tj tj-idgham_wo_ghunnah\">ةٍ ل</span>َّيَقُولَ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَر<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِنْ أَ<span class=\"tj tj-ikhafa\">نت</span>ُمْ إِلَّا مُ<span class=\"tj tj-qlqalah\">بْ</span>طِل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٨</span>"},{"id":59,"tajweed":"كَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ يَ<span class=\"tj tj-qlqalah\">طْ</span>بَعُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ عَلَىٰ قُلُوبِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ لَا يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٩</span>"},{"id":60,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْبِرْ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ وَعْدَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ حَ<span class=\"tj tj-idgham_ghunnah\">قٌّ‌ۖ و</span>َلَا يَسْتَخِفَّ<span class=\"tj tj-ghunnah\">نّ</span>َكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ لَا يُوقِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٦٠</span>"}]}