=\"tj tj-idgham_wo_ghunnah\">تٍ ل</span>ِّقَوْ<span class=\"tj tj-idgham_ghunnah\">مٍ ي</span>ُؤْمِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"وَقَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذْت<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ أَوْثَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">نًا م</span>َّوَدَّةَ بَيْنِكُمْ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَيَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا‌ۖ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ يَكْفُرُ بَعْضُك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِبَعْ<span class=\"tj tj-idgham_ghunnah\">ضٍ و</span>َيَلْعَنُ بَعْضُك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َعْ<span class=\"tj tj-idgham_ghunnah\">ضًا و</span>َمَأْوَ<span class=\"tj tj-madda_normal\">ىٰ</span>كُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َارُ وَمَا لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّ<span class=\"tj tj-madda_normal\">ـٰ</span>صِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"۞ فَـَٔـامَنَ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> لُو<span class=\"tj tj-idgham_ghunnah\">طٌ‌ۘ و</span>َقَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى مُهَاجِرٌ إِلَىٰ رَبّ<span class=\"tj tj-madda_obligatory\">ِىٓ‌ۖ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَزِيزُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَك<span class=\"tj tj-madda_permissible\">ِي</span>مُ <span class=\"tj tj-end\" hidden>٢٦</span>"},{"id":27,"tajweed":"وَوَهَ<span class=\"tj tj-qlqalah\">بْ</span>نَا لَهُ<span class=\"tj tj-madda_obligatory\">ۥٓ</span> إِسْحَ<span class=\"tj tj-madda_normal\">ـٰ</span>قَ وَيَعْقُوبَ وَجَعَلْنَا فِى ذُرِّيَّتِهِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>ُبُوَّةَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ وَءَاتَيْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ أَ<span class=\"tj tj-qlqalah\">جْ</span>رَهُ<span class=\"tj tj-madda_normal\">ۥ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا‌ۖ وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَخِرَةِ لَمِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِح<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٧</span>"},{"id":28,"tajweed":"وَلُوطًا إِذْ قَالَ لِقَوْمِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ لَتَأْتُونَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَ<span class=\"tj tj-madda_normal\">ـٰ</span>حِشَةَ مَا سَبَقَك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِهَا مِنْ أَحَ<span class=\"tj tj-idgham_ghunnah\">دٍ م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٨</span>"},{"id":29,"tajweed":"أَئِ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ لَتَأْتُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رِّجَالَ وَتَ<span class=\"tj tj-qlqalah\">قْ</span>طَعُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّبِيلَ وَتَأْتُونَ فِى نَادِيكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-ikhafa\">نك</span>َرَ‌ۖ فَمَا كَانَ جَوَابَ قَوْمِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِلّ<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">ن ق</span>َالُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>ئْتِنَا بِعَذَابِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ إِ<span class=\"tj tj-ikhafa\">ن ك</span>ُ<span class=\"tj tj-ikhafa\">نت</span>َ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>دِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٩</span>"},{"id":30,"tajweed":"قَالَ رَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نص</span>ُرْنِى عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُفْسِد<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٠</span>"},{"id":31,"tajweed":"وَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَتْ رُسُلُن<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-qlqalah\">بْ</span>ر<span class=\"tj tj-madda_normal\">َٰ</span>هِيمَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبُشْرَىٰ قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َا مُهْلِك<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَهْلِ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذِهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَرْيَةِ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَهْلَهَا كَانُو<span class=\"tj tj-silent\">اْ</span> ظَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"قَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ فِيهَا لُو<span class=\"tj tj-ikhafa\">طًا‌ۚ ق</span>َالُو<span class=\"tj tj-silent\">اْ</span> نَحْنُ أَعْلَمُ بِمَ<span class=\"tj tj-ikhafa\">ن ف</span>ِيهَا‌ۖ لَنُنَجِّيَ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَأَهْلَهُ<span class=\"tj tj-madda_obligatory\">ۥٓ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>مْرَأَتَهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَتْ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"وَلَ<span class=\"tj tj-ghunnah\">مّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">ن ج</span><span class=\"tj tj-madda_obligatory\">َا</span>ٓءَتْ رُسُلُنَا لُو<span class=\"tj tj-ikhafa\">طًا س</span><span class=\"tj tj-madda_obligatory\">ِى</span>ٓءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْ<span class=\"tj tj-idgham_ghunnah\">عًا و</span>َقَالُو<span class=\"tj tj-silent\">اْ</span> لَا تَخَفْ وَلَا تَحْزَنْ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َا مُنَجُّوكَ وَأَهْلَكَ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>مْرَأَتَكَ كَانَتْ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َا مُ<span class=\"tj tj-ikhafa\">نز</span>ِلُونَ عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَهْلِ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذِهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَرْيَةِ رِ<span class=\"tj tj-qlqalah\">جْ</span><span class=\"tj tj-idgham_ghunnah\">زًا م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ بِمَا كَانُو<span class=\"tj tj-silent\">اْ</span> يَفْسُق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"وَلَقَ<span class=\"tj tj-idgham_mutajanisayn\">د</span> تَّرَكْنَا مِنْه<span class=\"tj tj-madda_obligatory\">َآ</span> ءَايَ<span class=\"tj tj-iqlab\">ةَۢ ب</span>َيِّنَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>ِّقَوْ<span class=\"tj tj-idgham_ghunnah\">مٍ ي</span>َعْقِل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"وَإِلَىٰ مَ<span class=\"tj tj-qlqalah\">دْ</span>يَنَ أَخَاهُمْ شُعَيْ<span class=\"tj tj-ikhafa\">بًا ف</span>َقَالَ يَ<span class=\"tj tj-madda_normal\">ـٰ</span>قَوْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>عْبُدُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>رْجُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْيَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَخِرَ وَلَا تَعْثَوْ<span class=\"tj tj-silent\">اْ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ مُفْسِد<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,"tajweed":"فَكَذَّبُوهُ فَأَخَذَتْهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّ<span class=\"tj tj-qlqalah\">جْ</span>فَةُ فَأَصْبَحُو<span class=\"tj tj-silent\">اْ</span> فِى دَارِهِمْ جَ<span class=\"tj tj-madda_normal\">ـٰ</span>ثِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٧</span>"},{"id":38,"tajweed":"وَعَا<span class=\"tj tj-idgham_ghunnah\">دًا و</span>َثَمُودَ<span class=\"tj tj-silent\">اْ</span> وَقَ<span class=\"tj tj-idgham_mutajanisayn\">د</span> تَّبَيَّنَ لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّسَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِنِهِمْ‌ۖ وَزَيَّنَ لَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّيْطَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ أَعْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَهُمْ فَصَدَّهُمْ عَنِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّبِيلِ وَكَانُو<span class=\"tj tj-silent\">اْ</span> مُسْتَ<span class=\"tj tj-qlqalah\">بْ</span>صِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٨</span>"},{"id":39,"tajweed":"وَقَ<span class=\"tj tj-madda_normal\">ـٰ</span>رُونَ وَفِرْعَوْنَ وَهَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ‌ۖ وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّوسَىٰ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ فَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَكْبَرُو<span class=\"tj tj-silent\">اْ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَمَا كَانُو<span class=\"tj tj-silent\">اْ</span> سَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٩</span>"},{"id":40,"tajweed":"فَكُلاًّ أَخَذْنَا بِذَ<span class=\"tj tj-iqlab\">نۢب</span>ِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۖ فَمِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّنْ أَرْسَلْنَا عَلَيْهِ حَاصِ<span class=\"tj tj-idgham_ghunnah\">بًا و</span>َمِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّنْ أَخَذَتْهُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّيْحَةُ وَمِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّنْ خَسَفْنَا بِهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ وَمِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّنْ أَغْرَ<span class=\"tj tj-qlqalah\">قْ</span>نَا‌ۚ وَمَا كَانَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ لِيَظْلِمَهُمْ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ikhafa\">ن ك</span>َان<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ikhafa\">نف</span>ُسَهُمْ يَظْلِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"مَثَلُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ أَوْلِي<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ كَمَثَلِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-ikhafa\">نك</span>َبُوتِ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَتْ بَيْ<span class=\"tj tj-idgham_ghunnah\">تًا‌ۖ و</span>َإِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَوْهَنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْبُيُوتِ لَبَيْتُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-ikhafa\">نك</span>َبُوتِ‌ۖ لَوْ كَانُو<span class=\"tj tj-silent\">اْ</span> يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ يَعْلَمُ مَا يَ<span class=\"tj tj-qlqalah\">دْ</span>عُونَ مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِه<span class=\"tj tj-madda_normal\">ِۦ</span> مِ<span class=\"tj tj-ikhafa\">ن ش</span><span class=\"tj tj-idgham_ghunnah\">َىْءٍ‌ۚ و</span>َهُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَزِيزُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَك<span class=\"tj tj-madda_permissible\">ِي</span>مُ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"وَتِلْكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَمْثَ<span class=\"tj tj-madda_normal\">ـٰ</span>لُ نَضْرِبُهَا لِل<span class=\"tj tj-ghunnah\">نّ</span>َاسِ‌ۖ وَمَا يَعْقِلُه<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"خَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ فِى ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ لَأَيَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>ِّلْمُؤْمِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"ٱتْلُ م<span class=\"tj tj-madda_obligatory\">َآ</span> أُوحِىَ إِلَيْكَ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ وَأَقِمِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّلَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةَ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّلَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةَ تَنْهَىٰ عَنِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَحْش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-ikhafa\">نك</span>َرِ‌ۗ وَلَذِكْرُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ أَكْبَرُ‌ۗ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَعْلَمُ مَا تَصْنَع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"۞ وَلَا تُجَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِل<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَهْلَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ إِلَّا بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّتِى هِىَ أَحْسَنُ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ظَلَمُو<span class=\"tj tj-silent\">اْ</span> مِنْهُمْ‌ۖ وَقُول<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> ءَامَ<span class=\"tj tj-ghunnah\">نّ</span>َا بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذ<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُ<span class=\"tj tj-ikhafa\">نز</span>ِلَ إِلَيْنَا وَأُ<span class=\"tj tj-ikhafa\">نز</span>ِلَ إِلَيْكُمْ وَإِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُنَا وَإِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُكُمْ و<span class=\"tj tj-madda_normal\">َٰ</span>حِ<span class=\"tj tj-idgham_ghunnah\">دٌ و</span>َنَحْنُ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مُسْلِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"وَكَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ أَ<span class=\"tj tj-ikhafa\">نز</span>َلْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَيْكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ‌ۚ فَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَاتَيْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ يُؤْمِنُونَ بِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۖ وَمِنْ هَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ؤُل<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ م<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُؤْمِنُ بِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۚ وَمَا يَ<span class=\"tj tj-qlqalah\">جْ</span>حَدُ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"وَمَا كُ<span class=\"tj tj-ikhafa\">نت</span>َ تَتْلُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِه<span class=\"tj tj-madda_normal\">ِۦ</span> مِ<span class=\"tj tj-ikhafa\">ن ك</span>ِتَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">بٍ و</span>َلَا تَخُطُّهُ<span class=\"tj tj-madda_normal\">ۥ</span> بِيَمِينِكَ‌ۖ إِ<span class=\"tj tj-idgham_wo_ghunnah\">ذًا ل</span>َّ<span class=\"tj tj-ham_wasl\">ٱ</span>رْتَابَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-qlqalah\">بْ</span>طِل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"بَلْ هُوَ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-iqlab\">تُۢ ب</span>َيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">تٌ ف</span>ِى صُدُورِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ أُوتُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْعِلْمَ‌ۚ وَمَا يَ<span class=\"tj tj-qlqalah\">جْ</span>حَدُ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ظَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٩</span>"},{"id":50,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> لَوْل<span class=\"tj tj-madda_obligatory\">َآ</span> أُ<span class=\"tj tj-ikhafa\">نز</span>ِلَ عَلَيْهِ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٌ م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّبِّه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۖ قُلْ إِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَيَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ عِ<span class=\"tj tj-ikhafa\">ند</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َم<span class=\"tj tj-madda_obligatory\">َآ</span> أَنَا۟ نَذِي<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٥٠</span>"},{"id":51,"tajweed":"أَوَلَمْ يَكْفِهِمْ أَ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">نز</span>َلْنَا عَلَيْكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ يُتْلَىٰ عَلَيْهِمْ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ فِى ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ لَرَحْمَ<span class=\"tj tj-idgham_ghunnah\">ةً و</span>َذِكْرَىٰ لِقَوْ<span class=\"tj tj-idgham_ghunnah\">مٍ ي</span>ُؤْمِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥١</span>"},{"id":52,"tajweed":"قُلْ كَفَىٰ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ بَيْنِى وَبَيْنَكُمْ شَهِي<span class=\"tj tj-idgham_ghunnah\">دًا‌ۖ ي</span>َعْلَمُ مَا فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ‌ۗ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَ<span class=\"tj tj-madda_normal\">ـٰ</span>طِلِ وَكَفَرُو<span class=\"tj tj-silent\">اْ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ هُمُ <span class=\"tj tj-ham_