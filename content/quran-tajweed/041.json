 tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span>رُهُمْ وَجُلُودُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِمَا كَانُو<span class=\"tj tj-silent\">اْ</span> يَعْمَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٠</span>"},{"id":21,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> لِجُلُودِهِمْ لِمَ شَهِ<span class=\"tj tj-idgham_mutajanisayn\">د</span>تُّمْ عَلَيْنَا‌ۖ قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ikhafa\">نط</span>َقَنَا <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذ<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَ<span class=\"tj tj-ikhafa\">نط</span>َقَ كُلَّ ش<span class=\"tj tj-idgham_ghunnah\">َىْءٍ و</span>َهُوَ خَلَقَكُمْ أَوَّلَ مَرَّ<span class=\"tj tj-idgham_ghunnah\">ةٍ و</span>َإِلَيْهِ تُرْجَع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"وَمَا كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَسْتَتِرُونَ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span>رُكُمْ وَلَا جُلُودُكُمْ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ikhafa\">ن ظ</span>َنَ<span class=\"tj tj-ikhafa\">نت</span>ُمْ أَ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ لَا يَعْلَمُ كَثِي<span class=\"tj tj-idgham_ghunnah\">رًا م</span>ِّ<span class=\"tj tj-ghunnah\">مّ</span>َا تَعْمَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"وَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكُمْ ظَ<span class=\"tj tj-ghunnah\">نّ</span>ُكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى ظَنَ<span class=\"tj tj-ikhafa\">نت</span><span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِرَبِّكُمْ أَرْدَ<span class=\"tj tj-madda_normal\">ىٰ</span>كُمْ فَأَصْبَحْت<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْخَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"فَإ<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َصْبِرُو<span class=\"tj tj-silent\">اْ</span> فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َارُ مَثْ<span class=\"tj tj-idgham_wo_ghunnah\">وًى ل</span>َّهُمْ‌ۖ وَإ<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َسْتَعْتِبُو<span class=\"tj tj-silent\">اْ</span> فَمَا ه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُعْتَب<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"۞ وَقَيَّضْنَا لَهُمْ قُرَن<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ فَزَيَّنُو<span class=\"tj tj-silent\">اْ</span> لَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْلُ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُمَ<span class=\"tj tj-ikhafa\">مٍ ق</span>َ<span class=\"tj tj-qlqalah\">دْ</span> خَلَتْ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِ<span class=\"tj tj-ghunnah\">نّ</span>ِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>ِ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ كَانُو<span class=\"tj tj-silent\">اْ</span> خَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"وَقَالَ