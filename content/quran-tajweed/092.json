{"id":92,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّيْلِ إِذَا يَغْشَىٰ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َهَارِ إِذَا تَجَلَّىٰ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَمَا خَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذَّكَرَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأُ<span class=\"tj tj-ikhafa\">نث</span>َىٰٓ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ سَعْيَكُمْ لَشَتَّىٰ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"فَأَ<span class=\"tj tj-ghunnah\">مّ</span>َا مَنْ أَعْطَىٰ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّقَىٰ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"وَصَدَّقَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحُسْنَىٰ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"فَسَنُيَسِّرُهُ<span class=\"tj tj-madda_normal\">ۥ</span> لِلْيُسْرَىٰ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"وَأَ<span class=\"tj tj-ghunnah\">مّ</span>َا م<span class=\"tj tj-iqlab\">َنۢ ب</span>َخِلَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَغْنَىٰ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"وَكَذَّبَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحُسْنَىٰ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"فَسَنُيَسِّرُهُ<span class=\"tj tj-madda_normal\">ۥ</span> لِلْعُسْرَىٰ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"وَمَا يُغْنِى عَنْهُ مَالُهُ<span class=\"tj tj-madda_obligatory\">ۥٓ</span> إِذَا تَرَدَّىٰٓ <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ عَلَيْنَا لَلْهُدَىٰ <span class=\"tj tj-end\" hidden>١٢