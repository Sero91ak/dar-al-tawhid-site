\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِحَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ سَو<span class=\"tj tj-madda_obligatory\">َا</span>ٓ<span class=\"tj tj-idgham_ghunnah\">ءً م</span>َّحْيَاهُمْ وَمَمَاتُهُمْ‌ۚ س<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ مَا يَحْكُم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"وَخَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَلِتُ<span class=\"tj tj-qlqalah\">جْ</span>زَىٰ كُلُّ نَفْ<span class=\"tj tj-iqlab\">سِۭ ب</span>ِمَا كَسَبَتْ وَهُمْ لَا يُظْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"أَفَرَءَيْتَ مَنِ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَ إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هَهُ<span class=\"tj tj-madda_normal\">ۥ</span> هَوَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُ وَأَضَلَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ عَلَىٰ عِلْ<span class=\"tj tj-idgham_ghunnah\">مٍ و</span>َخَتَمَ عَلَىٰ سَمْعِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَقَلْبِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَجَعَلَ عَلَىٰ بَصَرِه<span class=\"tj tj-madda_normal\">ِۦ</span> غِشَ<span class=\"tj tj-madda_normal\">ـٰ</span>وَ<span class=\"tj tj-ikhafa\">ةً ف</span>َم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َهْدِيهِ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۚ أَفَلَا تَذَكَّر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> مَا هِىَ إِلَّا حَيَاتُنَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا نَمُوتُ وَنَحْيَا وَمَا يُهْلِكُن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دَّهْرُ‌ۚ وَمَا لَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ مِنْ عِلْمٍ‌ۖ إِنْ هُمْ إِلَّا يَظُ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُنَا بَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٍ م</span>َّا كَانَ حُجَّتَهُمْ إِلّ<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">ن ق</span>َالُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>ئْتُو<span class=\"tj tj-silent\">اْ</span> بِـَٔـاب<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِن<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ikhafa\">ن ك</span>ُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ صَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"قُلِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يُحْيِيكُمْ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يُمِيتُكُمْ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يَ<span class=\"tj tj-qlqalah\">جْ</span>مَعُكُمْ إِلَىٰ يَوْمِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ لَا رَيْبَ فِيهِ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَكْثَرَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسِ لَا