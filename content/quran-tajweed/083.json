{"id":83,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"وَيْ<span class=\"tj tj-idgham_wo_ghunnah\">لٌ ل</span>ِّلْمُطَفِّف<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"ٱلَّذِينَ إِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>كْتَالُو<span class=\"tj tj-silent\">اْ</span> عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسِ يَسْتَوْف<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"أَلَا يَظُ<span class=\"tj tj-ghunnah\">نّ</span>ُ أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ أَ<span class=\"tj tj-ghunnah\">نّ</span>َه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّ<span class=\"tj tj-qlqalah\">بْ</span>عُوث<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"لِيَوْمٍ عَظ<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"يَوْمَ يَقُومُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسُ لِرَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"كَلّ<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َ كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفُجَّارِ لَفِى سِجّ<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٧</span>