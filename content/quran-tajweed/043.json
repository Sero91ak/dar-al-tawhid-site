{"id":43,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"ح<span class=\"tj tj-madda_necessary\">مٓ</span> <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُب<span class=\"tj tj-madda_permissible\">ِي</span>نِ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َا جَعَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ قُرْء<span class=\"tj tj-madda_normal\">َٰ</span>نًا عَرَبِي<span class=\"tj tj-idgham_wo_ghunnah\">ًّا ل</span>َّعَلَّكُمْ تَعْقِل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُ<span class=\"tj tj-ghunnah\">مّ</span>ِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ لَدَيْنَا لَعَلِىٌّ حَك<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"أَفَنَضْرِبُ عَ<span class=\"tj tj-ikhafa\">نك</span>ُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ذِّكْرَ صَفْحًا أَ<span class=\"tj tj-ikhafa\">ن ك</span>ُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ قَوْ<span class=\"tj tj-idgham_ghunnah\">مًا م</span>ُّسْرِف<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"وَكَمْ أَرْسَلْنَا م<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّبِ<span class=\"tj tj-ikhafa\">ىٍّ ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَوَّل<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"وَمَا يَأْتِيه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ّ<