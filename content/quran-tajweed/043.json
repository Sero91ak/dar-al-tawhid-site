an class=\"tj tj-ikhafa\">نش</span>َرْنَا بِه<span class=\"tj tj-madda_normal\">ِۦ</span> بَلْدَ<span class=\"tj tj-idgham_ghunnah\">ةً م</span>َّيْ<span class=\"tj tj-ikhafa\">تًا‌ۚ ك</span>َذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ تُخْرَج<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى خَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَزْو<span class=\"tj tj-madda_normal\">َٰ</span>جَ كُلَّهَا وَجَعَلَ لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفُلْكِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَنْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>مِ مَا تَرْكَب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٢</span>"},{"id":13,"tajweed":"لِتَسْتَوُ<span class=\"tj tj-madda_normal\">ۥ</span>اْ عَلَىٰ ظُهُورِه<span class=\"tj tj-madda_normal\">ِۦ</span> ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ تَذْكُرُو<span class=\"tj tj-silent\">اْ</span> نِعْمَةَ رَبِّكُمْ إِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>سْتَوَيْتُمْ عَلَيْهِ وَتَقُولُو<span class=\"tj tj-silent\">اْ</span> سُ<span class=\"tj tj-qlqalah\">بْ</span>حَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى سَخَّرَ لَنَا هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا وَمَا كُ<span class=\"tj tj-ghunnah\">نّ</span>َا لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مُ<span class=\"tj tj-qlqalah\">قْ</span>رِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٣</span>"},{"id":14,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> إِلَىٰ رَبِّنَا لَمُ<span class=\"tj tj-ikhafa\">نق</span>َلِب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٤</span>"},{"id":15,"tajweed":"وَجَعَلُو<span class=\"tj tj-silent\">اْ</span> لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِنْ عِبَادِه<span class=\"tj tj-madda_normal\">ِۦ</span> جُزْءًا‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ لَكَفُو<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"أَمِ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَ مِ<span class=\"tj tj-ghunnah\">مّ</span>َا يَخْلُقُ بَنَا<span class=\"tj tj-idgham_ghunnah\">تٍ و</span>َأَصْفَ<span class=\"tj tj-madda_normal\">ـٰ</span>ك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"وَإِذَا بُشِّرَ أَحَدُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِمَا ضَرَبَ لِلرَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ مَثَل<span class=\"tj tj-ikhafa\">اً ظ</span>َلَّ وَ<span class=\"tj tj-qlqalah\">جْ</span>هُهُ<span class=\"tj tj-madda_normal\">ۥ</span> مُسْوَد<span class=\"tj tj-idgham_ghunnah\">ًّا و</span>َهُوَ كَظ<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"أَوَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُنَشَّؤُ<span class=\"tj tj-silent\">اْ</span> فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْحِلْيَةِ وَهُوَ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْخِصَامِ غَيْرُ مُب<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"وَجَعَلُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَلَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَةَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ هُمْ عِبَ<span class=\"tj tj-madda_normal\">ـٰ</span>دُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</sp