كَةُ مُ<span class=\"tj tj-qlqalah\">قْ</span>تَرِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٣</span>"},{"id":54,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَخَفَّ قَوْمَهُ<span class=\"tj tj-madda_normal\">ۥ</span> فَأَطَاعُوهُ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ كَانُو<span class=\"tj tj-silent\">اْ</span> قَوْ<span class=\"tj tj-ikhafa\">مًا ف</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٤</span>"},{"id":55,"tajweed":"فَلَ<span class=\"tj tj-ghunnah\">مّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> ءَاسَفُونَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نت</span>َقَمْنَا مِنْهُمْ فَأَغْرَ<span class=\"tj tj-qlqalah\">قْ</span>نَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ أَ<span class=\"tj tj-qlqalah\">جْ</span>مَع<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٥</span>"},{"id":56,"tajweed":"فَجَعَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ سَلَ<span class=\"tj tj-idgham_ghunnah\">فًا و</span>َمَثَل<span class=\"tj tj-idgham_wo_ghunnah\">اً ل</span>ِّلْأَخِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٥٦</span>"},{"id":57,"tajweed":"۞ وَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا ضُرِبَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">بْ</span>نُ مَرْيَمَ مَثَلاً إِذَا قَوْمُكَ مِنْهُ يَصِدّ<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٧</span>"},{"id":58,"tajweed":"وَقَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> ءَأ<span class=\"tj tj-madda_normal\">َٰ</span>لِهَتُنَا خَيْرٌ أَمْ هُوَ‌ۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَل<span class=\"tj tj-iqlab\">اَۢ‌ۚ ب</span>َلْ هُمْ قَوْمٌ خَصِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥٨</span>"},{"id":59,"tajweed":"إِنْ هُوَ إِلَّا عَ<span class=\"tj tj-qlqalah\">بْ</span>دٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ مَثَل<span class=\"tj tj-idgham_wo_ghunnah\">اً ل</span>ِّبَن<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِسْر<span class=\"tj tj-madda_obligatory\">َٰ</span>ٓء<span class=\"tj tj-madda_permissible\">ِي</span>لَ <span class=\"tj tj-end\" hidden>٥٩</span>"},{"id":60,"tajweed":"وَلَوْ نَش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ لَجَعَلْنَا مِ<span class=\"tj tj-ikhafa\">نك</span><span class=\"tj tj-idgham_shafawi\">ُم م</span>َّلَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ<span class=\"tj tj-ikhafa\">ةً ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ يَخْلُف<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٦٠</span>"},{"id":61,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَعِلْ<span class=\"tj tj-idgham_wo_ghunnah\">مٌ ل</span>ِّلسَّاعَةِ فَلَا تَمْتَرُ<span class=\"tj tj-ghunnah\">نّ</span>َ بِهَا وَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّبِعُونِ‌ۚ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا صِر<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">طٌ م</span>ُّسْتَق<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٦١</span>"},{"id":62,"tajweed":"وَلَا يَصُدَّ<span class=\"tj tj-ghunnah\">نّ</span>َكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّيْطَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَكُمْ عَدُ<span class=\"tj tj-idgham_ghunnah\">وٌّ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٦٢</span>"},{"id":63,"tajweed":"وَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ عِيسَىٰ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ قَالَ قَ<span class=\"tj tj-qlqalah\">دْ</span> جِئْتُك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحِكْمَةِ وَلِأُبَيِّنَ لَك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َعْضَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى تَخْتَلِفُونَ فِيهِ‌ۖ فَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّقُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَأَطِيع<span class=\"tj tj-madda_permissible\">ُو</span>نِ <span class=\"tj tj-end\" hidden>٦٣</span>"},{"id":64,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ هُوَ رَبِّى وَرَبُّكُمْ فَ<span class=\"tj tj-ham_wasl\">ٱ</span>عْبُدُوهُ‌ۚ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا صِر<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">طٌ م</span>ُّسْتَق<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٦٤</span>"},{"id":65,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>خْتَلَفَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَحْزَابُ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َيْنِهِمْ‌ۖ فَوَيْ<span class=\"tj tj-idgham_wo_ghunnah\">لٌ ل</span>ِّلَّذِينَ ظَلَمُو<span class=\"tj tj-silent\">اْ</span> مِنْ عَذَابِ يَوْمٍ أَل<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٦٥</span>"},{"id":66,"tajweed":"هَلْ يَ<span class=\"tj tj-ikhafa\">نظ</span>ُرُونَ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةَ أَ<span class=\"tj tj-ikhafa\">ن ت</span>َأْتِيَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َغْتَ<span class=\"tj tj-idgham_ghunnah\">ةً و</span>َهُمْ لَا يَشْعُر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٦٦</span>"},{"id":67,"tajweed":"ٱلْأَخِلّ<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ يَوْمَئِ<span class=\"tj tj-iqlab\">ذِۭ ب</span>َعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُتَّق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٦٧</span>"},{"id":68,"tajweed":"يَ<span class=\"tj tj-madda_normal\">ـٰ</span>عِبَادِ لَا خَوْفٌ عَلَيْكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْيَوْمَ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَحْزَن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٦٨</span>"},{"id":69,"tajweed":"ٱلَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِنَا وَكَانُو<span class=\"tj tj-silent\">اْ</span> مُسْلِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٦٩</span>"},{"id":70,"tajweed":"ٱ<span class=\"tj tj-qlqalah\">دْ</span>خُلُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-ghunnah\">نّ</span>َةَ أَ<span class=\"tj tj-ikhafa\">نت</span>ُمْ وَأَزْو<span class=\"tj tj-madda_normal\">َٰ</span>جُكُمْ تُحْبَر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٠</span>"},{"id":71,"tajweed":"يُطَافُ عَلَيْه<span class=\"tj tj-ikhafa_shafawi\">ِم ب</span>ِصِحَا<span class=\"tj tj-idgham_ghunnah\">فٍ م</span>ِّ<span class=\"tj tj-ikhafa\">ن ذ</span>َهَ<span class=\"tj tj-idgham_ghunnah\">بٍ و</span>َأَكْوَا<span class=\"tj tj-idgham_ghunnah\">بٍ‌ۖ و</span>َفِيهَا مَا تَشْتَهِيهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَ<span class=\"tj tj-ikhafa\">نف</span>ُسُ وَتَلَذُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَعْيُنُ‌ۖ وَأَ<span class=\"tj tj-ikhafa\">نت</span>ُمْ فِيهَا خَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧١</span>"},{"id":72,"tajweed":"وَتِلْكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-ghunnah\">نّ</span>َةُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّت<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُورِثْتُمُوهَا بِمَا كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَعْمَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٢</span>"},{"id":73,"tajweed":"لَكُمْ فِيهَا فَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِهَ<span class=\"tj tj-ikhafa\">ةٌ ك</span>َثِيرَ<span class=\"tj tj-idgham_ghunnah\">ةٌ م</span>ِّنْهَا تَأْكُل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٣</span>"},{"id":74,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-qlqalah\">جْ</span>رِمِينَ فِى عَذَابِ جَهَ<span class=\"tj tj-ghunnah\">نّ</span>َمَ خَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٤</span>"},{"id":75,"tajweed":"لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُ<span class=\"tj tj-qlqalah\">بْ</span>لِس<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٥</span>"},{"id":76,"tajweed":"وَمَا ظَلَمْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ikhafa\">ن ك</span>َانُو<span class=\"tj tj-silent\">اْ</span> هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ظَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٧٦</span>"},{"id":77,"tajweed":"وَنَادَوْ<span class=\"tj tj-silent\">اْ</span> يَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِكُ لِيَ<span class=\"tj tj-qlqalah\">قْ</span>ضِ عَلَيْنَا رَبُّكَ‌ۖ قَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>َك<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّ<span class=\"tj tj-madda_normal\">ـٰ</span>كِث<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٧</span>"},{"id":78,"tajweed":"لَقَ<span class=\"tj tj-qlqalah\">دْ</span> جِئْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>ك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَكْثَرَكُمْ لِلْحَقِّ كَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِه<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٨</span>"},{"id":79,"tajweed":"أَمْ أَ<span class=\"tj tj-qlqalah\">بْ</span>رَم<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَمْ<span class=\"tj tj-ikhafa\">رًا ف</span>َإِ<span class=\"tj tj-ghunnah\">نّ</span>َا مُ<span class=\"tj tj-qlqalah\">بْ</span>رِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧٩</span>"},{"id":80,"tajweed":"أَمْ يَحْسَبُونَ أَ<span class=\"tj tj-ghunnah\">نّ</span>َا لَا نَسْمَعُ سِرَّهُمْ وَنَ<span class=\"tj tj-qlqalah\">جْ</span>وَ<span class=\"tj tj-madda_normal\">ىٰ</span>ه<span class=\"tj tj-ikhafa_shafawi\">ُم‌ۚ ب</span>َلَىٰ وَرُسُلُنَا لَدَيْهِمْ يَكْتُب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٠</span>"},{"id":81,"tajweed":"قُلْ إِ<span class=\"tj tj-ikhafa\">ن ك</span>َانَ لِلرَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ وَلَ<span class=\"tj tj-ikhafa\">دٌ ف</span>َأَنَا۟ أَوَّلُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِد<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٨١</span>"},{"id":82,"tajweed":"سُ<span class=\"tj tj-qlqalah\">بْ</span>حَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ رَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ رَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَرْشِ عَ<span class=\"tj tj-ghunnah\">مّ</span>َا يَصِف<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٢</span>"},{"id":83,"tajweed":"فَذَرْهُمْ يَخُوضُو<span class=\"tj tj-silent\">اْ</span> وَيَلْعَبُو<span class=\"tj tj-silent\">اْ</span> حَتَّىٰ يُلَ<span class=\"tj tj-madda_normal\">ـٰ</span>قُو<span class=\"tj tj-silent\">اْ</span> يَوْمَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى يُوعَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٣</span>"},{"id":84,"tajweed":"وَهُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">هٌ و</span>َفِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">هٌ‌ۚ و</span>َهُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَكِيمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَل<span class=\"tj tj-madda_permissible\">ِي</span>مُ <span class=\"tj tj-end\" hidden>٨٤</span>"},{"id":85,"tajweed":"وَتَبَارَكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مُلْكُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَمَا بَيْنَهُمَا وَعِ<span class=\"tj tj-ikhafa\">ند</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> عِلْمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةِ وَإِلَيْهِ تُرْجَع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٥</span>"},{"id":86,"tajweed":"وَلَا يَمْلِكُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ يَ<span class=\"tj tj-qlqalah\">دْ</span>عُونَ مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِهِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّفَ<span class=\"tj tj-madda_normal\">ـٰ</span>عَةَ إِلَّا مَ<span class=\"tj tj-ikhafa\">ن ش</span>َهِدَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَهُمْ يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٦</span>"},{"id":87,"tajweed":"وَلَئِ<span class=\"tj tj-ikhafa\">ن س</span>َأَلْتَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّنْ خَلَقَهُمْ لَيَقُولُ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ‌ۖ فَأَ<span class=\"tj tj-ghunnah\">نّ</span>َىٰ يُؤْفَك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٧</span>"},{"id":88,"tajweed":"وَقِيلِه<span class=\"tj tj-madda_normal\">ِۦ</span> يَ<span class=\"tj tj-madda_normal\">ـٰ</span>رَبِّ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ هَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ؤُل<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ قَوْ<span class=\"tj tj-idgham_wo_ghunnah\">مٌ ل</span>َّا يُؤْمِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٨</span>"},{"id":89,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْفَحْ عَنْهُمْ وَقُلْ سَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">مٌ‌ۚ ف</span>َسَوْفَ يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨٩</span>"}]}