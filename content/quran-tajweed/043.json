">نّ</span>َا عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> ءَاثَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ُّهْتَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"وَكَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ م<span class=\"tj tj-madda_obligatory\">َآ</span> أَرْسَلْنَا مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِكَ فِى قَرْيَ<span class=\"tj tj-idgham_ghunnah\">ةٍ م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّذِيرٍ إِلَّا قَالَ مُتْرَفُوه<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َا وَجَ<span class=\"tj tj-qlqalah\">دْ</span>ن<span class=\"tj tj-madda_obligatory\">َآ</span> ءَاب<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَنَا عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أُ<span class=\"tj tj-ghunnah\">مّ</span>َ<span class=\"tj tj-idgham_ghunnah\">ةٍ و</span>َإِ<span class=\"tj tj-ghunnah\">نّ</span>َا عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> ءَاثَ<span class=\"tj tj-madda_normal\">ـٰ</span>رِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ُّ<span class=\"tj tj-qlqalah\">قْ</span>تَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"۞ قَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَ أَوَلَوْ جِئْتُك<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِأَهْدَىٰ مِ<span class=\"tj tj-ghunnah\">مّ</span>َا وَجَ<span class=\"tj tj-idgham_mutajanisayn\">د</span>تُّمْ عَلَيْهِ ءَاب<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَكُمْ‌ۖ قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َا بِم<span class=\"tj tj-madda_obligatory\">َآ</span> أُرْسِلْت<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِه<span class=\"tj tj-madda_normal\">ِۦ</span> كَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نت</span>َقَمْنَا مِنْهُمْ‌ۖ فَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نظ</span>ُرْ كَيْفَ كَانَ عَ<span class=\"tj tj-madda_normal\">ـٰ</span>قِبَةُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُكَذِّب<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"وَإِذْ قَالَ إِ<span class=\"tj tj-qlqalah\">بْ</span>ر<span class=\"tj tj-madda_normal\">َٰ</span>هِيمُ لِأَبِيهِ وَقَوْمِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َنِى بَر<span class=\"tj tj-madda_obligatory\">َا</span>ٓ<span class=\"tj tj-idgham_ghunnah\">ءٌ م</span>ِّ<span class=\"tj tj-ghunnah\">مّ</span>َا تَعْبُد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٦</span>"},{"id":27,"tajweed":"إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى فَطَرَنِى فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> سَيَهْد<span class=\"tj tj-madda_permissible\">ِي</span>نِ <span class=\"tj tj-end\" hidden>٢٧</span>"},{"id":28,"tajweed":"وَجَعَلَهَا كَلِمَ<span class=\"tj tj-iqlab\">ةَۢ ب</span>َاقِيَ<span class=\"tj tj-ikhafa\">ةً ف</span>ِى عَقِبِه<span class=\"tj tj-madda_normal\">ِۦ</span> لَعَلَّهُمْ يَرْجِع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٨</span>"},{"id":29,"tajweed":"بَلْ مَتَّعْتُ هَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ؤُل<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ وَءَاب<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَهُمْ حَتَّىٰ ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقُّ وَرَسُو<span class=\"tj tj-idgham_ghunnah\">لٌ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٢٩</span>"},{"id":30,"tajweed":"وَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقُّ قَالُو<span class=\"tj tj-silent\">اْ</span> هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا سِحْ<span class=\"tj tj-idgham_ghunnah\">رٌ و</span>َإِ<span class=\"tj tj-ghunnah\">نّ</span>َا بِه<span class=\"tj tj-madda_normal\">ِۦ</span> كَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٠</span>"},{"id":31,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> لَوْلَا نُزِّلَ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرْءَانُ عَلَىٰ رَجُ<span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَرْيَتَيْنِ عَظ<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"أَهُمْ يَ<span class=\"tj tj-qlqalah\">قْ</span>سِمُونَ رَحْمَتَ رَبِّكَ‌ۚ نَحْنُ قَسَمْنَا بَيْنَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>َّعِيشَتَهُمْ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَيَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا‌ۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْ<span class=\"tj tj-ikhafa\">ضٍ د</span>َرَجَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_wo_ghunnah\">تٍ ل</span>ِّيَتَّخِذَ بَعْضُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َعْ<span class=\"tj tj-ikhafa\">ضًا س</span>ُخْرِي<span class=\"tj tj-idgham_ghunnah\">ًّا‌ۗ و</span>َرَحْمَتُ رَبِّكَ خَيْ<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>ِّ<span class=\"tj tj-ghunnah\">مّ</span>َا يَ<span class=\"tj tj-qlqalah\">جْ</span>مَع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"وَلَوْل<span class=\"tj tj-madda_obligatory\">َآ</span> أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َكُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َاسُ أُ<span class=\"tj tj-ghunnah\">مّ</span>َ<span class=\"tj tj-idgham_ghunnah\">ةً و</span><span class=\"tj tj-madda_normal\">َٰ</span>حِدَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>َّجَعَلْنَا لِم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َكْفُرُ بِ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ لِبُيُوتِهِمْ سُقُ<span class=\"tj tj-idgham_ghunnah\">فًا م</span>ِّ<span class=\"tj tj-ikhafa\">ن ف</span>ِضَّ<span class=\"tj tj-idgham_ghunnah\">ةٍ و</span>َمَعَارِجَ عَلَيْهَا يَظْهَر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"وَلِبُيُوتِهِمْ أَ<span class=\"tj tj-qlqalah\">بْ</span>و<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">بًا و</span>َسُرُرًا عَلَيْهَا يَتَّكِــٔ<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"وَزُخْرُ<span class=\"tj tj-idgham_ghunnah\">فًا‌ۚ و</span>َإِ<span class=\"tj tj-ikhafa\">ن ك</span>ُلُّ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ لَ<span class=\"tj tj-ghunnah\">مّ</span>َا مَتَ<span class=\"tj tj-madda_normal\">ـٰ</span>عُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَيَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا‌ۚ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَخِرَةُ عِ<span class=\"tj tj-ikhafa\">ند</span>َ رَبِّكَ لِلْمُتَّق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َعْشُ عَ<span class=\"tj tj-ikhafa\">ن ذ</span>ِكْرِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ نُقَيِّضْ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> شَيْطَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">نًا ف</span>َهُوَ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> قَر<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ لَيَصُدُّونَهُمْ عَنِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّبِيلِ وَيَحْسَبُونَ أَ<span class=\"tj tj-ghunnah\">نّ</span>َه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّهْتَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٧</span>"},{"id":38,"tajweed":"حَتَّ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَنَا قَالَ يَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَشْرِقَيْنِ فَبِئْسَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَر<span class=\"tj tj-madda_permissible\">ِي</span>نُ <span class=\"tj tj-end\" hidden>٣٨</span>"},{"id":39,"tajweed":"وَل<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َ<span class=\"tj tj-ikhafa\">نف</span>َعَكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْيَوْمَ إِ<span class=\"tj tj-idgham_mutajanisayn\">ذ</span> ظَّلَمْتُمْ أَ<span class=\"tj tj-ghunnah\">نّ</span>َكُمْ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابِ مُشْتَرِك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٩</span>"},{"id":40,"tajweed":"أَفَأَ<span class=\"tj tj-ikhafa\">نت</span>َ تُسْمِعُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صُّ<span class=\"tj tj-ghunnah\">مّ</span>َ أَوْ تَهْدِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْعُمْىَ وَمَ<span class=\"tj tj-ikhafa\">ن ك</span>َانَ فِى ضَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"فَإِ<span class=\"tj tj-ghunnah\">مّ</span>َا نَذْهَبَ<span class=\"tj tj-ghunnah\">نّ</span>َ بِكَ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َا مِنْه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّ<span class=\"tj tj-ikhafa\">نت</span>َقِم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"أَوْ نُرِيَ<span class=\"tj tj-ghunnah\">نّ</span>َكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى وَعَ<span class=\"tj tj-qlqalah\">دْ</span>نَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َا عَلَيْه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ُّ<span class=\"tj tj-qlqalah\">قْ</span>تَدِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَمْسِكْ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذ<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُوحِىَ إِلَيْكَ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ عَلَىٰ صِر<span class=\"tj tj-madda_normal\">َٰ</span><span class=\"tj tj-idgham_ghunnah\">طٍ م</span>ُّسْتَق<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> لَذِكْ<span class=\"tj tj-idgham_wo_ghunnah\">رٌ ل</span>َّكَ وَلِقَوْمِكَ‌ۖ وَسَوْفَ تُسْــَٔل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"وَسْــَٔلْ مَنْ أَرْسَلْنَا مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِكَ م<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>ُّسُلِن<span class=\"tj tj-madda_obligatory\">َآ</span> أَجَعَلْنَا مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ ءَالِهَ<span class=\"tj tj-idgham_ghunnah\">ةً ي</span>ُعْبَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَرْسَلْنَا مُوسَىٰ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَىٰ فِرْعَوْنَ وَمَلَإِ<span class=\"tj tj-silent\">يْ</span>ه<span class=\"tj tj-madda_normal\">ِۦ</span> فَقَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى رَسُولُ رَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"فَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِن<span class=\"tj tj-madda_obligatory\">َآ</span> إِذَا ه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْهَا يَضْحَك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"وَمَا نُرِيه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ِّنْ ءَايَةٍ إِلَّا هِىَ أَكْبَرُ مِنْ أُخْتِهَا‌ۖ وَأَخَذْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>ه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابِ لَعَلَّهُمْ يَرْجِع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> يَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>أَيُّهَ <span class=\"tj 