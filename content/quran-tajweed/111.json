{"id":111,"verses":[{"id":1,"tajweed":"تَبَّتْ يَد<span class=\"tj tj-madda_obligatory\">َآ</span> أَبِى لَهَ<span class=\"tj tj-idgham_ghunnah\">بٍ و</span>َتَ<span>ب</span>َّ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"م<span class=\"tj tj-madda_obligatory\">َآ</span> أَغْنَىٰ عَنْهُ مَالُهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَمَا كَسَ<span>ب</span>َ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"سَيَصْلَىٰ نَا<span class=\"tj tj-ikhafa\">رًا ذ</span>َاتَ لَهَ<span>ب</span>ٍ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>مْرَأَتُهُ<span class=\"tj tj-madda_normal\">ۥ</span> حَ<span class=\"tj tj-ghunnah\">مّ</span>َالَةَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَطَ<span>ب</span>ِ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"فِى جِيدِهَا حَ<span>بْ</span><span class=\"tj tj-idgham_ghunnah\">لٌ م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّسَ<span>د</span>ِۭ <span class=\"tj tj-end\" hidden>٥</span>"}],"source":"quran.com-uthmani-tajweed","version":1}