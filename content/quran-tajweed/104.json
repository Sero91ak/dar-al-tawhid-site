{"id":104,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"وَيْ<span class=\"tj tj-idgham_wo_ghunnah\">لٌ ل</span>ِّكُلِّ هُمَزَ<span class=\"tj tj-idgham_wo_ghunnah\">ةٍ ل</span>ُّمَزَةٍ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"ٱلَّذِى جَمَعَ مَال<span class=\"tj tj-idgham_ghunnah\">اً و</span>َعَدَّدَهُۥ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"يَحْسَبُ أَ<span class=\"tj tj-ghunnah\">نّ</span>َ مَالَهُ<span class=\"tj tj-madda_obligatory\">ۥٓ</span> أَخْلَدَهُۥ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"كَلَّا‌ۖ لَيُ<span class=\"tj tj-iqlab\">نۢب</span>َذَ<span class=\"tj tj-ghunnah\">نّ</span>َ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْحُطَمَةِ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"وَم<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-qlqalah\">دْ</span>رَ<span class=\"tj tj-madda_normal\">ىٰ</span>كَ مَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْحُطَمَةُ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"نَارُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُوقَدَةُ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"ٱلَّتِى تَطَّلِعُ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَفْــِٔدَةِ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َهَا عَلَيْه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ُّؤْصَدَةٌ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"فِى عَمَ<span class=\"tj tj-idgham_ghunnah\">دٍ م</span>ُّمَدَّدَةِۭ <span class=\"tj tj-end\" hidden>٩</span>"}]}