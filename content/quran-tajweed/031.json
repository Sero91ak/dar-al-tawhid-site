{"id":31,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"ا<span class=\"tj tj-madda_necessary\">لٓ</span><span class=\"tj tj-madda_necessary\">مٓ</span> <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"تِلْكَ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَك<span class=\"tj tj-madda_permissible\">ِي</span>مِ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"هُ<span class=\"tj tj-idgham_ghunnah\">دًى و</span>َرَحْمَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>ِّلْمُحْسِن<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"ٱلَّذِينَ يُقِيمُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّلَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةَ وَيُؤْتُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>زَّكَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةَ وَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَخِرَةِ هُمْ يُوقِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ عَلَىٰ هُ<span class=\"tj tj-idgham_ghunnah\">دًى م</span>ّ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّبِّهِمْ‌ۖ وَأُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُفْلِح<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"وَمِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</spa