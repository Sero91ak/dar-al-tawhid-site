ass=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَرَسُولَهُ<span class=\"tj tj-madda_normal\">ۥ</span> كُبِتُو<span class=\"tj tj-silent\">اْ</span> كَمَا كُبِتَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِهِمْ‌ۚ وَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَ<span class=\"tj tj-ikhafa\">نز</span>َلْن<span class=\"tj tj-madda_obligatory\">َآ</span> ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-iqlab\">تِۭ ب</span>َيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٍ‌ۚ و</span>َلِلْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِرِينَ عَذَا<span class=\"tj tj-idgham_ghunnah\">بٌ م</span>ُّه<span class=\"tj tj-madda_permissible\">ِي</span>نٌ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"يَوْمَ يَ<span class=\"tj tj-qlqalah\">بْ</span>عَثُهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ جَمِي<span class=\"tj tj-ikhafa\">عًا ف</span>َيُنَبِّئُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِمَا عَمِل<span class=\"tj tj-madda_obligatory\">ُوٓ<span class=\"tj tj-silent\">اْ</span>‌ۚ</span> أَحْصَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ وَنَسُوهُ‌ۚ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ عَلَىٰ كُلِّ ش<span class=\"tj tj-ikhafa\">َىْءٍ ش</span>َه<span class=\"tj tj-madda_permissible\">ِي</span><span class=\"tj tj-qlqalah\">د</span>ٌ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"أَلَمْ تَرَ أَ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ يَعْلَمُ مَا فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَمَا فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ‌ۖ مَا يَكُونُ م<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّ<span class=\"tj tj-qlqalah\">جْ</span>وَىٰ ثَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>ثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-qlqalah\">دْ</span>نَىٰ مِ<span class=\"tj tj-ikhafa\">ن ذ</span><span class=\"tj tj-madda_normal\">َٰ</span>لِكَ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُو<span class=\"tj tj-silent\">اْ‌ۖ</span> ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يُنَبِّئُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِمَا عَمِلُو<span class=\"tj tj-silent\">اْ</span> يَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ بِكُلِّ شَىْءٍ عَل<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"أَلَمْ تَرَ إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ نُهُو<span class=\"tj tj-silent\">اْ</span> عَنِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-qlqalah\">جْ</span>وَىٰ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ يَعُودُونَ لِمَا نُهُو<span class=\"tj tj-silent\">اْ</span> عَنْهُ وَيَتَنَ<span class=\"tj tj-madda_normal\">ـٰ</span>جَوْنَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْإِثْمِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْعُ<span class=\"tj tj-qlqalah\">دْ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>نِ وَمَعْصِيَتِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّسُولِ وَإِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ وَيَقُولُونَ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَ<span class=\"tj tj-ikhafa\">نف</span>ُسِهِمْ لَوْلَا يُعَذِّبُنَا <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ بِمَا نَقُولُ‌ۚ حَسْ