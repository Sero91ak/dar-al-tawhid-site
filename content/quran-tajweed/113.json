{"id":113,"verses":[{"id":1,"tajweed":"قُلْ أَعُوذُ بِرَبِّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَلَ<span>ق</span>ِ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"مِ<span class=\"tj tj-ikhafa\">ن ش</span>َرِّ مَا خَلَ<span>ق</span>َ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَمِ<span class=\"tj tj-ikhafa\">ن ش</span>َرِّ غَاسِقٍ إِذَا وَقَ<span>ب</span>َ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَمِ<span class=\"tj tj-ikhafa\">ن ش</span>َرِّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َفَّ<span class=\"tj tj-madda_normal\">ـٰ</span>ثَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْعُقَ<span>د</span>ِ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"وَمِ<span class=\"tj tj-ikhafa\">ن ش</span>َرِّ حَاسِدٍ إِذَا حَسَ<span>د</span>َ <span class=\"tj tj-end\" hidden>٥</span>"}],"source":"quran.com-uthmani-tajweed","version":1}