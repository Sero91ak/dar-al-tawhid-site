=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>هْتَدَوْ<span class=\"tj tj-silent\">اْ</span> زَادَهُمْ هُ<span class=\"tj tj-idgham_ghunnah\">دًى و</span>َءَاتَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ تَ<span class=\"tj tj-qlqalah\">قْ</span>وَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُمْ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"فَهَلْ يَ<span class=\"tj tj-ikhafa\">نظ</span>ُرُونَ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةَ أَ<span class=\"tj tj-ikhafa\">ن ت</span>َأْتِيَه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>َغْتَ<span class=\"tj tj-ikhafa\">ةً‌ۖ ف</span>َقَ<span class=\"tj tj-qlqalah\">دْ</span> ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ أَشْرَاطُهَا‌ۚ فَأَ<span class=\"tj tj-ghunnah\">نّ</span>َىٰ لَهُمْ إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَتْهُمْ ذِكْرَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُمْ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>عْلَمْ أَ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> ل<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هَ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَغْفِرْ لِذَ<span class=\"tj tj-iqlab\">نۢب</span>ِكَ وَلِلْمُؤْمِنِينَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمُؤْمِنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ‌ۗ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَ<span class=\"tj tj-madda_normal\">ىٰ</span>كُمْ <span class=\"tj tj-end\" hidden>١٩</span>"},{"id":20,"tajweed":"وَيَقُولُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> لَوْلَا نُزِّلَتْ سُورَ<span class=\"tj tj-ikhafa\">ةٌ‌ۖ ف</span>َإِذ<span class=\"tj tj-madda_obligatory\">َآ</span> أُ<span class=\"tj tj-ikhafa\"