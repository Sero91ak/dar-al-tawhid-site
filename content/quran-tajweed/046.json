dda_normal\">ـٰ</span>نًا‌ۖ حَمَلَتْهُ أُ<span class=\"tj tj-ghunnah\">مّ</span>ُهُ<span class=\"tj tj-madda_normal\">ۥ</span> كُرْ<span class=\"tj tj-idgham_ghunnah\">هًا و</span>َوَضَعَتْهُ كُرْ<span class=\"tj tj-idgham_ghunnah\">هًا‌ۖ و</span>َحَمْلُهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَفِصَ<span class=\"tj tj-madda_normal\">ـٰ</span>لُهُ<span class=\"tj tj-madda_normal\">ۥ</span> ثَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>ثُونَ شَهْرًا‌ۚ حَتَّ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِذَا بَلَغَ أَشُدَّهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَبَلَغَ أَرْبَعِينَ سَنَ<span class=\"tj tj-ikhafa\">ةً ق</span>َالَ رَبِّ أَوْزِعْن<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَنْ أَشْكُرَ نِعْمَتَكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّت<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَنْعَمْتَ عَلَىَّ وَعَلَىٰ و<span class=\"tj tj-madda_normal\">َٰ</span>لِدَىَّ وَأَنْ أَعْمَلَ صَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِ<span class=\"tj tj-ikhafa\">حًا ت</span>َرْضَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ وَأَصْلِحْ لِى فِى ذُرِّيَّت<span class=\"tj tj-madda_obligatory\">ِىٓ‌ۖ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>ِى تُ<span class=\"tj tj-qlqalah\">بْ</span>تُ إِلَيْكَ وَإِ<span class=\"tj tj-ghunnah\">نّ</span>ِى مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُسْلِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٥</span>"},{"id":16,"tajweed":"أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُو<span class=\"tj tj-silent\">اْ</span> وَنَتَجَاوَزُ عَ<span class=\"tj tj-ikhafa\">ن س</span>َيِّـَٔـاتِهِمْ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَصْحَ<span class=\"tj tj-madda_normal\">ـٰ</span>بِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-ghunnah\">نّ</span>َةِ‌ۖ وَعْدَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صِّ<span class=\"tj tj-qlqalah\">دْ</span>قِ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى كَانُو<span class=\"tj tj-silent\">اْ</span> يُوعَد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٦</span>"},{"id":17,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى قَالَ لِو<span class=\"tj tj-madda_normal\">َٰ</span>لِدَيْهِ أُ<span class=\"tj tj-idgham_wo_ghunnah\">فٍّ ل</span>َّكُم<span class=\"tj tj-madda_obligatory\">َآ</span> أَتَعِدَانِن<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَنْ أُخْرَجَ وَقَ<span class=\"tj tj-qlqalah\">دْ</span> خَلَتِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرُونُ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِى وَهُمَا يَسْتَغِيثَانِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ وَيْلَكَ ءَامِنْ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ وَعْدَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ حَ<span class=\"tj tj-ikhafa\">قٌّ ف</span>َيَقُولُ مَا هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذ<span class=\"tj tj-madda_obligatory\">َآ</span> إِلّ<span class=\"tj tj-madda_obligatory\">َآ</span> أَسَ<span class=\"tj tj-madda_normal\">ـٰ</span>طِيرُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَوَّل<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٧</span>"},{"id":18,"tajweed":"أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ حَقَّ عَلَيْهِمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْلُ ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أُمَ<span class=\"tj tj-ikhafa\">مٍ ق</span>َ<span class=\"tj tj-qlqalah\">دْ</span> خَلَتْ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِ<span class=\"tj tj-ghunnah\">نّ</span>ِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>ِ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ كَانُو<span class=\"tj tj-silent\">اْ</span> خَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٨</span>"},{"id":19,"tajweed":"وَلِكُ<span class=\"tj tj-ikhafa\">لٍّ د</span>َرَجَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">تٌ م</span>ِّ<span class=\"tj tj-ghunnah\">مّ</span>َا عَمِلُو<span class=\"tj tj-silent\">اْ‌ۖ</span> وَلِيُوَفِّيَهُمْ أَعْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَهُمْ وَهُمْ لَا يُظْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١٩</span>"},{"id":20,"tajweed":"وَيَوْمَ يُعْرَضُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-silent\">اْ</span> عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َارِ أَذْهَ<span class=\"tj tj-qlqalah\">بْ</span>تُمْ طَيِّبَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِكُمْ فِى حَيَاتِكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دُّنْيَا وَ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَمْتَعْت<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِهَا فَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْيَوْمَ تُ<span class=\"tj tj-qlqalah\">جْ</span>زَوْنَ عَذَابَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْهُونِ بِمَا كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَسْتَكْبِرُونَ فِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ بِغَيْرِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَبِمَا كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَفْسُق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٠</span>"},{"id":21,"tajweed":"۞ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>ذْكُرْ أَخَا عَادٍ إِذْ أَ<span class=\"tj tj-ikhafa\">نذ</span>َرَ قَوْمَهُ<span class=\"tj tj-madda_normal\">ۥ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَحْقَافِ وَقَ<span class=\"tj tj-qlqalah\">دْ</span> خَلَتِ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>ُذُرُ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َيْنِ يَدَيْهِ وَمِنْ خَلْفِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> أَلَّا تَعْبُد<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ إِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظ<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٢١</span>"},{"id":22,"tajweed":"قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَجِئْتَنَا لِتَأْفِكَنَا عَنْ ءَالِهَتِنَا فَأْتِنَا بِمَا تَعِدُن<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ikhafa\">ن ك</span>ُ<span class=\"tj tj-ikhafa\">نت</span>َ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>دِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٢</span>"},{"id":23,"tajweed":"قَالَ إِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْعِلْمُ عِ<span class=\"tj tj-ikhafa\">ند</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَأُبَلِّغُك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-madda_obligatory\">َآ</span> أُرْسِلْتُ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَرَ<span class=\"tj tj-madda_normal\">ىٰ</span>كُمْ قَوْ<span class=\"tj tj-ikhafa\">مًا ت</span>َ<span class=\"tj tj-qlqalah\">جْ</span>هَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٣</span>"},{"id":24,"tajweed":"فَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا رَأَوْهُ عَارِ<span class=\"tj tj-idgham_ghunnah\">ضًا م</span>ُّسْتَ<span class=\"tj tj-qlqalah\">قْ</span>بِلَ أَوْدِيَتِهِمْ قَالُو<span class=\"tj tj-silent\">اْ</span> هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا عَارِ<span class=\"tj tj-idgham_ghunnah\">ضٌ م</span>ُّمْطِرُنَا‌ۚ بَلْ هُوَ مَا <span class=\"tj tj-ham_wasl\">ٱ</span>سْتَعْجَلْت<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۖ رِي<span class=\"tj tj-ikhafa\">حٌ ف</span>ِيهَا عَذَابٌ أَل<span class=\"tj tj-madda_permissible\">ِي</span>مٌ <span class=\"tj tj-end\" hidden>٢٤</span>"},{"id":25,"tajweed":"تُدَ<span class=\"tj tj-ghunnah\">مّ</span>ِرُ كُلَّ شَىْ<span class=\"tj tj-iqlab\">ءِۭ ب</span>ِأَمْرِ رَبِّهَا فَأَصْبَحُو<span class=\"tj tj-silent\">اْ</span> لَا يُرَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِلَّا مَسَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِنُهُمْ‌ۚ كَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ نَ<span class=\"tj tj-qlqalah\">جْ</span>زِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-qlqalah\">جْ</span>رِم<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٥</span>"},{"id":26,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> مَكَّ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ فِيم<span class=\"tj tj-madda_obligatory\">َآ</span> إ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّكَّ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>كُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْ<span class=\"tj tj-idgham_ghunnah\">عًا و</span>َأَ<span class=\"tj tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">رًا و</span>َأَفْــِٔدَ<span class=\"tj tj-ikhafa\">ةً ف</span>َم<span class=\"tj tj-madda_obligatory\">َآ</span> أَغْنَىٰ عَنْهُمْ سَمْعُهُمْ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَ<span class=\"tj tj-qlqalah\">بْ</span>صَ<span class=\"tj tj-madda_normal\">ـٰ</span>رُهُمْ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَفْــِٔدَتُه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ش</span>َىْءٍ إِذْ كَانُو<span class=\"tj tj-silent\">اْ</span> يَ<span class=\"tj tj-qlqalah\">جْ</span>حَدُونَ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَحَاقَ بِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>َّا كَانُو<span class=\"tj tj-silent\">اْ</span> بِه<span class=\"tj tj-madda_normal\">ِۦ</span> يَسْتَهْزِء<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٦</span>"},{"id":27,"tajweed":"وَلَقَ<span class=\"tj tj-qlqalah\">دْ</span> أَهْلَكْنَا مَا حَوْلَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرَىٰ وَصَرَّفْنَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَيَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ لَعَلَّهُمْ يَرْجِع<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٧</span>"},{"id":28,"tajweed":"فَلَوْلَا نَصَرَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ قُرْبَانًا ءَالِهَ<span class=\"tj tj-iqlab\">ةَۢ‌ۖ ب</span>َلْ ضَلُّو<span class=\"tj tj-silent\">اْ</span> عَنْهُمْ‌ۚ وَذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ إِفْكُهُمْ وَمَا كَانُو<span class=\"tj tj-silent\">اْ</span> يَفْتَر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢٨</span>"},{"id":29,"tajweed":"وَإِذْ صَرَفْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَيْكَ نَفَ<span class=\"tj tj-idgham_ghunnah\">رًا م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِ<span class=\"tj tj-ghunnah\">نّ</span>ِ يَسْتَمِعُونَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُرْءَانَ فَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا حَضَرُوهُ قَال<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ikhafa\">نص</span>ِتُو<span class=\"tj tj-silent\">اْ‌ۖ</span> فَلَ<span class=\"tj tj-ghunnah\">مّ</span>َا قُضِىَ وَلَّوْ<span class=\"tj tj-silent\">اْ</span> إِلَىٰ قَوْمِه<span class=\"tj tj-idgham_shafawi\">ِم م</span>ُّ<span class=\"tj tj-ikhafa\">نذ</span>ِر<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٢٩</span>"},{"id":30,"tajweed":"قَالُو<span class=\"tj tj-silent\">اْ</span> يَ<span class=\"tj tj-madda_normal\">ـٰ</span>قَوْمَن<span class=\"tj tj-madda_obligatory\">َآ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َا سَمِعْنَا كِتَ<span class=\"tj tj-madda_normal\">ـٰ</span>بًا أُ<span class=\"tj tj-ikhafa\">نز</span>ِلَ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِ مُوسَىٰ مُصَدِّ<span class=\"tj tj-idgham_wo_ghunnah\">قًا ل</span>ِّمَا بَيْنَ يَدَيْهِ يَهْد<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ وَإِلَىٰ طَرِي<span class=\"tj tj-idgham_ghunnah\">قٍ م</span>ُّسْتَق<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٣٠</span>"},{"id":31,"tajweed":"يَ<span class=\"tj tj-madda_normal\">ـٰ</span>قَوْمَن<span class=\"tj tj-madda_obligatory\">َآ</span> أَجِيبُو<span class=\"tj tj-silent\">اْ</span> دَاعِىَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ وَءَامِنُو<span class=\"tj tj-silent\">اْ</span> بِه<span class=\"tj tj-madda_normal\">ِۦ</span> يَغْفِرْ لَك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ذ</span>ُنُوبِكُمْ وَيُجِرْك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّنْ عَذَابٍ أَل<span class=\"tj tj-madda_permissible\">ِي</span>مٍ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"وَم<span class=\"tj tj-idgham_wo_ghunnah\">َن ل</span>َّا يُجِ<span class=\"tj tj-qlqalah\">بْ</span> دَاعِىَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ فَلَيْسَ بِمُعْجِ<span class=\"tj tj-ikhafa\">زٍ ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَلَيْسَ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> أَوْلِي<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ‌ۚ أُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ فِى ضَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">لٍ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"أَوَلَمْ يَرَوْ<span class=\"tj tj-silent\">اْ</span> أَ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى خَلَقَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ وَلَمْ يَعْىَ بِخَلْقِهِ<span class=\"tj tj-ghunnah\">نّ</span>َ بِقَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِرٍ عَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُحْــِۧىَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَوْتَىٰ‌ۚ بَلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> عَلَىٰ كُلِّ ش<span class=\"tj tj-ikhafa\">َىْءٍ ق</span>َد<span class=\"tj tj-madda_permissible\">ِي</span>رٌ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"وَيَوْمَ يُعْرَضُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-silent\">اْ</span> عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َارِ أَلَيْسَ هَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذَا بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْحَقِّ‌ۖ قَالُو<span class=\"tj tj-silent\">اْ</span> بَلَىٰ وَرَبِّنَا‌ۚ قَالَ فَذُوقُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابَ بِمَا كُ<span class=\"tj tj-ikhafa\">نت</span>ُمْ تَكْفُر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْبِرْ كَمَا صَبَرَ أُ<span class=\"tj tj-silent\">وْ</span>لُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَزْمِ مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رُّسُلِ وَلَا تَسْتَعْجِل لَّهُمْ‌ۚ كَأَ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ يَوْمَ يَرَوْنَ مَا يُوعَدُونَ لَمْ يَلْبَث<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> إِلَّا سَاعَ<span class=\"tj tj-idgham_ghunnah\">ةً م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن ن</span>َّهَا<span class=\"tj tj-iqlab\">رِۭ‌ۚ ب</span>َلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">غٌ‌ۚ ف</span>َهَلْ يُهْلَكُ إِلَّا <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"}]}