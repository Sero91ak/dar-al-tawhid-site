{"id":63,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُنَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِقُونَ قَالُو<span class=\"tj tj-silent\">اْ</span> نَشْهَدُ إِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ لَرَسُولُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۗ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَعْلَمُ إِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ لَرَسُولُهُ<span class=\"tj tj-madda_normal\">ۥ</span> وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ يَشْهَدُ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُنَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِقِينَ لَكَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذِب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"ٱتَّخَذ<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَيْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَهُمْ جُ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-ikhafa\">ةً ف</span>َصَدُّو<span class=\"tj tj-silent\">اْ</span> عَ<span class=\"tj tj-ikhafa\">ن س</span>َبِيلِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ س<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ مَا كَانُو<span class=\"tj tj-silent\">اْ</span> يَعْمَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ بِأَ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ كَفَرُو<span class=\"tj tj-silent\">اْ</span> فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَه<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَ<span class=\"tj tj-qlqalah\">جْ</span>سَامُهُمْ‌ۖ وَإ<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َقُولُو<span class=\"tj tj-silent\">اْ</span> تَسْمَعْ لِقَوْلِهِمْ‌ۖ كَأَ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ خُشُ<span class=\"tj tj-idgham_ghunnah\">بٌ م</span>ُّسَ<span class=\"tj tj-ghunnah\">نّ</span>َدَ<span class=\"tj tj-idgham_ghunnah\">ةٌ‌ۖ ي</span>َحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ‌ۚ هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَدُوُّ فَ<span class=\"tj tj-ham_wasl\">ٱ</span>حْذَرْهُمْ‌ۚ قَ<span class=\"tj tj-madda_normal\">ـٰ</span>تَلَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ‌ۖ أَ<span class=\"tj tj-ghunnah\">نّ</span>َىٰ يُؤْفَك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْ<span class=\"tj tj-silent\">اْ</span> يَسْتَغْفِرْ لَكُمْ رَسُولُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ لَوَّوْ<span class=\"tj tj-silent\">اْ</span> رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ُّسْتَكْبِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"سَو<span class=\"tj tj-madda_obligatory\">َا</span>ٓءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ ل<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َغْفِرَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ لَهُمْ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهَ لَا يَهْدِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْقَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ يَقُولُونَ لَا تُ<span class=\"tj tj-ikhafa\">نف</span>ِقُو<span class=\"tj tj-silent\">اْ</span> عَلَىٰ مَنْ عِ<span class=\"tj tj-ikhafa\">ند</span>َ رَسُولِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ حَتَّىٰ يَ<span class=\"tj tj-ikhafa\">نف</span>َضُّو<span class=\"tj tj-silent\">اْ‌ۗ</span> وَلِلَّهِ خَز<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِنُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُنَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِقِينَ لَا يَفْقَه<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"يَقُولُونَ لَئ<span class=\"tj tj-idgham_wo_ghunnah\">ِن ر</span>َّجَعْن<span class=\"tj tj-madda_obligatory\">َآ</span> إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَدِينَةِ لَيُخْرِجَ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَعَزُّ مِنْهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَذَلَّ‌ۚ وَلِلَّهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعِزَّةُ وَلِرَسُولِه<span class=\"tj tj-madda_normal\">ِۦ</span> وَلِلْمُؤْمِنِينَ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُنَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِقِينَ لَا يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"يَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>أَيُّهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> لَا تُلْهِكُمْ أَمْو<span class=\"tj tj-madda_normal\">َٰ</span>لُكُمْ وَل<span class=\"tj tj-madda_obligatory\">َآ</span> أَوْلَ<span class=\"tj tj-madda_normal\">ـٰ</span>دُكُمْ عَ<span class=\"tj tj-ikhafa\">ن ذ</span>ِكْرِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۚ وَم<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َفْعَلْ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ فَأُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْخَ<span class=\"tj tj-madda_normal\">ـٰ</span>سِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"وَأَ<span class=\"tj tj-ikhafa\">نف</span>ِقُو<span class=\"tj tj-silent\">اْ</span> م<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّا رَزَ<span class=\"tj tj-qlqalah\">قْ</span>نَ<span class=\"tj tj-madda_normal\">ـٰ</span>ك<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َأْتِىَ أَحَدَكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَوْتُ فَيَقُولَ رَبِّ لَوْل<span class=\"tj tj-madda_obligatory\">َآ</span> أَخَّرْتَن<span class=\"tj tj-madda_obligatory\">ِىٓ</span> إِلَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> أَجَ<span class=\"tj tj-ikhafa\">لٍ ق</span>َرِي<span class=\"tj tj-ikhafa\">بٍ ف</span>َأَصَّدَّقَ وَأَك<span class=\"tj tj-idgham_ghunnah\">ُن م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِح<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"وَل<span class=\"tj tj-idgham_ghunnah\">َن ي</span>ُؤَخِّرَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ نَفْسًا إِذَا ج<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ أَجَلُهَا‌ۚ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ خَبِي<span class=\"tj tj-iqlab\">رُۢ ب</span>ِمَا تَعْمَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>١١</span>"}]}