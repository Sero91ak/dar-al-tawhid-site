{"id":70,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"سَأَلَ س<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِ<span class=\"tj tj-iqlab\">لُۢ ب</span>ِعَذَا<span class=\"tj tj-idgham_ghunnah\">بٍ و</span>َاقِعٍ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"لِّلْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِرِينَ لَيْسَ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> دَافِعٌ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"مِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ ذِى <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَعَارِ<span class=\"tj tj-qlqalah\">ج</span>ِ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"تَعْرُجُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَلَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَةُ وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رُّوحُ إِلَيْهِ فِى يَوْ<span class=\"tj tj-ikhafa\">مٍ ك</span>َانَ مِ<span class=\"tj tj-qlqalah\">قْ</span>دَارُهُ<span class=\"tj tj-madda_normal\">ۥ</span> خَمْسِينَ أَلْفَ سَنَةٍ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"فَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْبِرْ صَ<span class=\"tj tj-qlqalah\">بْ</span><span class=\"tj tj-ikhafa\">رًا ج</span>َمِيلاً <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ يَرَوْنَهُ<span class=\"tj tj-madda_normal\">ۥ</span> بَعِيدًا <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"وَنَرَ<span class=\"tj tj-madda_normal\">ىٰ</span>هُ قَرِيبًا <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"يَوْمَ تَكُونُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ كَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْمُهْلِ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"وَتَكُونُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِبَا