{"id":53,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-qlqalah\">جْ</span>مِ إِذَا هَوَىٰ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَمَا يَ<span class=\"tj tj-ikhafa\">نط</span>ِقُ عَنِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْهَوَىٰٓ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"إِنْ هُوَ إِلَّا وَحْ<span class=\"tj tj-idgham_ghunnah\">ىٌ ي</span>ُوحَىٰ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"عَلَّمَهُ<span class=\"tj tj-madda_normal\">ۥ</span> شَدِيدُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُوَىٰ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"ذُو مِرَّ<span class=\"tj tj-ikhafa\">ةٍ ف</span>َ<span class=\"tj tj-ham_wasl\">ٱ</span>سْتَوَىٰ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"وَهُوَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأُفُقِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَعْلَىٰ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ دَنَا فَتَدَلَّىٰ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَ<span class=\"tj tj-qlqalah\">دْ</span>نَىٰ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":10,"tajweed":"فَأَوْحَ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِلَىٰ عَ<span class=\"tj tj-qlqalah\">بْ</span>دِه<span class=\"tj tj-madda_normal\">ِۦ</span> م<span class=\"tj tj-madda_obligatory\">َآ</span> أَوْحَىٰ <span class=\"tj tj-end\" hidden>١٠</span>"},{"id":11,"tajweed":"مَا كَذَبَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفُؤَادُ مَا رَأَىٰٓ <span class=\"tj tj-end\" hidden>١١</span>"},{"id":12,"tajweed":"أَفَتُمَ<span class=\"tj tj-madda_normal\">ـٰ</span