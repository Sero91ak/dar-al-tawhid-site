ٱ</span>لْمُتَرَبِّص<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣١</span>"},{"id":32,"tajweed":"أَمْ تَأْمُرُهُمْ أَحْلَ<span class=\"tj tj-madda_normal\">ـٰ</span>مُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِهَ<span class=\"tj tj-madda_normal\">ـٰ</span>ذ<span class=\"tj tj-madda_obligatory\">َآ‌ۚ</span> أَمْ هُمْ قَوْ<span class=\"tj tj-ikhafa\">مٌ ط</span>َاغ<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٢</span>"},{"id":33,"tajweed":"أَمْ يَقُولُونَ تَقَوَّلَهُ<span class=\"tj tj-madda_normal\">ۥ</span>‌ۚ بَل لَّا يُؤْمِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٣</span>"},{"id":34,"tajweed":"فَلْيَأْتُو<span class=\"tj tj-silent\">اْ</span> بِحَدِي<span class=\"tj tj-idgham_ghunnah\">ثٍ م</span>ِّثْلِه<span class=\"tj tj-madda_obligatory\">ِۦٓ</span> إِ<span class=\"tj tj-ikhafa\">ن ك</span>َانُو<span class=\"tj tj-silent\">اْ</span> صَ<span class=\"tj tj-madda_normal\">ـٰ</span>دِق<span class=\"tj tj-madda_permissible\">ِي</span>نَ <span class=\"tj tj-end\" hidden>٣٤</span>"},{"id":35,"tajweed":"أَمْ خُلِقُو<span class=\"tj tj-silent\">اْ</span> مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْخَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٥</span>"},{"id":36,"tajweed":"أَمْ خَلَقُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضَ‌ۚ بَل لَّا يُوقِن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٦</span>"},{"id":37,"tajweed":"أَمْ عِ<span class=\"tj tj-ikhafa\">ند</span>َهُمْ خَز<span class=\"tj tj-madda_obligatory\">َا</span>ٓئِنُ رَبِّكَ أَمْ هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُصَۣيْطِر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٧</span>"},{"id":38,"tajweed":"أَمْ لَهُمْ سُلَّ<span class=\"tj tj-idgham_ghunnah\">مٌ ي</span>َسْتَمِعُونَ فِيهِ‌ۖ فَلْيَأْتِ مُسْتَمِعُه<span class=\"tj tj-ikhafa_shafawi\">ُم ب</span>ِسُلْطَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">نٍ م</span>ُّب<span class=\"tj tj-madda_permissible\">ِي</span>نٍ <span class=\"tj tj-end\" hidden>٣٨</span>"},{"id":39,"tajweed":"أَمْ لَهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَنَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ وَلَكُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْبَن<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٣٩</span>"},{"id":40,"tajweed":"أَمْ تَسْــَٔلُهُمْ أَ<span class=\"tj tj-qlqalah\">جْ</span><span class=\"tj tj-ikhafa\">رًا ف</span>َه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ّ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>َّغْرَ<span class=\"tj tj-idgham_ghunnah\">مٍ م</span>ُّثْقَل<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٠</span>"},{"id":41,"tajweed":"أَمْ عِ<span class=\"tj tj-ikhafa\">ند</span>َهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَيْبُ فَهُمْ يَكْتُب<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤١</span>"},{"id":42,"tajweed":"أَمْ يُرِيدُونَ كَيْ<span class=\"tj tj-ikhafa\">دًا‌ۖ ف</span>َ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-silent\">اْ</span> هُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمَكِيد<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٢</span>"},{"id":43,"tajweed":"أَمْ لَهُمْ إِلَ<span class=\"tj tj-madda_normal\">ـٰ</span>هٌ غَيْرُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ‌ۚ سُ<span class=\"tj tj-qlqalah\">بْ</span>حَ<span class=\"tj tj-madda_normal\">ـٰ</span>نَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ عَ<span class=\"tj tj-ghunnah\">مّ</span>َا يُشْرِك<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٣</span>"},{"id":44,"tajweed":"وَإ<span class=\"tj tj-idgham_ghunnah\">ِن ي</span>َرَوْ<span class=\"tj tj-silent\">اْ</span> كِسْ<span class=\"tj tj-idgham_ghunnah\">فًا م</span>ِّنَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءِ سَاقِ<span class=\"tj tj-idgham_ghunnah\">طًا ي</span>َقُولُو<span class=\"tj tj-silent\">اْ</span> سَحَا<span class=\"tj tj-idgham_ghunnah\">بٌ م</span>َّرْك<span class=\"tj tj-madda_permissible\">ُو</span>مٌ <span class=\"tj tj-end\" hidden>٤٤</span>"},{"id":45,"tajweed":"فَذَرْهُمْ حَتَّىٰ يُلَ<span class=\"tj tj-madda_normal\">ـٰ</span>قُو<span class=\"tj tj-silent\">اْ</span> يَوْمَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى فِيهِ يُصْعَق<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٥</span>"},{"id":46,"tajweed":"يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـ<span class=\"tj tj-idgham_ghunnah\">ـًٔا و</span>َلَا هُمْ يُ<span class=\"tj tj-ikhafa\">نص</span>َر<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٦</span>"},{"id":47,"tajweed":"وَإِ<span class=\"tj tj-ghunnah\">نّ</span>َ لِلَّذِينَ ظَلَمُو<span class=\"tj tj-silent\">اْ</span> عَذَا<span class=\"tj tj-ikhafa\">بًا د</span>ُونَ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ وَلَ<span class=\"tj tj-madda_normal\">ـٰ</span>كِ<span class=\"tj tj-ghunnah\">نّ</span>َ أَكْثَرَهُمْ لَا يَعْلَم<span class=\"tj tj-madda_permissible\">ُو</span>نَ <span class=\"tj tj-end\" hidden>٤٧</span>"},{"id":48,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْبِرْ لِحُكْمِ رَبِّكَ فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َكَ بِأَعْيُنِنَا‌ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَق<span class=\"tj tj-madda_permissible\">ُو</span>مُ <span class=\"tj tj-end\" hidden>٤٨</span>"},{"id":49,"tajweed":"وَمِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّيْلِ فَسَبِّحْهُ وَإِ<span class=\"tj tj-qlqalah\">دْ</span>بَ<span class=\"tj tj-madda_normal\">ـٰ</span>رَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span><span class=\"tj tj-ghunnah\">نّ</span>ُج<span class=\"tj tj-madda_permissible\">ُو</span>مِ <span class=\"tj tj-end\" hidden>٤٩</span>"}]}