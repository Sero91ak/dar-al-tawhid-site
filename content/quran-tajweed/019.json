pan class=\"tj tj-idgham_ghunnah\">حٍ و</span>َمِ<span class=\"tj tj-ikhafa\">ن ذ</span>ُرِّيَّةِ إِ<span class=\"tj tj-qlqalah\">بْ</span>ر<span class=\"tj tj-madda_normal\">َٰ</span>هِيمَ وَإِسْر<span class=\"tj tj-madda_obligatory\">َٰ</span>ٓءِيلَ وَمِ<span class=\"tj tj-ghunnah\">مّ</span>َنْ هَدَيْنَا وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-qlqalah\">جْ</span>تَبَيْن<span class=\"tj tj-madda_obligatory\">َآ‌ۚ</span> إِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ خَرُّو<span class=\"tj tj-silent\">اْ</span> سُجَّ<span class=\"tj tj-idgham_ghunnah\">دًا و</span>َبُكِيًّا ۩ <span class=\"tj tj-end\" hidden>٥٨</span>"},{"id":59,"tajweed":"۞ فَخَلَفَ م<span class=\"tj tj-iqlab\">ِنۢ ب</span>َعْدِهِمْ خَلْفٌ أَضَاعُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّلَ<span class=\"tj tj-silent\">و</span><span class=\"tj tj-madda_normal\">ٰ</span>ةَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّبَعُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّهَو<span class=\"tj tj-madda_normal\">َٰ</span>تِ‌ۖ فَسَوْفَ يَلْقَوْنَ غَيًّا <span class=\"tj tj-end\" hidden>٥٩</span>"},{"id":60,"tajweed":"إِلَّا مَ<span class=\"tj tj-ikhafa\">ن ت</span>َابَ وَءَامَنَ وَعَمِلَ صَ<span class=\"tj tj-madda_normal\">ـٰ</span>لِ<span class=\"tj tj-ikhafa\">حًا ف</span>َأُ<span class=\"tj tj-silent\">وْ</span>لَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>ئِكَ يَ<span class=\"tj tj-qlqalah\">دْ</span>خُلُونَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-ghunnah\">نّ</span>َةَ وَلَا يُظْلَمُونَ شَيْــًٔا <span class=\"tj tj-end\" hidden>٦٠</span>"},{"id":61,"tajweed":"جَ<span class=\"tj tj-ghunnah\">نّ</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ عَ<span class=\"tj tj-qlqalah\">دْ</span>نٍ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّتِى وَعَدَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ عِبَادَهُ<span class=\"tj tj-madda_normal\">ۥ</span> بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لْغَيْبِ‌ۚ إِ<span class=\"tj tj-ghunnah\">نّ</span>َهُ<span class=\"tj tj-madda_normal\">ۥ</span> كَانَ وَعْدُهُ<span class=\"tj tj-madda_normal\">ۥ</span> مَأْتِيًّا <span class=\"tj tj-end\" hidden>٦١</span>"},{"id":62,"tajweed":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا إِلَّا سَلَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">مًا‌ۖ و</span>َلَهُمْ رِزْقُهُمْ فِيهَا بُكْرَ<span class=\"tj tj-idgham_ghunnah\">ةً و</span>َعَشِيًّا <span class=\"tj tj-end\" hidden>٦٢</span>"},{"id":63,"tajweed":"تِلْكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجَ<span class=\"tj tj-ghunnah\">نّ</span>َةُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّتِى نُورِثُ مِنْ عِبَادِنَا مَ<span class=\"tj tj-ikhafa\">ن ك</span>َانَ تَقِيًّا <span class=\"tj tj-end\" hidden>٦٣</span>"},{"id":64,"tajweed":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ‌ۖ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذ<span class=\"tj tj-madda_normal\">َٰ</span>لِكَ‌ۚ وَمَا كَانَ رَبُّكَ نَسِيًّا <span class=\"tj tj-end\" hidden>٦٤</span>"},{"id":65,"tajweed":"رَّبُّ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ وَمَا بَيْنَهُمَا فَ<span class=\"tj tj-ham_wasl\">ٱ</span>عْبُ<span class=\"tj tj-qlqalah\">دْ</span>هُ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>صْطَبِرْ لِعِبَ<span class=\"tj tj-madda_normal\">ـٰ</span>دَتِه<span class=\"tj tj-madda_normal\">ِۦ</span>‌ۚ هَلْ تَعْلَمُ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> سَمِيًّا <span class=\"tj tj-end\" hidden>٦٥</span>"},{"id":66,"tajweed":"وَيَقُولُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ أَءِذَا مَا مِتُّ لَسَوْفَ أُخْرَجُ حَيًّا <span class=\"tj tj-end\" hidden>٦٦</span>"},{"id":67,"tajweed":"أَوَلَا يَذْكُرُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ أَ<span class=\"tj tj-ghunnah\">نّ</span>َا خَلَ<span class=\"tj tj-qlqalah\">قْ</span>نَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ مِ<span class=\"tj tj-ikhafa\">ن ق</span>َ<span class=\"tj tj-qlqalah\">بْ</span>لُ وَلَمْ يَكُ شَيْــًٔا <span class=\"tj tj-end\" hidden>٦٧</span>"},{"id":68,"tajweed":"فَوَرَبِّكَ لَنَحْشُرَ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ وَ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّيَ<span class=\"tj tj-madda_normal\">ـٰ</span>طِينَ ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ لَنُحْضِرَ<span class=\"tj tj-ghunnah\">نّ</span>َهُمْ حَوْلَ جَهَ<span class=\"tj tj-ghunnah\">نّ</span>َمَ جِثِيًّا <span class=\"tj tj-end\" hidden>٦٨</span>"},{"id":69,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ لَنَ<span class=\"tj tj-ikhafa\">نز</span>ِعَ<span class=\"tj tj-ghunnah\">نّ</span>َ مِ<span class=\"tj tj-ikhafa\">ن ك</span>ُلِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ عِتِيًّا <span class=\"tj tj-end\" hidden>٦٩</span>"},{"id":70,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ لَنَحْنُ أَعْلَمُ بِ<span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ هُمْ أَوْلَىٰ بِهَا صِلِيًّا <span class=\"tj tj-end\" hidden>٧٠</span>"},{"id":71,"tajweed":"وَإ<span class=\"tj tj-idgham_ghunnah\">ِن م</span>ِّ<span class=\"tj tj-ikhafa\">نك</span>ُمْ إِلَّا وَارِدُهَا‌ۚ كَانَ عَلَىٰ رَبِّكَ حَتْ<span class=\"tj tj-idgham_ghunnah\">مًا م</span>َّ<span class=\"tj tj-qlqalah\">قْ</span>ضِيًّا <span class=\"tj tj-end\" hidden>٧١</span>"},{"id":72,"tajweed":"ثُ<span class=\"tj tj-ghunnah\">مّ</span>َ نُنَجِّى <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّقَو<span class=\"tj tj-silent\">اْ</span> وَّنَذَرُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ظَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِمِينَ فِيهَا جِثِيًّا <span class=\"tj tj-end\" hidden>٧٢</span>"},{"id":73,"tajweed":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُنَا بَيِّنَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-ikhafa\">تٍ ق</span>َالَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-silent\">اْ</span> لِلَّذِينَ ءَامَن<span class=\"tj tj-madda_obligatory\">ُوٓ</span><span class=\"tj tj-silent\">اْ</span> أَىُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْفَرِيقَيْنِ خَيْ<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>َّقَا<span class=\"tj tj-idgham_ghunnah\">مًا و</span>َأَحْسَنُ نَدِيًّا <span class=\"tj tj-end\" hidden>٧٣</span>"},{"id":74,"tajweed":"وَكَمْ أَهْلَكْنَا قَ<span class=\"tj tj-qlqalah\">بْ</span>لَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َرْنٍ هُمْ أَحْسَنُ أَثَ<span class=\"tj tj-madda_normal\">ـٰ</span><span class=\"tj tj-idgham_ghunnah\">ثًا و</span>َرِءْيًا <span class=\"tj tj-end\" hidden>٧٤</span>"},{"id":75,"tajweed":"قُلْ مَ<span class=\"tj tj-ikhafa\">ن ك</span>َانَ فِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>ضَّلَ<span class=\"tj tj-madda_normal\">ـٰ</span>لَةِ فَلْيَمْدُ<span class=\"tj tj-qlqalah\">دْ</span> لَهُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ مَدًّا‌ۚ حَتَّ<span class=\"tj tj-madda_obligatory\">ىٰٓ</span> إِذَا رَأَوْ<span class=\"tj tj-silent\">اْ</span> مَا يُوعَدُونَ إِ<span class=\"tj tj-ghunnah\">مّ</span>َا <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابَ وَإِ<span class=\"tj tj-ghunnah\">مّ</span>َا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّاعَةَ فَسَيَعْلَمُونَ مَنْ هُوَ شَ<span class=\"tj tj-idgham_ghunnah\">رٌّ م</span>َّكَا<span class=\"tj tj-idgham_ghunnah\">نًا و</span>َأَضْعَفُ جُ<span class=\"tj tj-ikhafa\">ند</span>ًا <span class=\"tj tj-end\" hidden>٧٥</span>"},{"id":76,"tajweed":"وَيَزِيدُ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ <span class=\"tj tj-ham_wasl\">ٱ</span>هْتَدَوْ<span class=\"tj tj-silent\">اْ</span> هُ<span class=\"tj tj-idgham_ghunnah\">دًى‌ۗ و</span>َ<span class=\"tj tj-ham_wasl\">ٱ</span>لْبَ<span class=\"tj tj-madda_normal\">ـٰ</span>قِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِحَ<span class=\"tj tj-madda_normal\">ـٰ</span>تُ خَيْرٌ عِ<span class=\"tj tj-ikhafa\">ند</span>َ رَبِّكَ ثَوَا<span class=\"tj tj-idgham_ghunnah\">بًا و</span>َخَيْ<span class=\"tj tj-idgham_ghunnah\">رٌ م</span>َّرَدًّا <span class=\"tj tj-end\" hidden>٧٦</span>"},{"id":77,"tajweed":"أَفَرَءَيْتَ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِى كَفَرَ بِـَٔـايَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِنَا وَقَالَ لَأُوتَيَ<span class=\"tj tj-ghunnah\">نّ</span>َ مَال<span class=\"tj tj-idgham_ghunnah\">اً و</span>َوَلَدًا <span class=\"tj tj-end\" hidden>٧٧</span>"},{"id":78,"tajweed":"أَطَّلَعَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْغَيْبَ أَمِ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَ عِ<span class=\"tj tj-ikhafa\">ند</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ عَهْدًا <span class=\"tj tj-end\" hidden>٧٨</span>"},{"id":79,"tajweed":"كَلَّا‌ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُ<span class=\"tj tj-madda_normal\">ۥ</span> مِنَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْعَذَابِ مَدًّا <span class=\"tj tj-end\" hidden>٧٩</span>"},{"id":80,"tajweed":"وَنَرِثُهُ<span class=\"tj tj-madda_normal\">ۥ</span> مَا يَقُولُ وَيَأْتِينَا فَرْدًا <span class=\"tj tj-end\" hidden>٨٠</span>"},{"id":81,"tajweed":"وَ<span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذُو<span class=\"tj tj-silent\">اْ</span> مِ<span class=\"tj tj-ikhafa\">ن د</span>ُونِ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهِ ءَالِهَ<span class=\"tj tj-idgham_wo_ghunnah\">ةً ل</span>ِّيَكُونُو<span class=\"tj tj-silent\">اْ</span> لَهُمْ عِزًّا <span class=\"tj tj-end\" hidden>٨١</span>"},{"id":82,"tajweed":"كَلَّا‌ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا <span class=\"tj tj-end\" hidden>٨٢</span>"},{"id":83,"tajweed":"أَلَمْ تَرَ أَ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أَرْسَلْنَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّيَ<span class=\"tj tj-madda_normal\">ـٰ</span>طِينَ عَلَى <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَ<span class=\"tj tj-madda_normal\">ـٰ</span>فِرِينَ تَؤُزُّهُمْ أَزًّا <span class=\"tj tj-end\" hidden>٨٣</span>"},{"id":84,"tajweed":"فَلَا تَعْجَلْ عَلَيْهِمْ‌ۖ إِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا نَعُدُّ لَهُمْ عَدًّا <span class=\"tj tj-end\" hidden>٨٤</span>"},{"id":85,"tajweed":"يَوْمَ نَحْشُرُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُتَّقِينَ إِلَى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ وَفْدًا <span class=\"tj tj-end\" hidden>٨٥</span>"},{"id":86,"tajweed":"وَنَسُوقُ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُ<span class=\"tj tj-qlqalah\">جْ</span>رِمِينَ إِلَىٰ جَهَ<span class=\"tj tj-ghunnah\">نّ</span>َمَ وِرْدًا <span class=\"tj tj-end\" hidden>٨٦</span>"},{"id":87,"tajweed":"لَّا يَمْلِكُونَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>شَّفَ<span class=\"tj tj-madda_normal\">ـٰ</span>عَةَ إِلَّا مَنِ <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَ عِ<span class=\"tj tj-ikhafa\">ند</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ عَهْدًا <span class=\"tj tj-end\" hidden>٨٧</span>"},{"id":88,"tajweed":"وَقَالُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span>تَّخَذَ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ وَلَدًا <span class=\"tj tj-end\" hidden>٨٨</span>"},{"id":89,"tajweed":"لَّقَ<span class=\"tj tj-qlqalah\">دْ</span> جِئْتُمْ شَيْــًٔا إِدًّا <span class=\"tj tj-end\" hidden>٨٩</span>"},{"id":90,"tajweed":"تَكَادُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تُ يَتَفَطَّرْنَ مِنْهُ وَتَ<span class=\"tj tj-ikhafa\">نش</span>َقُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضُ وَتَخِرُّ <span class=\"tj tj-ham_wasl\">ٱ</span>لْجِبَالُ هَدًّا <span class=\"tj tj-end\" hidden>٩٠</span>"},{"id":91,"tajweed":"أَ<span class=\"tj tj-ikhafa\">ن د</span>َعَوْ<span class=\"tj tj-silent\">اْ</span> لِلرَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ وَلَدًا <span class=\"tj tj-end\" hidden>٩١</span>"},{"id":92,"tajweed":"وَمَا يَ<span class=\"tj tj-iqlab\">نۢب</span>َغِى لِلرَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ أ<span class=\"tj tj-idgham_ghunnah\">َن ي</span>َتَّخِذَ وَلَدًا <span class=\"tj tj-end\" hidden>٩٢</span>"},{"id":93,"tajweed":"إِ<span class=\"tj tj-ikhafa\">ن ك</span>ُلُّ مَ<span class=\"tj tj-ikhafa\">ن ف</span>ِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّمَ<span class=\"tj tj-madda_normal\">ـٰ</span>و<span class=\"tj tj-madda_normal\">َٰ</span>تِ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>لْأَرْضِ إِلّ<span class=\"tj tj-madda_obligatory\">َآ</span> ءَاتِى <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نِ عَ<span class=\"tj tj-qlqalah\">بْ</span>دًا <span class=\"tj tj-end\" hidden>٩٣</span>"},{"id":94,"tajweed":"لَّقَ<span class=\"tj tj-qlqalah\">دْ</span> أَحْصَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُمْ وَعَدَّهُمْ عَدًّا <span class=\"tj tj-end\" hidden>٩٤</span>"},{"id":95,"tajweed":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْقِيَ<span class=\"tj tj-madda_normal\">ـٰ</span>مَةِ فَرْدًا <span class=\"tj tj-end\" hidden>٩٥</span>"},{"id":96,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ <span class=\"tj tj-ham_wasl\">ٱ</span>لَّذِينَ ءَامَنُو<span class=\"tj tj-silent\">اْ</span> وَعَمِلُو<span class=\"tj tj-silent\">اْ</span> <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّ<span class=\"tj tj-madda_normal\">ـٰ</span>لِحَ<span class=\"tj tj-madda_normal\">ـٰ</span>تِ سَيَ<span class=\"tj tj-qlqalah\">جْ</span>عَلُ لَهُمُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>رَّحْمَ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ وُدًّا <span class=\"tj tj-end\" hidden>٩٦</span>"},{"id":97,"tajweed":"فَإِ<span class=\"tj tj-ghunnah\">نّ</span>َمَا يَسَّرْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>هُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ <span class=\"tj tj-ham_wasl\">ٱ</span>لْمُتَّقِينَ وَتُ<span class=\"tj tj-ikhafa\">نذ</span>ِرَ بِه<span class=\"tj tj-madda_normal\">ِۦ</span> قَوْ<span class=\"tj tj-idgham_wo_ghunnah\">مًا ل</span>ُّدًّا <span class=\"tj tj-end\" hidden>٩٧</span>"},{"id":98,"tajweed":"وَكَمْ أَهْلَكْنَا قَ<span class=\"tj tj-qlqalah\">بْ</span>لَه<span class=\"tj tj-idgham_shafawi\">ُم م</span>ِّ<span class=\"tj tj-ikhafa\">ن ق</span>َرْنٍ هَلْ تُحِسُّ مِنْه<