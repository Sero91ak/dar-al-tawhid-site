{"id":82,"source":"api.quran.com/v4/quran/verses/uthmani_tajweed","updated":"2026-08-23","verses":[{"id":1,"tajweed":"إِذَا <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>سَّم<span class=\"tj tj-madda_obligatory\">َا</span>ٓءُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نف</span>َطَرَتْ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"وَإِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَوَاكِبُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-ikhafa\">نت</span>َثَرَتْ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"وَإِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْبِحَارُ فُجِّرَتْ <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَإِذَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْقُبُورُ بُعْثِرَتْ <span class=\"tj tj-end\" hidden>٤</span>"},{"id":5,"tajweed":"عَلِمَتْ نَفْ<span class=\"tj tj-idgham_ghunnah\">سٌ م</span>َّا قَدَّمَتْ وَأَخَّرَتْ <span class=\"tj tj-end\" hidden>٥</span>"},{"id":6,"tajweed":"يَ<span class=\"tj tj-madda_obligatory\">ـٰٓ</span>أَيُّهَا <span class=\"tj tj-ham_wasl\">ٱ</span>لْإِ<span class=\"tj tj-ikhafa\">نس</span>َ<span class=\"tj tj-madda_normal\">ـٰ</span>نُ مَا غَرَّكَ بِرَبِّكَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَر<span class=\"tj tj-madda_permissible\">ِي</span>مِ <span class=\"tj tj-end\" hidden>٦</span>"},{"id":7,"tajweed":"ٱلَّذِى خَلَقَكَ فَسَوَّ<span class=\"tj tj-madda_normal\">ىٰ</span>كَ فَعَدَلَكَ <span class=\"tj tj-end\" hidden>٧</span>"},{"id":8,"tajweed":"ف<span class=\"tj tj-madda_obligatory\">ِىٓ</span> أَىِّ صُورَ<span class=\"tj tj-idgham_ghunnah\">ةٍ م</span>َّا ش<span class=\"tj tj-madda_obligatory\">َا</span>ٓءَ رَكَّبَكَ <span class=\"tj tj-end\" hidden>٨</span>"},{"id":9,"tajweed":"كَلَّا بَلْ تُكَذِّبُونَ بِ<span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>دّ<span class=\"tj tj-madda_permissible\">ِي</span>نِ <span class=\"tj tj-end\" hidden>٩</span>"},{"id":