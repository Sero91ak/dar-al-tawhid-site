{"id":108,"verses":[{"id":1,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span><span class=\"tj tj-madda_obligatory\">َآ</span> أَعْطَيْنَ<span class=\"tj tj-madda_normal\">ـٰ</span>كَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْكَوْثَرَ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"فَصَلِّ لِرَبِّكَ وَ<span class=\"tj tj-ham_wasl\">ٱ</span>نْحَرْ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"إِ<span class=\"tj tj-ghunnah\">نّ</span>َ شَانِئَكَ هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>لْأَ<span>بْ</span>تَرُ <span class=\"tj tj-end\" hidden>٣</span>"}],"source":"quran.com-uthmani-tajweed","version":1}