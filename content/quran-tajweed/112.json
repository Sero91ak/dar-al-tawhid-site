{"id":112,"verses":[{"id":1,"tajweed":"قُلْ هُوَ <span class=\"tj tj-ham_wasl\">ٱ</span>للَّهُ أَحَ<span>د</span>ٌ <span class=\"tj tj-end\" hidden>١</span>"},{"id":2,"tajweed":"ٱللَّهُ <span class=\"tj tj-ham_wasl\">ٱ</span><span class=\"tj tj-laam_shamsiyah\">ل</span>صَّمَ<span>د</span>ُ <span class=\"tj tj-end\" hidden>٢</span>"},{"id":3,"tajweed":"لَمْ يَلِ<span>دْ</span> وَلَمْ يُولَ<span>دْ</span> <span class=\"tj tj-end\" hidden>٣</span>"},{"id":4,"tajweed":"وَلَمْ يَك<span class=\"tj tj-idgham_wo_ghunnah\">ُن ل</span>َّهُ<span class=\"tj tj-madda_normal\">ۥ</span> كُفُوًا أَحَ<span>د</span>ُۢ <span class=\"tj tj-end\" hidden>٤</span>"}],"source":"quran.com-uthmani-tajweed","version":1}