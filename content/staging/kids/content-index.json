    {
      "id": "story-ibrahim-und-isma-il-bauen-am-haus-mukd4cqo",
      "revision": 2,
      "kind": "story",
      "appTarget": "kids",
      "status": "draft",
      "title": "Ibrāhīm und Ismāʿīl bauen am Haus",
      "subtitle": "",
      "summary": "",
      "category": "Qurʾān · geprüft",
      "topic": "Kaabah",
      "prophetId": "ibrahim",
      "tags": [
        "legacy-kids",
        "legacy-id:auth-ibrahim-kabah"
      ],
      "ageMin": 4,
      "ageMax": 10,
      "modes": {
        "read": true,
        "listen": true
      },
      "text": "Der Qurʾān berichtet von Ibrāhīm und Ismāʿīl. Gemeinsam erhöhten sie die Grundlagen des Hauses. Während dieser Arbeit baten sie Allah, ihre Tat anzunehmen. Sie baten Ihn auch darum, sie Ihm ergeben zu machen und aus ihren Nachkommen eine Gemeinschaft entstehen zu lassen, die Ihm ergeben ist. Diese Begebenheit erinnert uns daran: Eine gute Tat tun wir für Allah, und wir bitten Ihn darum, sie anzunehmen.",
      "sourceRefs": [
        "Qurʾān 2:125–129"
      ],
      "claimIds": [
        "ibrahim-kabah",
        "ibrahim-ismail-quran"
      ],
      "verification": "studio-review",
      "cover": {
        "url": "",
        "key": "",
        "mime": "",
        "sha256": "",
        "bytes": 0,
        "source": "studio",
        "type": "cover"
      },
      "audio": {
        "url": "",
        "key": "",
        "mime": "",
        "sha256": "",
        "bytes": 0,
        "source": "studio",
        "type": "audio",
        "durationSec": 0,
        "codec": ""
      },
      "question": {
        "4–5": {
          "question": "Wen baten Ibrāhīm und Ismāʿīl, ihre Tat anzunehmen?",
          "answers": [
            {
              "label": "Allah",
              "correct": true
            },
            {
              "label": "Die Menschen",
              "correct": false
            }
          ],
          "success": "Richtig. Sie baten Allah.",
          "retry": "Hör noch einmal gut zu."
        },
        "6–8": {
          "question": "Was taten Ibrāhīm und Ismāʿīl gemeinsam?",
          "answers": [
            {
              "label": "Sie erhöhten die Grundlagen des Hauses",
              "correct": true
            },
            {
              "label": "Sie bauten ein Schiff",
              "correct": false
            }
          ],
          "success": "Richtig. Sie erhöhten die Grundlagen des Hauses.",
          "retry": "Denk an die Arbeit am Haus."
        },
        "9–10": {
          "question": "Was lehrt uns ihre Bitte während der guten Tat?",
          "answers": [
            {
              "label": "Allah um Annahme der Tat zu bitten",
              "correct": true
            },
            {
              "label": "Lob von Menschen zu suchen",
              "correct": false
            },
            {
              "label": "Eine gute Tat geheim zu halten ist verboten",
              "correct": false
            }
          ],
          "success": "Richtig. Gute Taten tun wir für Allah und bitten Ihn um Annahme.",
          "retry": "Denk an ihre Bitte während des Bauens."
        }
      },
