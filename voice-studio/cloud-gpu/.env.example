# Public TLS hostname that resolves to the GPU server.
DAR_VOICE_DOMAIN=voice-gpu.example.com

# Optional ACME contact used by Caddy.
ACME_EMAIL=admin@example.com

# Must be identical to Cloudflare secret DAR_VOICE_GPU_TOKEN.
# Use a long random value. Never commit the real token.
DAR_VOICE_PAIR_TOKEN=replace-with-long-random-token

# Persistent private Voice state on the GPU server.
DAR_VOICE_DATA_DIR=/var/lib/dar-voice
DAR_VOICE_MODEL_CACHE_DIR=/var/cache/dar-voice-hf

# 1 = Modell direkt nach Containerstart laden und Referenz vorbereiten.
DAR_VOICE_AUTOWARM=1
DAR_VOICE_DEVICE=cuda
