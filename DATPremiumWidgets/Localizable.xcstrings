    "Fajr bis Isha als Liste — mittel, groß, iPad und Sperrbildschirm-Leiste." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "قائمة من الفجر إلى العشاء — متوسطة وكبيرة وللآيباد وشريط شاشة القفل."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fadžr do jacije kao lista — srednji, veliki, iPad i traka na zaključanom ekranu."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "فەجر تا عیشا وەک لیست — مامناوەند، گەورە، ئایپاد و شریتی شاشەی قفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fajr to Isha as a list — medium, large, iPad and Lock Screen strip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fajr a Isha en lista — mediano, grande, iPad y barra de la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De Fajr à Isha sous forme de liste — moyenne, grande, iPad et barre de l’écran verrouillé."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fajr heta Isha wekî lîste — navîn, mezin, iPad û rêza ekranê ya kilîtkirî."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fecirden yatsıya kadar liste — orta, büyük, iPad ve kilit ekranı çubuğu."
          }
        }
      }
    },
