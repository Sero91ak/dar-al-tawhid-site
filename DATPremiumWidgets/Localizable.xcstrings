    "Richtung nach Mekka vom letzten Standort. Live-Kompass nur in der App, ohne Dauermessung." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الاتجاه إلى مكة من آخر موقع. البوصلة المباشرة داخل التطبيق فقط، دون قياس مستمر."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Smjer prema Meki s posljednje lokacije. Kompas uživo samo u aplikaciji, bez stalnog mjerenja."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ئاڕاستە بۆ مەککە لە دوایین شوێن. کۆمپاکتی زیندوو تەنها لە ئەپەکەیە، بەبێ پێوانەکردنی بەردەوام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Direction to Mecca from the last location. Live compass only in the app, without continuous tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dirección a La Meca desde la última ubicación. Brújula en vivo solo en la app, sin medición continua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Direction vers La Mecque depuis le dernier emplacement. Boussole en direct uniquement dans l’app, sans mesure continue."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aliyê Mekkeyê ji cihê dawî. Kompasa zindî tenê di sepanê de ye, bê pîvandina domdar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Son konumdan Mekke yönü. Canlı pusula yalnızca uygulamada, sürekli ölçüm yapılmaz."
          }
        }
      }
    },
