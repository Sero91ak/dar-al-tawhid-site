    "Alle fünf Gebetszeiten auf einen Blick" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "أوقات الصلوات الخمس بنظرة واحدة"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Svih pet namaza na jednom mjestu"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هەموو پێنج نوێژەکان بە یەک تێڕوانین"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "All five prayer times at a glance"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las cinco oraciones de un vistazo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les cinq prières en un coup d’œil"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Her pênc demên nimêjê bi yek nêrîn"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beş vakti tek bakışta görün"
          }
        }
      }
    },
    "Alle Gebetszeiten des Tages als Kacheln." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "جميع أوقات الصلاة اليومية كبطاقات."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sva dnevna vremena namaza kao kartice."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "هەموو کاتەکانی نوێژی ڕۆژ بە شێوەی کارت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "All prayer times of the day as cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todas las horas de oración del día en tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tous les horaires de prière du jour sous forme de cartes."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hemû demên nimêjê yên rojê wekî kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Günün tüm namaz vakitleri kartlar halinde."
          }
        }
      }
    },
